# Env / secrets
.env
.env*
!.env.example

# Android signing material and builds. This repo is the web version and has no
# business carrying either — but it is a deploy root, so a stray keystore here
# would become a public URL, not just a bad commit.
*.jks
*.keystore
keystore.properties
*.apk
Backup/

# Node
node_modules/

# Python
venv/
__pycache__/
*.pyc

# Build cache — large local-only files generated by 01_build_pairs.py
# These are never committed; regenerated automatically on next run.
data/cache/

# Vercel
.vercel/

# Netlify
.netlify/

# OS
.DS_Store

# Office lock files, written next to a workbook while it is open in Excel
~$*

# Editor / agent local settings
.claude/

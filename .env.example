# ── Required on Vercel ────────────────────────────────────────────────────────

# HuggingFace Inference API (a read token is sufficient)
# Used by: api/search.js (embeddings + reranking via BAAI/bge-reranker-v2-m3)
HF_TOKEN=hf_your_token_here

# Groq Cloud API key
# Used by: api/expand.js (query expansion) and api/synthesize.js (verse grouping)
GROQ_API_KEY=gsk_your_groq_key_here

# ── Not required for basic search ─────────────────────────────────────────────
# The following are optional / legacy and can be left unset:
#
#   Qdrant — no longer used; replaced by bundled binary embeddings in data/embeddings/
#   Vercel KV — no longer used; translation cache is now in localStorage

 م","ك ش ف","س و ق","د ع و","إِلَىٰ","س ج د","ط و ع"],"tokens_ordered":["يوم","يكشف","ساق","ويدعون","السجود","فلا","يستطيعون"],"vec_preview":[0.005100000184029341,0.07490000128746033,-0.009399999864399433,0.010900000110268593,0.012199999764561653,-0.02889999933540821,0.03830000013113022,0.021299999207258224]},{"ayah_id":"68:43","surah":68,"ayah":43,"arabic":"خَاشِعَةً أَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۖ وَقَدْ كَانُوا يُدْعَوْنَ إِلَى السُّجُودِ وَهُمْ سَالِمُونَ","english":"Their eyes will be cast down (with terror and shame) and disgrace will be spreading over them, whereas they were called to prostrate themselves (in the world also) when they were healthy (but they, even then, refused to fall prostrate).","roots_ordered":["خ ش ع","ب ص ر","ر ه ق","ذ ل ل","ك و ن","د ع و","إِلَىٰ","س ج د","س ل م"],"tokens_ordered":["خاشعة","ابصارهم","ترهقهم","ذلة","وقد","كانوا","يدعون","السجود","وهم","سالمون"],"vec_preview":[0.01810000091791153,0.09969999641180038,-0.014700000174343586,0.012400000356137753,0.01720000058412552,0.006399999838322401,0.05900000035762787,-0.007199999876320362]},{"ayah_id":"68:44","surah":68,"ayah":44,"arabic":"فَذَرْنِي وَمَن يُكَذِّبُ بِهَـٰذَا الْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ","english":"So, (O Esteemed Beloved,) leave Me (to exact revenge) from the one who rejects this Revelation. Now We shall take them (towards disaster) so gradually that they will not perceive it.","roots_ordered":["و ذ ر","ك ذ ب","ح د ث","د ر ج","ح ي ث","ع ل م"],"tokens_ordered":["فذرني","ومن","يكذب","بهذا","الحديث","سنستدرجهم","حيث","يعلمون"],"vec_preview":[0.018799999728798866,0.06859999895095825,-0.011099999770522118,0.01730000041425228,0.011699999682605267,-0.03689999878406525,0.06419999897480011,0.009399999864399433]},{"ayah_id":"68:45","surah":68,"ayah":45,"arabic":"وَأُمْلِي لَهُمْ ۚ إِنَّ كَيْدِي مَتِينٌ","english":"And I am giving them respite. Surely, My strategy is unbeatable.","roots_ordered":["م ل و","ك ي د","م ت ن"],"tokens_ordered":["واملي","لهم","كيدي","متين"],"vec_preview":[-0.007600000128149986,0.05739999935030937,-0.010599999688565731,0.0008999999845400453,0.010599999688565731,0.0019000000320374966,-0.07429999858140945,-0.01640000008046627]},{"ayah_id":"68:46","surah":68,"ayah":46,"arabic":"أَمْ تَسْأَلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","english":"Do you ask them for any reward (for preaching the faith in Messengership) that they are weighed down with (the burden of) paying the recompense?","roots_ordered":["أَم","س ا ل","ا ج ر","غ ر م","ث ق ل"],"tokens_ordered":["ام","تسالهم","اجرا","فهم","مغرم","مثقلون"],"vec_preview":[-0.0013000000035390258,0.06809999793767929,-0.011099999770522118,0.02410000003874302,-0.024000000208616257,-0.006399999838322401,-0.00930000003427267,-0.002300000051036477]},{"ayah_id":"68:47","surah":68,"ayah":47,"arabic":"أَمْ عِندَهُمُ الْغَيْبُ فَهُمْ يَكْتُبُونَ","english":"Do they have the knowledge of the unseen that they write down (their judgments on the basis of that)?","roots_ordered":["أَم","ع ن د","غ ي ب","ك ت ب"],"tokens_ordered":["ام","عندهم","الغيب","فهم","يكتبون"],"vec_preview":[0.028999999165534973,0.07639999687671661,-0.01209999993443489,0.029500000178813934,-0.014600000344216824,0.029899999499320984,0.051500000059604645,0.0006000000284984708]},{"ayah_id":"68:48","surah":68,"ayah":48,"arabic":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ الْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ","english":"So be steadfast in waiting for the command of your Lord, and do not (take it to your heart) like (Yunus [Jonah], the Messenger with) fish episode, when he cried out (to Allah) in a state pent up with rage and grief (against his community).","roots_ordered":["ص ب ر","ح ك م","ر ب ب","ك و ن","ص ح ب","ح و ت","إِذ","ن د و","ك ظ م"],"tokens_ordered":["فاصبر","لحكم","ربك","ولا","تكن","كصاحب","الحوت","نادي","وهو","مكظوم"],"vec_preview":[-0.0017999999690800905,0.04899999871850014,-0.007199999876320362,0.004699999932199717,-0.01810000091791153,0.02280000038444996,0.03720000013709068,0.015799999237060547]},{"ayah_id":"68:49","surah":68,"ayah":49,"arabic":"لَّوْلَا أَن تَدَارَكَهُ نِعْمَةٌ مِّن رَّبِّهِ لَنُبِذَ بِالْعَرَاءِ وَهُوَ مَذْمُومٌ","english":"Had the mercy and blessing of his Lord not helped him, he would certainly have been thrown in the barren field, blamed. (But Allah saved him from that.)","roots_ordered":["د ر ك","ن ع م","ر ب ب","ن ب ذ","ع ر ي","ذ م م"],"tokens_ordered":["لولا","تداركه","نعمة","ربه","لنبذ","بالعراء","وهو","مذموم"],"vec_preview":[0.02800000086426735,0.1281999945640564,-0.01209999993443489,0.022700000554323196,0.007199999876320362,0.02319999970495701,0.01269999984651804,-0.017500000074505806]},{"ayah_id":"68:50","surah":68,"ayah":50,"arabic":"فَاجْتَبَاهُ رَبُّهُ فَجَعَلَهُ مِنَ الصَّالِحِينَ","english":"Then his Lord exalted him and (placed him) amongst the perfectly pious (blessing him with His exceptional nearness).","roots_ordered":["ج ب ي","ر ب ب","ج ع ل","ص ل ح"],"tokens_ordered":["فاجتباه","ربه","فجعله","الصالحين"],"vec_preview":[-0.002300000051036477,0.07440000027418137,-0.010099999606609344,0.007899999618530273,0.016100000590085983,-0.0024999999441206455,0.013899999670684338,0.0006000000284984708]},{"ayah_id":"68:51","surah":68,"ayah":51,"arabic":"وَإِن يَكَادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَيَقُولُونَ إِنَّهُ لَمَجْنُونٌ","english":"And indeed, when the disbelievers listen to the Qur’an, it seems as if they wish to damage you with their (jealously evil) looks and say: ‘He is insane.’","roots_ordered":["ك و د","ٱلَّذِى","ك ف ر","ز ل ق","ب ص ر","س م ع","ذ ك ر","ق و ل","ج ن ن"],"tokens_ordered":["وان","يكاد","الذين","كفروا","ليزلقونك","بابصارهم","سمعوا","الذكر","ويقولون","لمجنون"],"vec_preview":[0.014000000432133675,0.06289999932050705,-0.008999999612569809,0.01899999938905239,0.035999998450279236,-0.017500000074505806,0.07289999723434448,-0.017500000074505806]},{"ayah_id":"68:52","surah":68,"ayah":52,"arabic":"وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَالَمِ
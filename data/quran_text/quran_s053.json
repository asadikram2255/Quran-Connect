012199999764561653,-0.0017999999690800905,-0.00279999990016222,-0.00839999970048666,-0.004900000058114529]},{"ayah_id":"53:23","surah":53,"ayah":23,"arabic":"إِنْ هِيَ إِلَّا أَسْمَاءٌ سَمَّيْتُمُوهَا أَنتُمْ وَآبَاؤُكُم مَّا أَنزَلَ اللَّهُ بِهَا مِن سُلْطَانٍ ۚ إِن يَتَّبِعُونَ إِلَّا الظَّنَّ وَمَا تَهْوَى الْأَنفُسُ ۖ وَلَقَدْ جَاءَهُم مِّن رَّبِّهِمُ الْهُدَىٰ","english":"But (the truth is that) these (idols) are nothing but mere names which you and your fathers have given. Allah has not sent down any authority for them. They follow only whims and suspicions and the desires of their (ill-commanding) selves, whereas guidance has already come to them from their Lord.","roots_ordered":["ان","هي","اللا","سمو","انتم","ابو","ما","نزل","اله","ب","من","سلط","تبع","ظنن","هوي","نفس","قد","جيا","ربب","هدي"],"tokens_ordered":["اسماء","سميتموها","واباءكم","انزل","الله","بها","سلطان","يتبعون","الظن","وما","تهوي","الانفس","ولقد","جاءهم","ربهم","الهدي"],"vec_preview":[-0.0032999999821186066,0.06159999966621399,-0.011099999770522118,0.008299999870359898,0.028300000354647636,0.00860000029206276,0.03420000150799751,0.00279999990016222]},{"ayah_id":"53:24","surah":53,"ayah":24,"arabic":"أَمْ لِلْإِنسَانِ مَا تَمَنَّىٰ","english":"Is (all) that available for man what he longs for?","roots_ordered":["ام","انس","ما","مني"],"tokens_ordered":["ام","للانسان","تمني"],"vec_preview":[0.04390000179409981,0.05730000138282776,-0.008700000122189522,-0.022299999371170998,0.006800000090152025,0.009600000455975533,0.01810000091791153,-0.06549999862909317]},{"ayah_id":"53:25","surah":53,"ayah":25,"arabic":"فَلِلَّهِ الْآخِرَةُ وَالْأُولَىٰ","english":"So Allah alone is the Master of the Hereafter and the world.","roots_ordered":["اله","اخر","اول"],"tokens_ordered":["فلله","الاخرة","والاولي"],"vec_preview":[0.032600000500679016,0.07810000330209732,-0.010400000028312206,0.02199999988079071,0.013000000268220901,-0.012199999764561653,0.01810000091791153,-0.012299999594688416]},{"ayah_id":"53:26","surah":53,"ayah":26,"arabic":"۞ وَكَم مِّن مَّلَكٍ فِي السَّمَاوَاتِ لَا تُغْنِي شَفَاعَتُهُمْ شَيْئًا إِلَّا مِن بَعْدِ أَن يَأْذَنَ اللَّهُ لِمَن يَشَاءُ وَيَرْضَىٰ","english":"And how many angels there are in the heavens (whom the disbelievers and the idolaters worship and expect from them intercession but) whose intercession will be of no use at all, except after Allah (awards) permission for whom He wills and likes!","roots_ordered":["كم","من","ملك","في","سمو","لا","غني","شفع","شيا","اللا","بعد","ان","اذن","اله","رضو"],"tokens_ordered":["وكم","ملك","السماوات","تغني","شفاعتهم","شيءا","بعد","ياذن","الله","لمن","يشاء","ويرضي"],"vec_preview":[-0.00839999970048666,0.04179999977350235,-0.00989999994635582,0.013799999840557575,0.020800000056624413,0.013199999928474426,0.0026000000070780516,-0.0005000000237487257]},{"ayah_id":"53:27","surah":53,"ayah":27,"arabic":"إِنَّ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ لَيُسَمُّونَ الْمَلَائِكَةَ تَسْمِيَةَ الْأُنثَىٰ","english":"Surely, those who do not believe in the Hereafter give the angels female names.","roots_ordered":["انن","اللذ","لا","امن","اخر","سمو","ملك","انث"],"tokens_ordered":["الذين","يءمنون","بالاخرة","ليسمون","الملاءكة","تسمية","الانثي"],"vec_preview":[0.022299999371170998,0.023499999195337296,-0.013399999588727951,0.031599998474121094,0.04580000042915344,0.023499999195337296,0.043699998408555984,-0.03840000182390213]},{"ayah_id":"53:28","surah":53,"ayah":28,"arabic":"وَمَا لَهُم بِهِ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا الظَّنَّ ۖ وَإِنَّ الظَّنَّ لَا يُغْنِي مِنَ الْحَقِّ شَيْئًا","english":"And they know nothing about it. They follow only assumption, and surely assumption serves no purpose in comparison with certitude.","roots_ordered":["ما","ل","ب","من","علم","ان","تبع","اللا","ظنن","انن","لا","غني","حقق","شيا"],"tokens_ordered":["وما","لهم","به","علم","يتبعون","الظن","وان","يغني","الحق","شيءا"],"vec_preview":[-0.0026000000070780516,0.09049999713897705,-0.011300000362098217,0.036400001496076584,0.03440000116825104,-0.03830000013113022,-0.014399999752640724,-0.011099999770522118]},{"ayah_id":"53:29","surah":53,"ayah":29,"arabic":"فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا","english":"So divert your attention from him who turns away from Our remembrance and desires nothing but the life of this world.","roots_ordered":["عرض","عن","من","ولي","ذكر","لم","رود","اللا","حيي","دنو"],"tokens_ordered":["فاعرض","تولي","ذكرنا","ولم","يرد","الحياة","الدنيا"],"vec_preview":[0.012799999676644802,0.06780000030994415,-0.012500000186264515,0.013399999588727951,0.03310000151395798,-0.0013000000035390258,0.014499999582767487,-0.016200000420212746]},{"ayah_id":"53:30","surah":53,"ayah":30,"arabic":"ذَٰلِكَ مَبْلَغُهُم مِّنَ الْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِ وَهُوَ أَعْلَمُ بِمَنِ اهْتَدَىٰ","english":"That is but the limit of the working of their knowledge. Verily, your Lord fully knows him who has strayed from His path and (also) knows best him who has attained guidance.","roots_ordered":["ذلك","بلغ","من","علم","انن","ربب","هو","ضلل","عن","سبل","هدي"],"tokens_ordered":["مبلغهم","العلم","ربك","اعلم","بمن","ضل","سبيله","وهو","اهتدي"],"vec_preview":[0.03680000081658363,0.08799999952316284,-0.009800000116229057,0.04089999943971634,0.02070000022649765,-0.020600000396370888,0.0494999997317791,-0.013799999840557575]},{"ayah_id":"53:31","surah":53,"ayah":31,"arabic":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى","english":"And to Allah belongs whatever is in the heavens and whatever is in the earth so that He recompenses the acts of those who have committed vices and gives good reward to those who have performed virtues.","roots_ordered":["اله","ما","في","سمو","ارض","جزي","اللذ","سوا","بما","عمل","حسن"],"tokens_ordered":["ولله","السماوات","وما","الارض","ليجزي","الذين","اساءوا","بما","عملوا","ويجزي","احسنوا","بالحسني"],"vec_previe
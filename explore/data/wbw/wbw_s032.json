u"},{"ar":"نَفْسٌۭ","en":"a soul","ur":"کوئی نفس","tr":"nafsun"},{"ar":"مَّآ","en":"what","ur":"جو","tr":"mā"},{"ar":"أُخْفِىَ","en":"is hidden","ur":"چھپایا گیا","tr":"ukh'fiya"},{"ar":"لَهُم","en":"for them","ur":"ان کے لیے","tr":"lahum"},{"ar":"مِّن","en":"of","ur":"میں سے","tr":"min"},{"ar":"قُرَّةِ","en":"(the) comfort","ur":"ٹھنڈک","tr":"qurrati"},{"ar":"أَعْيُنٍۢ","en":"(for) the eyes","ur":"آنکھوں کی","tr":"aʿyunin"},{"ar":"جَزَآءًۢ","en":"(as) a reward","ur":"بدلہ ہے","tr":"jazāan"},{"ar":"بِمَا","en":"for what","ur":"بوجہ اس کے","tr":"bimā"},{"ar":"كَانُوا۟","en":"they used (to)","ur":"جو تھے وہ","tr":"kānū"},{"ar":"يَعْمَلُونَ","en":"do","ur":"عمل کرتے","tr":"yaʿmalūna"}],"32:18":[{"ar":"أَفَمَن","en":"Then is one who","ur":"کیا بھلا وہ جو","tr":"afaman"},{"ar":"كَانَ","en":"is","ur":"ہو","tr":"kāna"},{"ar":"مُؤْمِنًۭا","en":"a believer","ur":"مومن","tr":"mu'minan"},{"ar":"كَمَن","en":"like (him) who","ur":"مانند اس کے","tr":"kaman"},{"ar":"كَانَ","en":"is","ur":"ہوسکتا ہے","tr":"kāna"},{"ar":"فَاسِقًۭا ۚ","en":"defiantly disobedient","ur":"جو فاسق ہو","tr":"fāsiqan"},{"ar":"لَّا","en":"Not","ur":"نہیں","tr":"lā"},{"ar":"يَسْتَوُۥنَ","en":"they are equal","ur":"وہ برابر ہوسکتے","tr":"yastawūna"}],"32:19":[{"ar":"أَمَّا","en":"As for","ur":"رہے","tr":"ammā"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے عمل کیے","tr":"waʿamilū"},{"ar":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"نیک","tr":"l-ṣāliḥāti"},{"ar":"فَلَهُمْ","en":"then for them","ur":"تو ان کے لیے","tr":"falahum"},{"ar":"جَنَّـٰتُ","en":"(are) Gardens","ur":"باغات میں","tr":"jannātu"},{"ar":"ٱلْمَأْوَىٰ","en":"(of) Refuge","ur":"ٹھکانہ","tr":"l-mawā"},{"ar":"نُزُلًۢا","en":"(as) hospitality","ur":"مہمانی کے طور پر","tr":"nuzulan"},{"ar":"بِمَا","en":"for what","ur":"بوجہ اس کے","tr":"bimā"},{"ar":"كَانُوا۟","en":"they used (to)","ur":"جو تھے وہ","tr":
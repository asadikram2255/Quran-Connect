{"87:1":[{"ar":"سَبِّحِ","en":"Glorify","ur":"تسبیح کیجئے","tr":"sabbiḥi"},{"ar":"ٱسْمَ","en":"(the) name","ur":"نام کی","tr":"is'ma"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کے","tr":"rabbika"},{"ar":"ٱلْأَعْلَى","en":"the Most High","ur":"جو سب سے بلند ہے","tr":"l-aʿlā"}],"87:2":[{"ar":"ٱلَّذِى","en":"The One Who","ur":"وہ جس نے","tr":"alladhī"},{"ar":"خَلَقَ","en":"created","ur":"پیدا کیا","tr":"khalaqa"},{"ar":"فَسَوَّىٰ","en":"then proportioned","ur":"پھر درست بنایا","tr":"fasawwā"}],"87:3":[{"ar":"وَٱلَّذِى","en":"And the One Who","ur":"اور وہ ذات","tr":"wa-alladhī"},{"ar":"قَدَّرَ","en":"measured","ur":"جس نے انداز کیا/ تقدیر بنائی","tr":"qaddara"},{"ar":"فَهَدَىٰ","en":"then guided","ur":"پھر ہدایت بخشی","tr":"fahadā"}],"87:4":[{"ar":"وَٱلَّذِىٓ","en":"And the One Who","ur":"اور وہ ذات","tr":"wa-alladhī"},{"ar":"أَخْرَجَ","en":"brings forth","ur":"جس نے نکالا","tr":"akhraja"},{"ar":"ٱلْمَرْعَىٰ","en":"the pasture","ur":"چارہ","tr":"l-marʿā"}],"87:5":[{"ar":"فَجَعَلَهُۥ","en":"And then makes it","ur":"پھر بنادیا اس کو","tr":"fajaʿalahu"},{"ar":"غُثَآءً","en":"stubble","ur":"خشک گھاس/ کوڑا","tr":"ghuthāan"},{"ar":"أَحْوَىٰ","en":"dark","ur":"سیاہ کیا","tr":"aḥwā"}],"87:6":[{"ar":"سَنُقْرِئُكَ","en":"We will make you recite","ur":"عنقریب ہم پڑھوا دیں گے تجھ کو","tr":"sanuq'ri-uka"},{"ar":"فَلَا","en":"so not","ur":"تو نہ","tr":"falā"},{"ar":"تَنسَىٰٓ","en":"you will forget","ur":"تم بھولو گے","tr":"tansā"}],"87:7":[{"ar":"إِلَّا","en":"Except","ur":"مگر","tr":"illā"},{"ar":"مَا","en":"what","ur":"جو","tr":"mā"},{"ar":"شَآءَ","en":"wills","ur":"چاہا","tr":"shāa"},{"ar":"ٱللَّهُ ۚ","en":"Allah","ur":"اللہ نے","tr":"l-lahu"},{"ar":"إِنَّهُۥ","en":"Indeed, He","ur":"بیشک وہ","tr":"innahu"},{"ar":"يَعْلَمُ","en":"knows","ur":"وہ جانتا ہے","tr":"yaʿlamu"},{"ar":"ٱلْجَهْرَ","en":"the manifest","ur":"ظاہر کو","tr":"l-jahra"},{"ar":"وَمَا","en":"and what","ur":"اور جو","tr":"wamā"},{"ar":"يَخْفَىٰ","en":"is hidden","ur":"پوشیدہ ہے","tr":"yakhfā"}],"87:8":[{"ar":"وَنُيَسِّرُكَ","en":"And We will ease you","ur":"اور ہم آسان کر رہے ہیں تجھ کو/ تیرے لئے","tr":"wanuyassiruka"},{"ar":"لِلْيُسْرَىٰ","en":"to the ease","ur":"واسطے آسانی کے","tr":"lil'yus'rā"}],"87:9":[{"ar":"فَذَكِّرْ","en":"So remind","ur":"پس نصیحت کیجئے","tr":"fadhakkir"},{"ar":"إِن","en":"if","ur":"اگر","tr":"in"},{"ar":"نَّفَعَتِ","en":"benefits","ur":"فائدہ دے","tr":"nafaʿati"},{"ar":"ٱلذِّكْرَىٰ","en":"the reminder","ur":"نصیحت کرنا","tr":"l-dhik'rā"}],"87:10":[{"ar":"سَيَذَّكَّرُ","en":"He will pay heed","ur":"عنقریب نصیحت پکڑے گا","tr":"sayadhakkaru"},{"ar":"مَن","en":"(one) who","ur":"وہ جو","tr":"man"},{"ar":"يَخْشَىٰ","en":"fears (Allah)","ur":"ڈرتا ہوگا","tr":"yakhshā"}],"87:11":[{"ar":"وَيَتَجَنَّبُهَا","en":"And will avoid it","ur":"اور گریز کرے گا اس سے","tr":"wayatajannabuhā"},{"ar":"ٱلْأَشْقَى","en":"the wretched one","ur":"سب سے زیادہ بدبخت","tr":"l-ashqā"}],"87:12":[{"ar":"ٱلَّذِى","en":"The one who","ur":"وہ جو","tr":"alladhī"},{"ar":"يَصْلَى","en":"will burn","ur":"داخل ہوگا","tr":"yaṣlā"},{"ar":"ٱلنَّارَ","en":"(in) the Fire","ur":"آگ میں","tr":"l-nāra"},{"ar":"ٱلْكُبْرَىٰ","en":"[the] great","ur":"بڑی","tr":"l-kub'rā"}],"87:13":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"لَا","en":"not","ur":"نہ","tr":"lā"},{"ar":"يَمُوتُ","en":"he will die","ur":"وہ مرے گا","tr":"yamūtu"},{"ar":"فِيهَا","en":"therein","ur":"اس میں","tr":"fīhā"},{"ar":"وَلَا","en":"and not","ur":"اور نہ","tr":"walā"},{"ar":"يَحْيَىٰ","en":"will live","ur":"زندہ ہوگا","tr":"yaḥyā"}],"87:14":[{"ar":"قَدْ","en":"Certainly","ur":"یقیناً","tr":"qad"},{"ar":"أَفْلَحَ","en":"has succeeded","ur":"فلاح پا گیا","tr":"aflaḥa"},{"ar":"مَن","en":"(one) who","ur":"وہ جس نے","tr":"man"},{"ar":"تَزَكَّىٰ","en":"purifies (himself)","ur":"پاکیزگی اختیار کی","tr":"tazakkā"}],"87:15":[{"ar":"وَذَكَرَ","en":"And remembers","ur":"اور ذکر کیا/ یاد کیا","tr":"wadhakara"},{"ar":"ٱسْمَ","en":"(the) name","ur":"نام","tr":"is'ma"},{"ar":"رَبِّهِۦ","en":"(of) his Lord","ur":"اپنے رب کا","tr":"rabbihi"},{"ar":"فَصَلَّىٰ","en":"and prays","ur":"پھر اس نے نماز پڑھی","tr":"faṣallā"}],"87:16":[{"ar":"بَلْ","en":"Nay","ur":"بلکہ","tr":"bal"},{"ar":"تُؤْثِرُونَ","en":"You prefer","ur":"تم ترجیح دیتے ہو","tr":"tu'thirūna"},{"ar":"ٱلْحَيَوٰةَ","en":"the life","ur":"زندگی کو","tr":"l-ḥayata"},{"ar":"ٱلدُّنْيَا","en":"(of) the world","ur":"دنیا کی","tr":"l-dun'yā"}],"87:17":[{"ar":"وَٱلْـَٔاخِرَةُ","en":"While the Hereafter","ur":"اور آخرت","tr":"wal-ākhiratu"},{"ar":"خَيْرٌۭ","en":"(is) better","ur":"بہتر ہے","tr":"khayrun"},{"ar":"وَأَبْقَىٰٓ","en":"and everlasting","ur":"اور زیادہ باقی رہنے والی","tr":"wa-abqā"}],"87:18":[{"ar":"إِنَّ","en":"Indeed","ur":"یقیناً","tr":"inna"},{"ar":"هَـٰذَا","en":"this","ur":"یہ","tr":"hādhā"},{"ar":"لَفِى","en":"surely (is) in","ur":"البتہ میں","tr":"lafī"},{"ar":"ٱلصُّحُفِ","en":"the Scriptures","ur":"صحیفوں میں ہے","tr":"l-ṣuḥufi"},{"ar":"ٱلْأُولَىٰ","en":"[the] former","ur":"پہلے","tr":"l-ūlā"}],"87:19":[{"ar":"صُحُفِ","en":"(The) Scriptures","ur":"صحیفوں میں","tr":"ṣuḥufi"},{"ar":"إِبْرَٰهِيمَ","en":"(of) Ibrahim","ur":"ابراہیم","tr":"ib'rāhīma"},{"ar":"وَمُوسَىٰ","en":"and Musa","ur":"اور موسیٰ کے","tr":"wamūsā"}]}
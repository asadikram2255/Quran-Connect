{"92:1":[{"ar":"وَٱلَّيْلِ","en":"By the night","ur":"قسم ہے رات کی","tr":"wa-al-layli"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"يَغْشَىٰ","en":"it covers","ur":"وہ چھا جائے","tr":"yaghshā"}],"92:2":[{"ar":"وَٱلنَّهَارِ","en":"And the day","ur":"قسم ہے دن کی","tr":"wal-nahāri"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"تَجَلَّىٰ","en":"it shines in brightness","ur":"وہ روشن ہو","tr":"tajallā"}],"92:3":[{"ar":"وَمَا","en":"And He Who","ur":"اور اس کی جس نے","tr":"wamā"},{"ar":"خَلَقَ","en":"created","ur":"پیدا کیا","tr":"khalaqa"},{"ar":"ٱلذَّكَرَ","en":"the male","ur":"نر کو","tr":"l-dhakara"},{"ar":"وَٱلْأُنثَىٰٓ","en":"and the female","ur":"اور مادہ کو","tr":"wal-unthā"}],"92:4":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"سَعْيَكُمْ","en":"your efforts","ur":"تمہاری کوشش","tr":"saʿyakum"},{"ar":"لَشَتَّىٰ","en":"(are) surely diverse","ur":"البتہ مختلف طرح کی ہے","tr":"lashattā"}],"92:5":[{"ar":"فَأَمَّا","en":"Then as for","ur":"تو رہا","tr":"fa-ammā"},{"ar":"مَنْ","en":"(him) who","ur":"وہ جس نے","tr":"man"},{"ar":"أَعْطَىٰ","en":"gives","ur":"دیا","tr":"aʿṭā"},{"ar":"وَٱتَّقَىٰ","en":"and fears","ur":"اور تقویٰ کیا","tr":"wa-ittaqā"}],"92:6":[{"ar":"وَصَدَّقَ","en":"And believes","ur":"اور تصدیق کی","tr":"waṣaddaqa"},{"ar":"بِٱلْحُسْنَىٰ","en":"in the best","ur":"بھلائی کی","tr":"bil-ḥus'nā"}],"92:7":[{"ar":"فَسَنُيَسِّرُهُۥ","en":"Then We will ease him","ur":"پس عنقریب ہم آسانی دیں گے اس کو","tr":"fasanuyassiruhu"},{"ar":"لِلْيُسْرَىٰ","en":"towards [the] ease","ur":"نیکی کے لئے/ آسانی کے لئے","tr":"lil'yus'rā"}],"92:8":[{"ar":"وَأَمَّا","en":"But as for","ur":"اور رہا وہ","tr":"wa-ammā"},{"ar":"مَنۢ","en":"(him) who","ur":"جس نے","tr":"man"},{"ar":"بَخِلَ","en":"withholds","ur":"بخل کیا","tr":"bakhila"},{"ar":"وَٱسْتَغْنَىٰ","en":"and considers himself free from need","ur":"اور بےپروائی برتی","tr":"wa-is'taghnā"}],"92:9":[{"ar":"وَكَذَّبَ","en":"And denies","ur":"اور جھٹلایا","tr":"wakadhaba"},{"ar":"بِٱلْحُسْنَىٰ","en":"the best","ur":"نیکی کو/ بھلائی کو","tr":"bil-ḥus'nā"}],"92:10":[{"ar":"فَسَنُيَسِّرُهُۥ","en":"Then We will ease him","ur":"پس عنقریب ہم آسانی دیں گے اس کو","tr":"fasanuyassiruhu"},{"ar":"لِلْعُسْرَىٰ","en":"towards [the] difficulty","ur":"تنگی کے لئے","tr":"lil'ʿus'rā"}],"92:11":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"يُغْنِى","en":"will avail","ur":"کس کام آئے گا/  کام آئے گا","tr":"yugh'nī"},{"ar":"عَنْهُ","en":"him","ur":"اس کو","tr":"ʿanhu"},{"ar":"مَالُهُۥٓ","en":"his wealth","ur":"اس کا مال","tr":"māluhu"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"تَرَدَّىٰٓ","en":"he falls","ur":"وہ ہلاک ہوگیا","tr":"taraddā"}],"92:12":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"عَلَيْنَا","en":"upon Us","ur":"ہمارے ذمہ","tr":"ʿalaynā"},{"ar":"لَلْهُدَىٰ","en":"(is) the guidance","ur":"البتہ ہدایت ہے","tr":"lalhudā"}],"92:13":[{"ar":"وَإِنَّ","en":"And indeed","ur":"اور بیشک","tr":"wa-inna"},{"ar":"لَنَا","en":"for Us","ur":"ہمارے لئے","tr":"lanā"},{"ar":"لَلْـَٔاخِرَةَ","en":"(is) the Hereafter","ur":"البتہ آخرت ہے","tr":"lalākhirata"},{"ar":"وَٱلْأُولَىٰ","en":"and the first (life)","ur":"اور اولیٰ / دنیا","tr":"wal-ūlā"}],"92:14":[{"ar":"فَأَنذَرْتُكُمْ","en":"So I warn you","ur":"تو خبردار کیا میں نے تم کو","tr":"fa-andhartukum"},{"ar":"نَارًۭا","en":"(of) a Fire","ur":"ایک آگ سے","tr":"nāran"},{"ar":"تَلَظَّىٰ","en":"blazing","ur":"جو بھٹرکتی ہے","tr":"talaẓẓā"}],"92:15":[{"ar":"لَا","en":"Not","ur":"نہ","tr":"lā"},{"ar":"يَصْلَىٰهَآ","en":"will burn (in) it","ur":"داخل ہوگا اس میں","tr":"yaṣlāhā"},{"ar":"إِلَّا","en":"except","ur":"مگر","tr":"illā"},{"ar":"ٱلْأَشْقَى","en":"the most wretched","ur":"بدبخت","tr":"l-ashqā"}],"92:16":[{"ar":"ٱلَّذِى","en":"The one who","ur":"جس نے","tr":"alladhī"},{"ar":"كَذَّبَ","en":"denied","ur":"جھٹلایا","tr":"kadhaba"},{"ar":"وَتَوَلَّىٰ","en":"and turned away","ur":"اور منہ موڑ لیا","tr":"watawallā"}],"92:17":[{"ar":"وَسَيُجَنَّبُهَا","en":"But will be removed from it","ur":"اور عنقریب بچالیا جائے گا اس سے","tr":"wasayujannabuhā"},{"ar":"ٱلْأَتْقَى","en":"the righteous","ur":"سب سے زیادہ پرہیزگار","tr":"l-atqā"}],"92:18":[{"ar":"ٱلَّذِى","en":"The one who","ur":"وہ جو","tr":"alladhī"},{"ar":"يُؤْتِى","en":"gives","ur":"دیتا ہے","tr":"yu'tī"},{"ar":"مَالَهُۥ","en":"his wealth","ur":"مال اپنا","tr":"mālahu"},{"ar":"يَتَزَكَّىٰ","en":"(to) purify himself","ur":"کہ پاکیزگی اختیار کرے","tr":"yatazakkā"}],"92:19":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"لِأَحَدٍ","en":"for anyone","ur":"کسی ایک کے لئے","tr":"li-aḥadin"},{"ar":"عِندَهُۥ","en":"with him","ur":"اس کے پاس","tr":"ʿindahu"},{"ar":"مِن","en":"any","ur":"سے","tr":"min"},{"ar":"نِّعْمَةٍۢ","en":"favor","ur":"نعمت میں (سے)","tr":"niʿ'matin"},{"ar":"تُجْزَىٰٓ","en":"to be recompensed","ur":"جس کا بدلہ دیا جائے گا/ اسے دینا ہو","tr":"tuj'zā"}],"92:20":[{"ar":"إِلَّا","en":"Except","ur":"سوائے/ مگر","tr":"illā"},{"ar":"ٱبْتِغَآءَ","en":"seeking","ur":"تلاش کرنے کو","tr":"ib'tighāa"},{"ar":"وَجْهِ","en":"(the) Countenance","ur":"ذات/ رضا","tr":"wajhi"},{"ar":"رَبِّهِ","en":"(of) his Lord","ur":"اپنے رب","tr":"rabbihi"},{"ar":"ٱلْأَعْلَىٰ","en":"the Most High","ur":"اعلیٰ کی","tr":"l-aʿlā"}],"92:21":[{"ar":"وَلَسَوْفَ","en":"And soon, surely","ur":"اور البتہ عنقریب","tr":"walasawfa"},{"ar":"يَرْضَىٰ","en":"he will be pleased","ur":"وہ راضی ہوجائے گا","tr":"yarḍā"}]}
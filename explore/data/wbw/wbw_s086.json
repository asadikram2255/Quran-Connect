{"86:1":[{"ar":"وَٱلسَّمَآءِ","en":"By the sky","ur":"قسم ہے آسمان کی","tr":"wal-samāi"},{"ar":"وَٱلطَّارِقِ","en":"and the night comer","ur":"اور رات کو آنے والے کی","tr":"wal-ṭāriqi"}],"86:2":[{"ar":"وَمَآ","en":"And what","ur":"اور کیا چیز","tr":"wamā"},{"ar":"أَدْرَىٰكَ","en":"can make you know","ur":"بتائے تجھ کو","tr":"adrāka"},{"ar":"مَا","en":"what","ur":"کیا ہے","tr":"mā"},{"ar":"ٱلطَّارِقُ","en":"the night comer (is)","ur":"وہ رات کو آنے والا","tr":"l-ṭāriqu"}],"86:3":[{"ar":"ٱلنَّجْمُ","en":"(It is) the star","ur":"تارہ","tr":"al-najmu"},{"ar":"ٱلثَّاقِبُ","en":"the piercing","ur":"چکمتا ہوا","tr":"l-thāqibu"}],"86:4":[{"ar":"إِن","en":"Not","ur":"نہیں","tr":"in"},{"ar":"كُلُّ","en":"(is) every","ur":"کوئی","tr":"kullu"},{"ar":"نَفْسٍۢ","en":"soul","ur":"شخص","tr":"nafsin"},{"ar":"لَّمَّا","en":"but","ur":"مگر","tr":"lammā"},{"ar":"عَلَيْهَا","en":"over it","ur":"اس پر","tr":"ʿalayhā"},{"ar":"حَافِظٌۭ","en":"(is) a protector","ur":"حفاظت کرنے والا ہے/ نگرانی کرنے والا ہے","tr":"ḥāfiẓun"}],"86:5":[{"ar":"فَلْيَنظُرِ","en":"So let see","ur":"پس چاہیے کہ دیکھے","tr":"falyanẓuri"},{"ar":"ٱلْإِنسَـٰنُ","en":"man","ur":"انسان","tr":"l-insānu"},{"ar":"مِمَّ","en":"from what","ur":"کس چیز سے","tr":"mimma"},{"ar":"خُلِقَ","en":"he is created","ur":"وہ پیدا کیا گیا","tr":"khuliqa"}],"86:6":[{"ar":"خُلِقَ","en":"He is created","ur":"پیدا کیا گیا","tr":"khuliqa"},{"ar":"مِن","en":"from","ur":"سے","tr":"min"},{"ar":"مَّآءٍۢ","en":"a water","ur":"پانی (سے)","tr":"māin"},{"ar":"دَافِقٍۢ","en":"ejected","ur":"جو ٹپکنے والا ہے","tr":"dāfiqin"}],"86:7":[{"ar":"يَخْرُجُ","en":"Coming forth","ur":"نکلتا ہے","tr":"yakhruju"},{"ar":"مِنۢ","en":"from","ur":"سے","tr":"min"},{"ar":"بَيْنِ","en":"between","ur":"درمیان سے","tr":"bayni"},{"ar":"ٱلصُّلْبِ","en":"the backbone","ur":"پیٹھ کی ہڈی کے","tr":"l-ṣul'bi"},{"ar":"وَٱلتَّرَآئِبِ","en":"and the ribs","ur":"اور سینے کی ہڈیوں ( کے درمیان سے)","tr":"wal-tarāibi"}],"86:8":[{"ar":"إِنَّهُۥ","en":"Indeed, He","ur":"بیشک وہ","tr":"innahu"},{"ar":"عَلَىٰ","en":"to","ur":"اوپر","tr":"ʿalā"},{"ar":"رَجْعِهِۦ","en":"return him","ur":"اس کے واپس لانے کے","tr":"rajʿihi"},{"ar":"لَقَادِرٌۭ","en":"(is) Able","ur":"البتہ قادر ہے","tr":"laqādirun"}],"86:9":[{"ar":"يَوْمَ","en":"(The) Day","ur":"جس دن","tr":"yawma"},{"ar":"تُبْلَى","en":"will be tested","ur":"جانچ پڑتال ہوگی","tr":"tub'lā"},{"ar":"ٱلسَّرَآئِرُ","en":"the secrets","ur":"پوشیدہ رازوں کی","tr":"l-sarāiru"}],"86:10":[{"ar":"فَمَا","en":"Then not","ur":"تو نہیں ہوگی","tr":"famā"},{"ar":"لَهُۥ","en":"(is) for him","ur":"اس کے لئے","tr":"lahu"},{"ar":"مِن","en":"any","ur":"کوئی","tr":"min"},{"ar":"قُوَّةٍۢ","en":"power","ur":"قوت","tr":"quwwatin"},{"ar":"وَلَا","en":"and not","ur":"اور نہ","tr":"walā"},{"ar":"نَاصِرٍۢ","en":"any helper","ur":"کوئی مددگار","tr":"nāṣirin"}],"86:11":[{"ar":"وَٱلسَّمَآءِ","en":"By the sky","ur":"قسم ہے آسمان کی","tr":"wal-samāi"},{"ar":"ذَاتِ","en":"which","ur":"والے کی","tr":"dhāti"},{"ar":"ٱلرَّجْعِ","en":"returns","ur":"پلٹنے (والے کی)","tr":"l-rajʿi"}],"86:12":[{"ar":"وَٱلْأَرْضِ","en":"And the earth","ur":"اور زمین کی","tr":"wal-arḍi"},{"ar":"ذَاتِ","en":"which","ur":"والی ہے","tr":"dhāti"},{"ar":"ٱلصَّدْعِ","en":"cracks open","ur":"جو پھٹنے (والی ہے)","tr":"l-ṣadʿi"}],"86:13":[{"ar":"إِنَّهُۥ","en":"Indeed, it","ur":"بیشک وہ","tr":"innahu"},{"ar":"لَقَوْلٌۭ","en":"(is) surely a Word","ur":"البتہ ایک بات ہے","tr":"laqawlun"},{"ar":"فَصْلٌۭ","en":"decisive","ur":"فیصلہ کن","tr":"faṣlun"}],"86:14":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"هُوَ","en":"it","ur":"وہ","tr":"huwa"},{"ar":"بِٱلْهَزْلِ","en":"(is) for amusement","ur":"کوئی ہنسی مذاق","tr":"bil-hazli"}],"86:15":[{"ar":"إِنَّهُمْ","en":"Indeed, they","ur":"بیشک وہ","tr":"innahum"},{"ar":"يَكِيدُونَ","en":"are plotting","ur":"چال چل رہے ہیں","tr":"yakīdūna"},{"ar":"كَيْدًۭا","en":"a plot","ur":"ایک چال","tr":"kaydan"}],"86:16":[{"ar":"وَأَكِيدُ","en":"But I am planning","ur":"اور میں تدبیر کر رہا ہوں","tr":"wa-akīdu"},{"ar":"كَيْدًۭا","en":"a plan","ur":"ایک تدبیر","tr":"kaydan"}],"86:17":[{"ar":"فَمَهِّلِ","en":"So give respite","ur":"پس ڈھیل دے دو","tr":"famahhili"},{"ar":"ٱلْكَـٰفِرِينَ","en":"(to) the disbelievers","ur":"کافروں کو","tr":"l-kāfirīna"},{"ar":"أَمْهِلْهُمْ","en":"Give respite to them","ur":"ڈھیل دو ان کو","tr":"amhil'hum"},{"ar":"رُوَيْدًۢا","en":"little","ur":"مہلت تھوڑی سی","tr":"ruwaydan"}]}
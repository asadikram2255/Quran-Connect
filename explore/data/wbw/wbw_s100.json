{"100:1":[{"ar":"وَٱلْعَـٰدِيَـٰتِ","en":"By the racers","ur":"قسم ہے دوڑنے والیوں کی","tr":"wal-ʿādiyāti"},{"ar":"ضَبْحًۭا","en":"panting","ur":"ہانپ کر","tr":"ḍabḥan"}],"100:2":[{"ar":"فَٱلْمُورِيَـٰتِ","en":"And the producers of sparks","ur":"پھر قسم ہے آگ نکالنے والیوں کی","tr":"fal-mūriyāti"},{"ar":"قَدْحًۭا","en":"striking","ur":"جھاڑ کر","tr":"qadḥan"}],"100:3":[{"ar":"فَٱلْمُغِيرَٰتِ","en":"And the chargers","ur":"پھر قسم ہے چھاپہ مارنے والیوں کی","tr":"fal-mughīrāti"},{"ar":"صُبْحًۭا","en":"(at) dawn","ur":"صبح کے وقت","tr":"ṣub'ḥan"}],"100:4":[{"ar":"فَأَثَرْنَ","en":"Then raise","ur":"پھر قسم ہے اڑانے والیاں","tr":"fa-atharna"},{"ar":"بِهِۦ","en":"thereby","ur":"ساتھ اس کے","tr":"bihi"},{"ar":"نَقْعًۭا","en":"dust","ur":"غبار کو","tr":"naqʿan"}],"100:5":[{"ar":"فَوَسَطْنَ","en":"Then penetrate (in the) center","ur":"پھر گھس جانے والیاں","tr":"fawasaṭna"},{"ar":"بِهِۦ","en":"thereby","ur":"ساتھ اس کے","tr":"bihi"},{"ar":"جَمْعًا","en":"collectively","ur":"جماعت میں/ گروہ میں","tr":"jamʿan"}],"100:6":[{"ar":"إِنَّ","en":"Indeed","ur":"یقیناً","tr":"inna"},{"ar":"ٱلْإِنسَـٰنَ","en":"mankind","ur":"انسان","tr":"l-insāna"},{"ar":"لِرَبِّهِۦ","en":"to his Lord","ur":"اپنے رب کے لئے","tr":"lirabbihi"},{"ar":"لَكَنُودٌۭ","en":"(is) surely ungrateful","ur":"البتہ ناشکرا ہے","tr":"lakanūdun"}],"100:7":[{"ar":"وَإِنَّهُۥ","en":"And indeed, he","ur":"اور بیشک وہ","tr":"wa-innahu"},{"ar":"عَلَىٰ","en":"on","ur":"اوپر","tr":"ʿalā"},{"ar":"ذَٰلِكَ","en":"that","ur":"اس کے","tr":"dhālika"},{"ar":"لَشَهِيدٌۭ","en":"surely (is) a witness","ur":"البتہ گواہ ہے","tr":"lashahīdun"}],"100:8":[{"ar":"وَإِنَّهُۥ","en":"And indeed he","ur":"اور بیشک وہ","tr":"wa-innahu"},{"ar":"لِحُبِّ","en":"in (the) love","ur":"محبت میں","tr":"liḥubbi"},{"ar":"ٱلْخَيْرِ","en":"(of) wealth","ur":"مال کی","tr":"l-khayri"},{"ar":"لَشَدِيدٌ","en":"(is) surely intense","ur":"البتہ سخت ہے","tr":"lashadīdun"}],"100:9":[{"ar":"۞ أَفَلَا","en":"But does not","ur":"کیا بھلا نہیں","tr":"afalā"},{"ar":"يَعْ
{"85:1":[{"ar":"وَٱلسَّمَآءِ","en":"By the sky","ur":"قسم ہے آسمان کی","tr":"wal-samāi"},{"ar":"ذَاتِ","en":"containing","ur":"والا ہے","tr":"dhāti"},{"ar":"ٱلْبُرُوجِ","en":"the constellations","ur":"جو برجوں (والا ہے)","tr":"l-burūji"}],"85:2":[{"ar":"وَٱلْيَوْمِ","en":"And the Day","ur":"اور قسم ہے  دن کی","tr":"wal-yawmi"},{"ar":"ٱلْمَوْعُودِ","en":"Promised","ur":"وعدہ کئے گئے","tr":"l-mawʿūdi"}],"85:3":[{"ar":"وَشَاهِدٍۢ","en":"And (the) witness","ur":"اور حاضر ہونے والی","tr":"washāhidin"},{"ar":"وَمَشْهُودٍۢ","en":"and what is witnessed","ur":"اور حاضر کیے ہوئے کی","tr":"wamashhūdin"}],"85:4":[{"ar":"قُتِلَ","en":"Destroyed were","ur":"مارے گئے","tr":"qutila"},{"ar":"أَصْحَـٰبُ","en":"(the) companions","ur":"والے","tr":"aṣḥābu"},{"ar":"ٱلْأُخْدُودِ","en":"(of) the pit","ur":"خندقوں (والے)","tr":"l-ukh'dūdi"}],"85:5":[{"ar":"ٱلنَّارِ","en":"(Of) the fire","ur":"جو آگ تھی","tr":"al-nāri"},{"ar":"ذَاتِ","en":"full","ur":"والی","tr":"dhāti"},{"ar":"ٱلْوَقُودِ","en":"(of) the fuel","ur":"ایندھن (والی)","tr":"l-waqūdi"}],"85:6":[{"ar":"إِذْ","en":"When","ur":"جب","tr":"idh"},{"ar":"هُمْ","en":"they","ur":"وہ","tr":"hum"},{"ar":"عَلَيْهَا","en":"by it","ur":"اس پر","tr":"ʿalayhā"},{"ar":"قُعُودٌۭ","en":"(were) sitting","ur":"بیٹھے ہوئے تھے","tr":"quʿūdun"}],"85:7":[{"ar":"وَهُمْ","en":"And they","ur":"اور وہ","tr":"wahum"},{"ar":"عَلَىٰ","en":"over","ur":"اوپر","tr":"ʿalā"},{"ar":"مَا","en":"what","ur":"اس کے جو","tr":"mā"},{"ar":"يَفْعَلُونَ","en":"they were doing","ur":"وہ کر رہے تھے","tr":"yafʿalūna"},{"ar":"بِٱلْمُؤْمِنِينَ","en":"to the believers","ur":"مومنوں کے ساتھ","tr":"bil-mu'minīna"},{"ar":"شُهُودٌۭ","en":"witnesses","ur":"حاضر تھے","tr":"shuhūdun"}],"85:8":[{"ar":"وَمَا","en":"And not","ur":"اور نہ","tr":"wamā"},{"ar":"نَقَمُوا۟","en":"they resented","ur":"وہ ناراض ہوئے","tr":"naqamū"},{"ar":"مِنْهُمْ","en":"[of] them","ur":"ان سے","tr":"min'hum"},{"ar":"إِلَّآ","en":"except","ur":"مگر","tr":"illā"},{"ar":"أَن","en":"that","ur":"یہ کہ","tr":"an"},{"a
11":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے عمل کئے","tr":"waʿamilū"},{"ar":"ٱلصَّـٰلِحَـٰتِ","en":"the righteous deeds","ur":"اچھے","tr":"l-ṣāliḥāti"},{"ar":"لَهُمْ","en":"for them","ur":"ان کے لئے","tr":"lahum"},{"ar":"جَنَّـٰتٌۭ","en":"(will be) Gardens","ur":"باغ ہیں","tr":"jannātun"},{"ar":"تَجْرِى","en":"flow","ur":"بہتی ہیں","tr":"tajrī"},{"ar":"مِن","en":"from","ur":"سے","tr":"min"},{"ar":"تَحْتِهَا","en":"underneath it","ur":"ان کے نیچے (سے)","tr":"taḥtihā"},{"ar":"ٱلْأَنْهَـٰرُ ۚ","en":"the rivers","ur":"نہریں","tr":"l-anhāru"},{"ar":"ذَٰلِكَ","en":"That","ur":"یہ","tr":"dhālika"},{"ar":"ٱلْفَوْزُ","en":"(is) the success","ur":"کامیابی ہے","tr":"l-fawzu"},{"ar":"ٱلْكَبِيرُ","en":"the great","ur":"بڑی","tr":"l-kabīru"}],"85:12":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"بَطْشَ","en":"(the) Grip","ur":"پکڑ","tr":"baṭsha"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"تیرے رب کی","tr":"rabbika"},{"ar":"لَشَدِيدٌ","en":"(is) surely strong","ur":"البتہ بہت شدید ہے","tr":"lashadīdun"}],"85:13":[{"ar":"إِنَّهُۥ","en":"Indeed He","ur":"بیشک وہ","tr":"innahu"},{"ar":"هُوَ","en":"He","ur":"وہی","tr":"huwa"},{"ar":"يُبْدِئُ","en":"originates","ur":"پیدا کرتا ہے","tr":"yub'di-u"},{"ar":"وَيُعِيدُ","en":"and repeats","ur":"اور لوٹاتا ہے","tr":"wayuʿīdu"}],"85:14":[{"ar":"وَهُوَ","en":"And He","ur":"اور وہ","tr":"wahuwa"},{"ar":"ٱلْغَفُورُ","en":"(is) the Oft-Forgiving","ur":"بخشش فرمانے والا","tr":"l-ghafūru"},{"ar":"ٱلْوَدُودُ","en":"the Most Loving","ur":"محبت کرنے والا ہے","tr":"l-wadūdu"}],"85:15":[{"ar":"ذُو","en":"Owner (of)","ur":"والا ہے","tr":"dhū"},{"ar":"ٱلْعَرْشِ","en":"the Throne","ur":"عرش (والا ہے)","tr":"l-ʿarshi"},{"ar":"ٱلْمَجِيدُ","en":"the Glorious","ur":"صاحب فضل و کرم ہے/ بزرگ و برتر ہے","tr":"l-majīdu"}],"85:16":[{"ar":"فَعَّالٌۭ",
{"1:1":[{"ar":"بِسْمِ","en":"In (the) name","ur":"ساتھ نام","tr":"bis'mi"},{"ar":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے","tr":"l-lahi"},{"ar":"ٱلرَّحْمَـٰنِ","en":"the Most Gracious","ur":"جو بے حد مہربان ہے","tr":"l-raḥmāni"},{"ar":"ٱلرَّحِيمِ","en":"the Most Merciful","ur":"بار بار رحم فرمانے والا ہے","tr":"l-raḥīmi"}],"1:2":[{"ar":"ٱلْحَمْدُ","en":"All praises and thanks","ur":"سب تعریف","tr":"al-ḥamdu"},{"ar":"لِلَّهِ","en":"(be) to Allah","ur":"اللہ کے لیے ہے","tr":"lillahi"},{"ar":"رَبِّ","en":"the Lord","ur":"جو رب ہے","tr":"rabbi"},{"ar":"ٱلْعَـٰلَمِينَ","en":"of the universe","ur":"تمام جہانوں کا","tr":"l-ʿālamīna"}],"1:3":[{"ar":"ٱلرَّحْمَـٰنِ","en":"The Most Gracious","ur":"جو بہت مہربان","tr":"al-raḥmāni"},{"ar":"ٱلرَّحِيمِ","en":"the Most Merciful","ur":"بار بار رحم فرمانے والا ہے","tr":"l-raḥīmi"}],"1:4":[{"ar":"مَـٰلِكِ","en":"(The) Master","ur":"مالک ہے","tr":"māliki"},{"ar":"يَوْمِ","en":"(of the) Day","ur":"دن کا","tr":"yawmi"},{"ar":"ٱلدِّينِ","en":"(of the) Judgment","ur":"بدلے کے","tr":"l-dīni"}],"1:5":[{"ar":"إِيَّاكَ","en":"You Alone","ur":"صرف تیری","tr":"iyyāka"},{"ar":"نَعْبُدُ","en":"we worship","ur":"ہم عبادت کرتے ہیں","tr":"naʿbudu"},{"ar":"وَإِيَّاكَ","en":"and You Alone","ur":"اور صرف تجھ سے","tr":"wa-iyyāka"},{"ar":"نَسْتَعِينُ","en":"we ask for help","ur":"ہم مدد چاہتے ہیں","tr":"nastaʿīnu"}],"1:6":[{"ar":"ٱهْدِنَا","en":"Guide us","ur":"دکھا ہم کو","tr":"ih'dinā"},{"ar":"ٱلصِّرَٰطَ","en":"(to) the path","ur":"راستہ","tr":"l-ṣirāṭa"},{"ar":"ٱلْمُسْتَقِيمَ","en":"the straight","ur":"سیدھا","tr":"l-mus'taqīma"}],"1:7":[{"ar":"صِرَٰطَ","en":"(The) path","ur":"راستہ","tr":"ṣirāṭa"},{"ar":"ٱلَّذِينَ","en":"(of) those","ur":"ان لوگوں کا","tr":"alladhīna"},{"ar":"أَنْعَمْتَ","en":"You have bestowed (Your) Favors","ur":"انعام کیا تو نے","tr":"anʿamta"},{"ar":"عَلَيْهِمْ","en":"on them","ur":"اوپر ان کے","tr":"ʿalayhim"},{"ar":"غَيْرِ","en":"not (of)","ur":"نہ ان (لوگوں) کا","tr":"ghayri"},{"ar":"ٱلْمَغْضُوبِ","en":"those who earned (Your) wrath","ur":"غضب کیا گیا","tr":"l-maghḍūbi"},{"ar":"عَلَيْهِمْ","en":"on themselves","ur":"اوپر ان کے","tr":"ʿalayhim"},{"ar":"وَلَا","en":"and not","ur":"اور نہ","tr":"walā"},{"ar":"ٱلضَّآلِّينَ","en":"(of) those who go astray","ur":"ان (لوگوں) کا جو گمراہ ہیں / گم کردہ راہ ہیں","tr":"l-ḍālīna"}]}
{"44:1":[{"ar":"حمٓ","en":"Ha Meem","ur":"حم","tr":"hha-meem"}],"44:2":[{"ar":"وَٱلْكِتَـٰبِ","en":"By the Book","ur":"قسم ہے کتاب","tr":"wal-kitābi"},{"ar":"ٱلْمُبِينِ","en":"the clear","ur":"روشن کی","tr":"l-mubīni"}],"44:3":[{"ar":"إِنَّآ","en":"Indeed, We","ur":"بیشک ہم نے","tr":"innā"},{"ar":"أَنزَلْنَـٰهُ","en":"revealed it","ur":"نازل کیا ہم نے اس کو","tr":"anzalnāhu"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"لَيْلَةٍۢ","en":"a Night","ur":"ایک رات","tr":"laylatin"},{"ar":"مُّبَـٰرَكَةٍ ۚ","en":"Blessed","ur":"بابرکت","tr":"mubārakatin"},{"ar":"إِنَّا","en":"Indeed, We","ur":"بیشک ہم","tr":"innā"},{"ar":"كُنَّا","en":"[We] are","ur":"تھے ہم","tr":"kunnā"},{"ar":"مُنذِرِينَ","en":"(ever) warning","ur":"ڈرانے  والے۔ متنبہ کرنے والے","tr":"mundhirīna"}],"44:4":[{"ar":"فِيهَا","en":"Therein","ur":"اس میں","tr":"fīhā"},{"ar":"يُفْرَقُ","en":"is made distinct","ur":"فیصلہ کیا جاتا ہے","tr":"yuf'raqu"},{"ar":"كُلُّ","en":"every","ur":"ہر","tr":"kullu"},{"ar":"أَمْرٍ","en":"affair","ur":"کام کا","tr":"amrin"},{"ar":"حَكِيمٍ","en":"wise","ur":"مضبوط","tr":"ḥakīmin"}],"44:5":[{"ar":"أَمْرًۭا","en":"A command","ur":"ایک حکم","tr":"amran"},{"ar":"مِّنْ","en":"from","ur":"سے","tr":"min"},{"ar":"عِندِنَآ ۚ","en":"Us","ur":"ہماری طرف ۔ ہمارے پاس","tr":"ʿindinā"},{"ar":"إِنَّا","en":"Indeed, We","ur":"بیشک ہم","tr":"innā"},{"ar":"كُنَّا","en":"[We] are","ur":"تھے ہم","tr":"kunnā"},{"ar":"مُرْسِلِينَ","en":"(ever) sending","ur":"بھیجنے والے","tr":"mur'silīna"}],"44:6":[{"ar":"رَحْمَةًۭ","en":"As Mercy","ur":"رحمت کے طور پر","tr":"raḥmatan"},{"ar":"مِّن","en":"from","ur":"سے","tr":"min"},{"ar":"رَّبِّكَ ۚ","en":"your Lord","ur":"تیرے رب کی طرف","tr":"rabbika"},{"ar":"إِنَّهُۥ","en":"Indeed, He","ur":"بیشک وہ","tr":"innahu"},{"ar":"هُوَ","en":"[He]","ur":"وہ","tr":"huwa"},{"ar":"ٱلسَّمِيعُ","en":"(is) the All-Hearer","ur":"سننے والا ہے","tr":"l-samīʿu"},{"ar":"ٱلْعَلِيمُ","en":"the All-Knower","ur":"علم والا ہے","tr":"l-ʿalīmu"}],"44:7":[{"ar":"رَبِّ","en":"Lord","u
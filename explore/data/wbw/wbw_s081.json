{"81:1":[{"ar":"إِذَا","en":"When","ur":"جب","tr":"idhā"},{"ar":"ٱلشَّمْسُ","en":"the sun","ur":"سورج","tr":"l-shamsu"},{"ar":"كُوِّرَتْ","en":"is wrapped up","ur":"لپیٹ دیا جائے گا","tr":"kuwwirat"}],"81:2":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلنُّجُومُ","en":"the stars","ur":"تارے","tr":"l-nujūmu"},{"ar":"ٱنكَدَرَتْ","en":"fall, losing their luster","ur":"گدلے ہوجائیں گے","tr":"inkadarat"}],"81:3":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْجِبَالُ","en":"the mountains","ur":"پہاڑ","tr":"l-jibālu"},{"ar":"سُيِّرَتْ","en":"are moved away","ur":"چلا دیئے جائیں گے","tr":"suyyirat"}],"81:4":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْعِشَارُ","en":"the full-term she-camels","ur":"دس مہینے کی حاملہ اونٹنیاں","tr":"l-ʿishāru"},{"ar":"عُطِّلَتْ","en":"(are) left untended","ur":"تنہا چھوڑ دی جائیں گی","tr":"ʿuṭṭilat"}],"81:5":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْوُحُوشُ","en":"the wild beasts","ur":"وحشی جانور","tr":"l-wuḥūshu"},{"ar":"حُشِرَتْ","en":"are gathered","ur":"اکٹھے کردیئے جائیں گے","tr":"ḥushirat"}],"81:6":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْبِحَارُ","en":"the seas","ur":"سمندر","tr":"l-biḥāru"},{"ar":"سُجِّرَتْ","en":"are made to overflow","ur":"بھڑکادیئے جائیں گے","tr":"sujjirat"}],"81:7":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلنُّفُوسُ","en":"the souls","ur":"جانیں","tr":"l-nufūsu"},{"ar":"زُوِّجَتْ","en":"are paired","ur":"جوڑ دی جائیں گے","tr":"zuwwijat"}],"81:8":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْمَوْءُۥدَةُ","en":"the female infant buried alive","ur":"زندہ گاڑی ہوئی لڑکی","tr":"l-mawūdatu"},{"ar":"سُئِلَتْ","en":"is asked","ur":"پوچھی جائے گی","tr":"su-ilat"}],"81:9":[{"ar":"بِأَىِّ","en":"For what","ur":"کس","tr":"bi-ayyi"},{"ar":"ذَنۢبٍۢ","en":"sin","ur":"گناہ میں","tr":"dhanbin"},{"ar":"قُتِلَتْ","en":"she was killed","ur":"ماری گئی","tr":"qutilat"}],"81:10":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلصُّحُفُ","en":"the pages","ur":"اعمال نامے","tr":"l-ṣuḥufu"},{"ar":"نُشِرَتْ","en":"are laid open","ur":"پھیلادیئے جائیں گے","tr":"nushirat"}],"81:11":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلسَّمَآءُ","en":"the sky","ur":"آسمان","tr":"l-samāu"},{"ar":"كُشِطَتْ","en":"is stripped away","ur":"اس کی کھال اتار دی جائے گی","tr":"kushiṭat"}],"81:12":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْجَحِيمُ","en":"the Hellfire","ur":"جہنم","tr":"l-jaḥīmu"},{"ar":"سُعِّرَتْ","en":"is set ablaze","ur":"بھڑکا دی جائے گی","tr":"suʿʿirat"}],"81:13":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْجَنَّةُ","en":"Paradise","ur":"جنت","tr":"l-janatu"},{"ar":"أُزْلِفَتْ","en":"is brought near","ur":"قریب لے آئی جائے گی","tr":"uz'lifat"}],"81:14":[{"ar":"عَلِمَتْ","en":"Will know","ur":"جان لے گا","tr":"ʿalimat"},{"ar":"نَفْسٌۭ","en":"a soul","ur":"ہر نفس","tr":"nafsun"},{"ar":"مَّآ","en":"what","ur":"کیا","tr":"mā"},{"ar":"أَحْضَرَتْ","en":"it has brought","ur":"اس نے حاضر کیا/ کیا لے کر آیا","tr":"aḥḍarat"}],"81:15":[{"ar":"فَلَآ","en":"But nay","ur":"پس نہیں","tr":"falā"},{"ar":"أُقْسِمُ","en":"I swear","ur":"میں قسم کھاتا ہوں","tr":"uq'simu"},{"ar":"بِٱلْخُنَّسِ","en":"by the retreating planets","ur":"پیچھے ہٹنے والے کی","tr":"bil-khunasi"}],"81:16":[{"ar":"ٱلْجَوَارِ","en":"Those that run","ur":"سیدھے چلنے والے","tr":"al-jawāri"},{"ar":"ٱلْكُنَّسِ","en":"(and) disappear","ur":"چھپ جانے والے (ستاروں کی)","tr":"l-kunasi"}],"81:17":[{"ar":"وَٱلَّيْلِ","en":"And the night","ur":"اور رات کی","tr":"wa-al-layli"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"عَسْعَسَ","en":"it departs","ur":"وہ رخصت ہوتی ہے","tr":"ʿasʿasa"}],"81:18":[{"ar":"وَٱلصُّبْحِ","en":"And the dawn","ur":"اور صبح کی","tr":"wal-ṣub'ḥi"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"تَنَفَّسَ","en":"it breathes","ur":"وہ سانس لیتی ہے","tr":"tanaffasa"}],"81:19":[{"ar":"إِنَّهُۥ","en":"Indeed, it","ur":"بیشک وہ","tr":"innahu"},{"ar":"لَقَوْلُ","en":"(is) surely a word","ur":"البتہ قول ہے/ کہنا ہے","tr":"laqawlu"},{"ar":"رَسُولٍۢ","en":"(of) a Messenger","ur":"ایک پیام بر کا","tr":"rasūlin"},{"ar":"كَرِيمٍۢ","en":"noble","ur":"معزز کا","tr":"karīmin"}],"81:20":[{"ar":"ذِى","en":"Possessor of","ur":"والا ہے","tr":"dhī"},{"ar":"قُوَّةٍ","en":"power","ur":"قوت کا","tr":"quwwatin"},{"ar":"عِندَ","en":"with","ur":"نزدیک","tr":"ʿinda"},{"ar":"ذِى","en":"(the) Owner of","ur":"والے کے","tr":"dhī"},{"ar":"ٱلْعَرْشِ","en":"the Throne","ur":"عرش (والے کے )","tr":"l-ʿarshi"},{"ar":"مَكِينٍۢ","en":"secure","ur":"بلند مرتبے والا","tr":"makīnin"}],"81:21":[{"ar":"مُّطَاعٍۢ","en":"One to be obeyed","ur":"کہا مانا گیا","tr":"muṭāʿin"},{"ar":"ثَمَّ","en":"and","ur":"اس جگہ","tr":"thamma"},{"ar":"أَمِينٍۢ","en":"trustworthy","ur":"امانت دار ہے","tr":"amīnin"}],"81:22":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"صَاحِبُكُم","en":"(is) your companion","ur":"ساتھ تمہارا","tr":"ṣāḥibukum"},{"ar":"بِمَجْنُونٍۢ","en":"mad","ur":"کوئی مجنون","tr":"bimajnūnin"}],"81:23":[{"ar":"وَلَقَدْ","en":"And certainly","ur":"اور البتہ تحقیق","tr":"walaqad"},{"ar":"رَءَاهُ","en":"he saw him","ur":"اس نے دیکھا اس کو","tr":"raāhu"},{"ar":"بِٱلْأُفُقِ","en":"in the horizon","ur":"آسمان کے کنارے پر","tr":"bil-ufuqi"},{"ar":"ٱلْمُبِينِ","en":"the clear","ur":"کھلے","tr":"l-mubīni"}],"81:24":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"هُوَ","en":"he (is)","ur":"وہ","tr":"huwa"},{"ar":"عَلَى","en":"on","ur":"پر","tr":"ʿalā"},{"ar":"ٱلْغَيْبِ","en":"the unseen","ur":"غیب","tr":"l-ghaybi"},{"ar":"بِضَنِينٍۢ","en":"a withholder","ur":"ہرگز بخیل","tr":"biḍanīnin"}],"81:25":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں ہے","tr":"wamā"},{"ar":"هُوَ","en":"it","ur":"وہ","tr":"huwa"},{"ar":"بِقَوْلِ","en":"(is the) word","ur":"قول","tr":"biqawli"},{"ar":"شَيْطَـٰنٍۢ","en":"(of) Shaitaan","ur":"شیطان","tr":"shayṭānin"},{"ar":"رَّجِيمٍۢ","en":"accursed","ur":"مردود کا","tr":"rajīmin"}],"81:26":[{"ar":"فَأَيْنَ","en":"So where","ur":"پھر کدھر","tr":"fa-ayna"},{"ar":"تَذْهَبُونَ","en":"are you going","ur":"تم جارہے ہو","tr":"tadhhabūna"}],"81:27":[{"ar":"إِنْ","en":"Not","ur":"نہیں","tr":"in"},{"ar":"هُوَ","en":"it","ur":"وہ","tr":"huwa"},{"ar":"إِلَّا","en":"(is) except","ur":"مگر","tr":"illā"},{"ar":"ذِكْرٌۭ","en":"a reminder","ur":"ایک نصیحت ہے","tr":"dhik'run"},{"ar":"لِّلْعَـٰلَمِينَ","en":"to the worlds","ur":"جہان والوں کے لئے","tr":"lil'ʿālamīna"}],"81:28":[{"ar":"لِمَن","en":"For whoever","ur":"واسطے اس کو","tr":"liman"},{"ar":"شَآءَ","en":"wills","ur":"جو چاہے","tr":"shāa"},{"ar":"مِنكُمْ","en":"among you","ur":"تم میں سے","tr":"minkum"},{"ar":"أَن","en":"to","ur":"کہ","tr":"an"},{"ar":"يَسْتَقِيمَ","en":"take a straight way","ur":"راہ راست پر چلے","tr":"yastaqīma"}],"81:29":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"تَشَآءُونَ","en":"you will","ur":"تم چاہ سکتے","tr":"tashāūna"},{"ar":"إِلَّآ","en":"except","ur":"مگر","tr":"illā"},{"ar":"أَن","en":"that","ur":"یہ کہ","tr":"an"},{"ar":"يَشَآءَ","en":"wills","ur":"چاہے","tr":"yashāa"},{"ar":"ٱللَّهُ","en":"Allah","ur":"اللہ","tr":"l-lahu"},{"ar":"رَبُّ","en":"Lord","ur":"جو رب ہے","tr":"rabbu"},{"ar":"ٱلْعَـٰلَمِينَ","en":"(of) the worlds","ur":"سارے جہان والوں کا","tr":"l-ʿālamīna"}]}
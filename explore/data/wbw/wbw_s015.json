{"15:1":[{"ar":"الٓر ۚ","en":"Alif Laam Ra","ur":"الر","tr":"alif-lam-ra"},{"ar":"تِلْكَ","en":"These","ur":"یہ","tr":"til'ka"},{"ar":"ءَايَـٰتُ","en":"(are) the Verses","ur":"آیات ہیں","tr":"āyātu"},{"ar":"ٱلْكِتَـٰبِ","en":"(of) the Book","ur":"کتاب کی","tr":"l-kitābi"},{"ar":"وَقُرْءَانٍۢ","en":"and Quran","ur":"اور قرآن","tr":"waqur'ānin"},{"ar":"مُّبِينٍۢ","en":"clear","ur":"روشن کی","tr":"mubīnin"}],"15:2":[{"ar":"رُّبَمَا","en":"Perhaps","ur":"بعض اوقات۔ اکثر اوقات","tr":"rubamā"},{"ar":"يَوَدُّ","en":"will wish","ur":"چاہتے ہیں۔ چاہیں گے","tr":"yawaddu"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا","tr":"kafarū"},{"ar":"لَوْ","en":"if","ur":"کاش","tr":"law"},{"ar":"كَانُوا۟","en":"they had been","ur":"کہ وہ ہوتے","tr":"kānū"},{"ar":"مُسْلِمِينَ","en":"Muslims","ur":"مسلمان","tr":"mus'limīna"}],"15:3":[{"ar":"ذَرْهُمْ","en":"Leave them","ur":"چھوڑ دو ان کو","tr":"dharhum"},{"ar":"يَأْكُلُوا۟","en":"(to) eat","ur":"کھائیں","tr":"yakulū"},{"ar":"وَيَتَمَتَّعُوا۟","en":"and enjoy","ur":"اور فائدے اٹھائیں","tr":"wayatamattaʿū"},{"ar":"وَيُلْهِهِمُ","en":"and diverted them","ur":"اور غافل بنائے ان کو","tr":"wayul'hihimu"},{"ar":"ٱلْأَمَلُ ۖ","en":"the hope","ur":"امید","tr":"l-amalu"},{"ar":"فَسَوْفَ","en":"then soon","ur":"پس عنقریب","tr":"fasawfa"},{"ar":"يَعْلَمُونَ","en":"they will come to know","ur":"وہ جان لیں گے","tr":"yaʿlamūna"}],"15:4":[{"ar":"وَمَآ","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"أَهْلَكْنَا","en":"We destroyed","ur":"ہلاک کیا ہم نے","tr":"ahlaknā"},{"ar":"مِن","en":"any","ur":"کسی","tr":"min"},{"ar":"قَرْيَةٍ","en":"town","ur":"بستی کو","tr":"qaryatin"},{"ar":"إِلَّا","en":"but","ur":"مگر","tr":"illā"},{"ar":"وَلَهَا","en":"(there was) for it","ur":"اور اس کے لیے","tr":"walahā"},{"ar":"كِتَابٌۭ","en":"a decree","ur":"نوشتہ ہے","tr":"kitābun"},{"ar":"مَّعْلُومٌۭ","en":"known","ur":"معلوم۔ مقرر","tr":"maʿlūmun"}],"15:5":[{"ar":"مَّا","en":"Not","ur":"نہیں","tr":"mā"},{"ar":"تَسْبِقُ","en":"(can) advance","ur":"آگے جاسکتی۔ سبقت کرسکتی","tr":"tasbiqu"},{"ar":"مِنْ","en":"any","ur":"کوئی","tr":"min"},{"ar":"أُمَّةٍ","en":"nation","ur":"امت۔ کوئی قوم","tr":"ummatin"},{"ar":"أَجَلَهَا","en":"its term","ur":"اپنے مقرر وقت سے","tr":"ajalahā"},{"ar":"وَمَا","en":"and not","ur":"اور نہ","tr":"wamā"},{"ar":"يَسْتَـْٔخِرُونَ","en":"(can) delay it","ur":"تاخیر کرسکتی ہے","tr":"yastakhirūna"}],"15:6":[{"ar":"وَقَالُوا۟","en":"And they say","ur":"اور انہوں نے کہا","tr":"waqālū"},{"ar":"يَـٰٓأَيُّهَا","en":"O you","ur":"اے","tr":"yāayyuhā"},{"ar":"ٱلَّذِى","en":"(to) whom","ur":"وہ شخص","tr":"alladhī"},{"ar":"نُزِّلَ","en":"has been sent down","ur":"اتارا گیا","tr":"nuzzila"},{"ar":"عَلَيْهِ","en":"[on him]","ur":"جس پر","tr":"ʿalayhi"},{"ar":"ٱلذِّكْرُ","en":"the Reminder","ur":"ذکر (یعنی قرآن)","tr":"l-dhik'ru"},{"ar":"إِنَّكَ","en":"indeed, you","ur":"یقینا تو","tr":"innaka"},{"ar":"لَمَجْنُونٌۭ","en":"(are) surely mad","ur":"البتہ مجنون ہے","tr":"lamajnūnun"}],"15:7":[{"ar":"لَّوْ","en":"Why","ur":"کیوں","tr":"law"},{"ar":"مَا","en":"not","ur":"نہیں","tr":"mā"},{"ar":"تَأْتِينَا","en":"you bring to us","ur":"لاتے تم ہمارے پاس","tr":"tatīnā"},{"ar":"بِٱلْمَلَـٰٓئِكَةِ","en":"the Angels","ur":"فرشتوں کو","tr":"bil-malāikati"},{"ar":"إِن","en":"if","ur":"اگر","tr":"in"},{"ar":"كُنتَ","en":"you are","ur":"ہے تو","tr":"kunta"},{"ar":"مِنَ","en":"of","ur":"سے","tr":"mina"},{"ar":"ٱلصَّـٰدِقِينَ","en":"the truthful","ur":"سچوں میں سے","tr":"l-ṣādiqīna"}],"15:8":[{"ar":"مَا","en":"Not","ur":"نہیں","tr":"mā"},{"ar":"نُنَزِّلُ","en":"We send down","ur":"ہم اتارا کرتے","tr":"nunazzilu"},{"ar":"ٱلْمَلَـٰٓئِكَةَ","en":"the Angels","ur":"فرشتوں کو","tr":"l-malāikata"},{"ar":"إِلَّا","en":"except","ur":"مگر","tr":"illā"},{"ar":"بِٱلْحَقِّ","en":"with the truth","ur":"حق کے ساتھ","tr":"bil-ḥaqi"},{"ar":"وَمَا","en":"and not","ur":"اور نہیں","tr":"wamā"},{"ar":"كَانُوٓا۟","en":"they would be","ur":"ہوا کرتے وہ","tr":"kānū"},{"ar":"إِذًۭا","en":"then","ur":"تب","tr":"idhan"},{"ar":"مُّنظَرِينَ","en":"given respite","ur":"مہلت دیے جانے والے","tr":"munẓarīna"}],"15:9":[{"ar":"إِنَّا","en":"Indeed, We","ur":"بیشک ہم نے","tr":"innā"},{"ar":"نَحْنُ","en":"We","ur":"ہم ہی نے","tr":"naḥnu"},{"ar":"نَزَّلْنَا","en":"have sent down","ur":"اتارا ہم نے","tr":"nazzalnā"},{"ar":"ٱلذِّكْرَ","en":"the Reminder","ur":"ذکر (قرآن)","tr":"l-dhik'ra"},{"ar":"وَإِنَّا","en":"and indeed, We","ur":"اور بیشک ہم ہی","tr":"wa-innā"},{"ar":"لَهُۥ","en":"of it","ur":"اس کے لیے","tr":"lahu"},{"ar":"لَحَـٰفِظُونَ","en":"(are) surely Guardians","ur":"البتہ حفاظت کرنے والے ہیں","tr":"laḥāfiẓūna"}],"15:10":[{"ar":"وَلَقَدْ","en":"And certainly","ur":"اور البتہ تحقیق","tr":"walaqad"},{"ar":"أَرْسَلْنَا","en":"We (had) sent","ur":"بھیجا ہم نے","tr":"arsalnā"},{"ar":"مِن","en":"before you","ur":"سے","tr":"min"},{"ar":"قَبْلِكَ","en":"before you","ur":"آپ سے پہلے (رسولوں کو)","tr":"qablika"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"شِيَعِ","en":"the sects","ur":"گروہوں میں","tr":"shiyaʿi"},{"ar":"ٱلْأَوَّلِينَ","en":"(of) the former (people)","ur":"پہلے","tr":"l-awalīna"}],"15:11":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"يَأْتِيهِم","en":"came to them","ur":"آیا ان کے پاس","tr":"yatīhim"},{"ar":"مِّن","en":"any","ur":"سے","tr":"min"},{"ar":"رَّسُولٍ","en":"Messenger","ur":"کوئی رسول","tr":"rasūlin"},{"ar":"إِلَّا","en":"but","ur":"مگر","tr":"illā"},{"ar":"كَانُوا۟","en":"they did","ur":"تھے وہ","tr":"kānū"},{"ar":"بِهِۦ","en":"at him","ur":"ساتھ اس کے","tr":"bihi"},{"ar":"يَسْتَهْزِءُونَ","en":"mock","ur":"وہ مذاق اڑاتے","tr":"yastahziūna"}],"15:12":[{"ar":"كَذَٰلِكَ","en":"Thus","ur":"اسی طرح","tr":"kadhālika"},{"ar":"نَسْلُكُهُۥ","en":"We let it enter","ur":"ہم گزارتے ہیں اس کو","tr":"naslukuhu"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"قُلُوبِ","en":"(the) hearts","ur":"دلوں میں","tr":"qulūbi"},{"ar":"ٱلْمُجْرِمِينَ","en":"(of) the criminals","ur":"مجرموں کے","tr":"l-muj'rimīna"}],"15:13":[{"ar":"لَا","en":"Not","ur":"نہیں","tr":"lā"},{"ar":"يُؤْمِنُونَ","en":"they believe","ur":"وہ ایمان لائیں گے","tr":"yu'minūna"},{"ar":"بِهِۦ ۖ","en":"in it","ur":"ساتھ اس کے","tr":"bihi"},{"ar":"وَقَدْ","en":"and verily","ur":"حالانکہ تحقیق","tr":"waqad"},{"ar":"خَلَتْ","en":"have passed","ur":"گزر چکا","tr":"khalat"},{"ar":"سُنَّةُ","en":"the way(s)","ur":"طریقہ","tr":"sunnatu"},{"ar":"ٱلْأَوَّلِينَ","en":"(of) the former (people)","ur":"پہلوں کا","tr":"l-awalīna"}],"15:14":[{"ar":"وَلَوْ","en":"And (even) if","ur":"اور اگر","tr":"walaw"},{"ar":"فَتَحْنَا","en":"We opened","ur":"کھول دیں ہم","tr":"fataḥnā"},{"ar":"عَلَيْهِم","en":"to them","ur":"ان پر","tr":"ʿalayhim"},{"ar":"بَابًۭا","en":"a gate","ur":"ایک دروازہ","tr":"bāban"},{"ar":"مِّنَ","en":"from","ur":"سے","tr":"mina"},{"ar":"ٱلسَّمَآءِ","en":"the heaven","ur":"آسمان","tr":"l-samāi"},{"ar":"فَظَلُّوا۟","en":"and they were to continue","ur":"تو وہ لگتے۔ شروع ہوتے","tr":"faẓallū"},{"ar":"فِيهِ","en":"therein","ur":"اس میں","tr":"fīhi"},{"ar":"يَعْرُجُونَ","en":"(to) ascend","ur":"چڑھنے لگتے۔ چڑھ جاتے","tr":"yaʿrujūna"}],"15:15":[{"ar":"لَقَالُوٓا۟","en":"They would surely say","ur":"البتہ وہ کہیں گے","tr":"laqālū"},{"ar":"إِنَّمَا","en":"Only","ur":"بیشک","tr":"innamā"},{"ar":"سُكِّرَتْ","en":"have been dazzled","ur":"سست ہوگئیں ہیں۔ مدہوش کردی گئیں ہیں","tr":"sukkirat"},{"ar":"أَبْصَـٰرُنَا","en":"our eyes","ur":"ہماری نگاہیں","tr":"abṣārunā"},{"ar":"بَلْ","en":"Nay","ur":"بلکہ","tr":"bal"},{"ar":"نَحْنُ","en":"we","ur":"ہم","tr":"naḥnu"},{"ar":"قَوْمٌۭ","en":"(are) a people","ur":"ایک قوم ہیں","tr":"qawmun"},{"ar":"مَّسْحُورُونَ","en":"bewitched","ur":"سحر زدہ۔ جادو کیے گئے","tr":"masḥūrūna"}],"15:16":[{"ar":"وَلَقَدْ","en":"And verily","ur":"اور البتہ تحقیق","tr":"walaqad"},{"ar":"جَعَلْنَا","en":"We have placed","ur":"بنائے ہم نے","tr":"jaʿalnā"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"ٱلسَّمَآءِ","en":"the heavens","ur":"آسمان","tr":"l-samāi"},{"ar":"بُرُوجًۭا","en":"constellations","ur":"م
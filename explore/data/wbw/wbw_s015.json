ied","ur":"جھٹلایا","tr":"kadhaba"},{"ar":"أَصْحَـٰبُ","en":"(the) companions","ur":"والوں نے","tr":"aṣḥābu"},{"ar":"ٱلْحِجْرِ","en":"(of) the Rocky Tract","ur":"حجر (والوں نے)","tr":"l-ḥij'ri"},{"ar":"ٱلْمُرْسَلِينَ","en":"the Messengers","ur":"رسولوں کو","tr":"l-mur'salīna"}],"15:81":[{"ar":"وَءَاتَيْنَـٰهُمْ","en":"And We gave them","ur":"اور دیں ہم نے ان کو","tr":"waātaynāhum"},{"ar":"ءَايَـٰتِنَا","en":"Our Signs","ur":"اپنی نشانیاں","tr":"āyātinā"},{"ar":"فَكَانُوا۟","en":"but they were","ur":"تو تھے وہ","tr":"fakānū"},{"ar":"عَنْهَا","en":"from them","ur":"ان سے","tr":"ʿanhā"},{"ar":"مُعْرِضِينَ","en":"turning away","ur":"اعراض برتنے والے","tr":"muʿ'riḍīna"}],"15:82":[{"ar":"وَكَانُوا۟","en":"And they used (to)","ur":"اور وہ تھے","tr":"wakānū"},{"ar":"يَنْحِتُونَ","en":"carve","ur":"تراش لیتے","tr":"yanḥitūna"},{"ar":"مِنَ","en":"from","ur":"سے","tr":"mina"},{"ar":"ٱلْجِبَالِ","en":"the mountains","ur":"پہاڑوں میں (سے)","tr":"l-jibāli"},{"ar":"بُيُوتًا","en":"houses","ur":"گھروں کو","tr":"buyūtan"},{"ar":"ءَامِنِينَ","en":"secure","ur":"امن سے رہنے والے","tr":"āminīna"}],"15:83":[{"ar":"فَأَخَذَتْهُمُ","en":"But seized them","ur":"تو پکڑ لیا ان کو","tr":"fa-akhadhathumu"},{"ar":"ٱلصَّيْحَةُ","en":"the awful cry","ur":"چیخ نے","tr":"l-ṣayḥatu"},{"ar":"مُصْبِحِينَ","en":"(at) early morning","ur":"صبح ہوتے ہی","tr":"muṣ'biḥīna"}],"15:84":[{"ar":"فَمَآ","en":"And not","ur":"تو نہ","tr":"famā"},{"ar":"أَغْنَىٰ","en":"availed","ur":"کام آئے","tr":"aghnā"},{"ar":"عَنْهُم","en":"them","ur":"ان کو","tr":"ʿanhum"},{"ar":"مَّا","en":"what","ur":"جو","tr":"mā"},{"ar":"كَانُوا۟","en":"they used (to)","ur":"تھے","tr":"kānū"},{"ar":"يَكْسِبُونَ","en":"earn","ur":"وہ  کچھ وہ کمائی کرتے","tr":"yaksibūna"}],"15:85":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"خَلَقْنَا","en":"We created","ur":"پیدا کیا ہم نے","tr":"khalaqnā"},{"ar":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں کو","tr":"l-samāwāti"},{"ar":"وَٱلْأَرْضَ","en":"and the earth","ur":"اور ز
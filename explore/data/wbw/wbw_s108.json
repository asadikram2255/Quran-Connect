{"108:1":[{"ar":"إِنَّآ","en":"Indeed, We","ur":"بیشک ہم نے","tr":"innā"},{"ar":"أَعْطَيْنَـٰكَ","en":"We have given you","ur":"عطا کی ہم نے آپ کو","tr":"aʿṭaynāka"},{"ar":"ٱلْكَوْثَرَ","en":"Al-Kauthar","ur":"خیر کثیر","tr":"l-kawthara"}],"108:2":[{"ar":"فَصَلِّ","en":"So pray","ur":"پس نماز پڑھو","tr":"faṣalli"},{"ar":"لِرَبِّكَ","en":"to your Lord","ur":"اپنے رب کے لئے","tr":"lirabbika"},{"ar":"وَٱنْحَرْ","en":"and sacrifice","ur":"اور قربانی کرو","tr":"wa-in'ḥar"}],"108:3":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"شَانِئَكَ","en":"your enemy","ur":"دشمن تیرا","tr":"shāni-aka"},{"ar":"هُوَ","en":"he (is)","ur":"وہی","tr":"huwa"},{"ar":"ٱلْأَبْتَرُ","en":"the one cut off","ur":"جڑ کٹا ہے","tr":"l-abtaru"}]}
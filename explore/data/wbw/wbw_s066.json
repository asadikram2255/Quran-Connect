","ur":"طرف","tr":"ilā"},{"ar":"بَعْضِ","en":"one","ur":"اپنی بعض","tr":"baʿḍi"},{"ar":"أَزْوَٰجِهِۦ","en":"(of) his wives","ur":"بیویوں کے","tr":"azwājihi"},{"ar":"حَدِيثًۭا","en":"a statement","ur":"ایک بات کو","tr":"ḥadīthan"},{"ar":"فَلَمَّا","en":"and when","ur":"تو جب","tr":"falammā"},{"ar":"نَبَّأَتْ","en":"she informed","ur":"اس نے خبر دی","tr":"nabba-at"},{"ar":"بِهِۦ","en":"about it","ur":"اس کی","tr":"bihi"},{"ar":"وَأَظْهَرَهُ","en":"and made it apparent","ur":"اور ظاہر کردیا اس کو","tr":"wa-aẓharahu"},{"ar":"ٱللَّهُ","en":"Allah","ur":"اللہ نے","tr":"l-lahu"},{"ar":"عَلَيْهِ","en":"to him","ur":"اس پر","tr":"ʿalayhi"},{"ar":"عَرَّفَ","en":"he made known","ur":"اس نے بتادیا۔ جتلا دیا","tr":"ʿarrafa"},{"ar":"بَعْضَهُۥ","en":"a part of it","ur":"اس کا بعض حصہ","tr":"baʿḍahu"},{"ar":"وَأَعْرَضَ","en":"and avoided","ur":"اور اعراض برتا","tr":"wa-aʿraḍa"},{"ar":"عَنۢ","en":"[of]","ur":"سے","tr":"ʿan"},{"ar":"بَعْضٍۢ ۖ","en":"a part","ur":"بعض (سے)","tr":"baʿḍin"},{"ar":"فَلَمَّا","en":"Then when","ur":"تو جب","tr":"falammā"},{"ar":"نَبَّأَهَا","en":"he informed her","ur":"آپ نے خبر دی اس (بیوی) کو","tr":"nabba-ahā"},{"ar":"بِهِۦ","en":"about it","ur":"ساتھ اس بات کے","tr":"bihi"},{"ar":"قَالَتْ","en":"she said","ur":"بولی آپ کو","tr":"qālat"},{"ar":"مَنْ","en":"Who","ur":"کس نے","tr":"man"},{"ar":"أَنۢبَأَكَ","en":"informed you","ur":"بتایا ہے۔ آپ کو کس نے خبر دی ہے","tr":"anba-aka"},{"ar":"هَـٰذَا ۖ","en":"this","ur":"اس کی","tr":"hādhā"},{"ar":"قَالَ","en":"He said","ur":"فرمایا","tr":"qāla"},{"ar":"نَبَّأَنِىَ","en":"Has informed me","ur":"خبر دی مجھ کو","tr":"nabba-aniya"},{"ar":"ٱلْعَلِيمُ","en":"the All-Knower","ur":"علم والے","tr":"l-ʿalīmu"},{"ar":"ٱلْخَبِيرُ","en":"the All-Aware","ur":"خبر والے نے","tr":"l-khabīru"}],"66:4":[{"ar":"إِن","en":"If","ur":"اگر","tr":"in"},{"ar":"تَتُوبَآ","en":"you both turn","ur":"تم دونوں توبہ کرتی ہو","tr":"tatūbā"},{"ar":"إِلَى","en":"to","ur":"طرف","tr":"ilā"},{"ar":"ٱللَّهِ","en":"Allah","ur":"اللہ کی","tr":"l-lah
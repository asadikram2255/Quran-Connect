{"109:1":[{"ar":"قُلْ","en":"Say","ur":"کہہ دیجئے","tr":"qul"},{"ar":"يَـٰٓأَيُّهَا","en":"O","ur":"اے","tr":"yāayyuhā"},{"ar":"ٱلْكَـٰفِرُونَ","en":"disbelievers","ur":"کافرو","tr":"l-kāfirūna"}],"109:2":[{"ar":"لَآ","en":"Not","ur":"نہیں","tr":"lā"},{"ar":"أَعْبُدُ","en":"I worship","ur":"میں عبادت کرتا","tr":"aʿbudu"},{"ar":"مَا","en":"what","ur":"جس کی","tr":"mā"},{"ar":"تَعْبُدُونَ","en":"you worship","ur":"تم عبادت کرتے ہو","tr":"taʿbudūna"}],"109:3":[{"ar":"وَلَآ","en":"And not","ur":"اور نہ","tr":"walā"},{"ar":"أَنتُمْ","en":"you","ur":"تم","tr":"antum"},{"ar":"عَـٰبِدُونَ","en":"(are) worshippers","ur":"عبادت کرنے والے ہو","tr":"ʿābidūna"},{"ar":"مَآ","en":"(of) what","ur":"جس کی","tr":"mā"},{"ar":"أَعْبُدُ","en":"I worship","ur":"میں عبادت کرتا ہوں","tr":"aʿbudu"}],"109:4":[{"ar":"وَلَآ","en":"And not","ur":"اور نہ","tr":"walā"},{"ar":"أَنَا۠","en":"I am","ur":"میں","tr":"anā"},{"ar":"عَابِدٌۭ","en":"a worshipper","ur":"عبادت کرنے والا ہوں","tr":"ʿābidun"},{"ar":"مَّا","en":"(of) what","ur":"جس کی","tr":"mā"},{"ar":"عَبَدتُّمْ","en":"you worship","ur":"تم نے عبادت کی","tr":"ʿabadttum"}],"109:5":[{"ar":"وَلَآ","en":"And not","ur":"اور نہ","tr":"walā"},{"ar":"أَنتُمْ","en":"you","ur":"تم","tr":"antum"},{"ar":"عَـٰبِدُونَ","en":"(are) worshippers","ur":"عبادت کرنے والے ہو","tr":"ʿābidūna"},{"ar":"مَآ","en":"(of) what","ur":"جس کی","tr":"mā"},{"ar":"أَعْبُدُ","en":"I worship","ur":"میں عبادت کرتا ہوں","tr":"aʿbudu"}],"109:6":[{"ar":"لَكُمْ","en":"For you","ur":"تمہارے لئے","tr":"lakum"},{"ar":"دِينُكُمْ","en":"(is) your religion","ur":"تمہارا دین ہے","tr":"dīnukum"},{"ar":"وَلِىَ","en":"and for me","ur":"اور میرے لئے","tr":"waliya"},{"ar":"دِينِ","en":"(is) my religion","ur":"میرا دین ہے","tr":"dīni"}]}
","tr":"min"},{"ar":"قَبْلُ","en":"before","ur":"اس سے پہلے","tr":"qablu"},{"ar":"فَذَاقُوا۟","en":"So they tasted","ur":"تو انہوں نے چکھا","tr":"fadhāqū"},{"ar":"وَبَالَ","en":"(the bad) consequence","ur":"وبال","tr":"wabāla"},{"ar":"أَمْرِهِمْ","en":"(of) their affair","ur":"اپنے کام کا","tr":"amrihim"},{"ar":"وَلَهُمْ","en":"and for them","ur":"اور ان کے لیے","tr":"walahum"},{"ar":"عَذَابٌ","en":"(is) a punishment","ur":"عذاب","tr":"ʿadhābun"},{"ar":"أَلِيمٌۭ","en":"painful","ur":"دردناک","tr":"alīmun"}],"64:6":[{"ar":"ذَٰلِكَ","en":"That","ur":"یہ","tr":"dhālika"},{"ar":"بِأَنَّهُۥ","en":"(is) because","ur":"بوجہ اس کے کہ بیشک وہ","tr":"bi-annahu"},{"ar":"كَانَت","en":"had","ur":"تھے","tr":"kānat"},{"ar":"تَّأْتِيهِمْ","en":"come to them","ur":"آتے ان کے پاس","tr":"tatīhim"},{"ar":"رُسُلُهُم","en":"their Messengers","ur":"ان کے رسول","tr":"rusuluhum"},{"ar":"بِٱلْبَيِّنَـٰتِ","en":"with clear proofs","ur":"ساتھ واضح آیات کے","tr":"bil-bayināti"},{"ar":"فَقَالُوٓا۟","en":"but they said","ur":"تو وہ کہتے","tr":"faqālū"},{"ar":"أَبَشَرٌۭ","en":"Shall human beings","ur":"کیا انسان","tr":"abasharun"},{"ar":"يَهْدُونَنَا","en":"guide us","ur":"ہدایت دیں گے ہم کو","tr":"yahdūnanā"},{"ar":"فَكَفَرُوا۟","en":"So they disbelieved","ur":"تو انہوں نے کفر کیا","tr":"fakafarū"},{"ar":"وَتَوَلَّوا۟ ۚ","en":"and turned away","ur":"اورمنہ موڑ گئے","tr":"watawallaw"},{"ar":"وَّٱسْتَغْنَى","en":"And can do without them","ur":"اور بےپرواہ ہوگیا","tr":"wa-is'taghnā"},{"ar":"ٱللَّهُ ۚ","en":"Allah","ur":"اللہ","tr":"l-lahu"},{"ar":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ","tr":"wal-lahu"},{"ar":"غَنِىٌّ","en":"(is) Self-sufficient","ur":"بےنیاز ہے","tr":"ghaniyyun"},{"ar":"حَمِيدٌۭ","en":"Praiseworthy","ur":"تعریف والا ہے","tr":"ḥamīdun"}],"64:7":[{"ar":"زَعَمَ","en":"Claim","ur":"دعوی کیا","tr":"zaʿama"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں نے","tr":"alladhīna"},{"ar":"كَفَرُوٓا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا","tr":"kafarū"},{"ar":"أَن","en":"that","ur":"
{"99:1":[{"ar":"إِذَا","en":"When","ur":"جب","tr":"idhā"},{"ar":"زُلْزِلَتِ","en":"is shaken","ur":"ہلا ماری جائے گی","tr":"zul'zilati"},{"ar":"ٱلْأَرْضُ","en":"the earth","ur":"زمین","tr":"l-arḍu"},{"ar":"زِلْزَالَهَا","en":"(with) its earthquake","ur":"ہلا دیا جانا اس کا","tr":"zil'zālahā"}],"99:2":[{"ar":"وَأَخْرَجَتِ","en":"And brings forth","ur":"اور نکالے گی","tr":"wa-akhrajati"},{"ar":"ٱلْأَرْضُ","en":"the earth","ur":"زمین","tr":"l-arḍu"},{"ar":"أَثْقَالَهَا","en":"its burdens","ur":"بوجھ اپنے","tr":"athqālahā"}],"99:3":[{"ar":"وَقَالَ","en":"And says","ur":"اور کہے گا","tr":"waqāla"},{"ar":"ٱلْإِنسَـٰنُ","en":"man","ur":"انسان","tr":"l-insānu"},{"ar":"مَا","en":"What","ur":"کیا ہے","tr":"mā"},{"ar":"لَهَا","en":"(is) with it","ur":"اس کو","tr":"lahā"}],"99:4":[{"ar":"يَوْمَئِذٍۢ","en":"That Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"تُحَدِّثُ","en":"it will report","ur":"وہ بیان کرے گی","tr":"tuḥaddithu"},{"ar":"أَخْبَارَهَا","en":"its news","ur":"اپنی خبریں","tr":"akhbārahā"}],"99:5":[{"ar":"بِأَنَّ","en":"Because","ur":"کیونکہ","tr":"bi-anna"},{"ar":"رَبَّكَ","en":"your Lord","ur":"تیرے رب نے","tr":"rabbaka"},{"ar":"أَوْحَىٰ","en":"inspired","ur":"وحی کی","tr":"awḥā"},{"ar":"لَهَا","en":"[to] it","ur":"اس کے لئے","tr":"lahā"}],"99:6":[{"ar":"يَوْمَئِذٍۢ","en":"That Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"يَصْدُرُ","en":"will proceed","ur":"نکلیں گے/ پلٹیں گے","tr":"yaṣduru"},{"ar":"ٱلنَّاسُ","en":"the mankind","ur":"لوگ","tr":"l-nāsu"},{"ar":"أَشْتَاتًۭا","en":"(in) scattered groups","ur":"مختلف حالت میں","tr":"ashtātan"},{"ar":"لِّيُرَوْا۟","en":"to be shown","ur":"تاکہ وہ دکھائے جائیں","tr":"liyuraw"},{"ar":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"اپنے اعمال","tr":"aʿmālahum"}],"99:7":[{"ar":"فَمَن","en":"So whoever","ur":"تو جو کوئی","tr":"faman"},{"ar":"يَعْمَلْ","en":"does","ur":"عمل کرے","tr":"yaʿmal"},{"ar":"مِثْقَالَ","en":"(equal to the) weight","ur":"برابر","tr":"mith'qāla"},{"ar":"ذَرَّةٍ","en":"(of) an atom","ur":"ذرے کے","tr":"dharratin"},{"ar":"خَيْرًۭا","en":"good","ur":"بھلائی کا","tr":"khayran"},{"ar":"يَرَهُۥ","en":"will see it","ur":"وہ دیکھ لے گا اس کو","tr":"yarahu"}],"99:8":[{"ar":"وَمَن","en":"And whoever","ur":"اور جو کوئی","tr":"waman"},{"ar":"يَعْمَلْ","en":"does","ur":"عمل کرے گا","tr":"yaʿmal"},{"ar":"مِثْقَالَ","en":"(equal to the) weight","ur":"برابر","tr":"mith'qāla"},{"ar":"ذَرَّةٍۢ","en":"(of) an atom","ur":"ذرے کے","tr":"dharratin"},{"ar":"شَرًّۭا","en":"evil","ur":"برائی کا","tr":"sharran"},{"ar":"يَرَهُۥ","en":"will see it","ur":"وہ دیکھ لے گا اس کو","tr":"yarahu"}]}
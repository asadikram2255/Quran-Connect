َّا","en":"Indeed, We","ur":"بیشک ہم","tr":"innā"},{"ar":"لَمَّا","en":"when","ur":"جب","tr":"lammā"},{"ar":"طَغَا","en":"overflowed","ur":"بلندی میں تجاوز کرگیا","tr":"ṭaghā"},{"ar":"ٱلْمَآءُ","en":"the water","ur":"پانی","tr":"l-māu"},{"ar":"حَمَلْنَـٰكُمْ","en":"We carried you","ur":"سوار کیا ہم نے تم کو","tr":"ḥamalnākum"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"ٱلْجَارِيَةِ","en":"the sailing (ship)","ur":"کشتی","tr":"l-jāriyati"}],"69:12":[{"ar":"لِنَجْعَلَهَا","en":"That We might make it","ur":"تاکہ ہم بنادیں اس کو","tr":"linajʿalahā"},{"ar":"لَكُمْ","en":"for you","ur":"تمہارے لیے","tr":"lakum"},{"ar":"تَذْكِرَةًۭ","en":"a reminder","ur":"یاد دہانی","tr":"tadhkiratan"},{"ar":"وَتَعِيَهَآ","en":"and would be conscious of it","ur":"اور یاد رکھیں اس کو","tr":"wataʿiyahā"},{"ar":"أُذُنٌۭ","en":"an ear","ur":"کان","tr":"udhunun"},{"ar":"وَٰعِيَةٌۭ","en":"conscious","ur":"یاد رکھنے والے","tr":"wāʿiyatun"}],"69:13":[{"ar":"فَإِذَا","en":"Then when","ur":"پھر جب","tr":"fa-idhā"},{"ar":"نُفِخَ","en":"is blown","ur":"پھونک دیا جائے گا","tr":"nufikha"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"ٱلصُّورِ","en":"the trumpet","ur":"صور","tr":"l-ṣūri"},{"ar":"نَفْخَةٌۭ","en":"a blast","ur":"پھونکنا","tr":"nafkhatun"},{"ar":"وَٰحِدَةٌۭ","en":"single","ur":"ایک ہی بار","tr":"wāḥidatun"}],"69:14":[{"ar":"وَحُمِلَتِ","en":"And are lifted","ur":"اور اٹھائی جائے گی","tr":"waḥumilati"},{"ar":"ٱلْأَرْضُ","en":"the earth","ur":"زمین","tr":"l-arḍu"},{"ar":"وَٱلْجِبَالُ","en":"and the mountains","ur":"اور پہاڑ","tr":"wal-jibālu"},{"ar":"فَدُكَّتَا","en":"and crushed","ur":"تو دونوں توڑ دئیے جائیں گے","tr":"fadukkatā"},{"ar":"دَكَّةًۭ","en":"(with) a crushing","ur":"توڑنا","tr":"dakkatan"},{"ar":"وَٰحِدَةًۭ","en":"single","ur":"یکبارگی","tr":"wāḥidatan"}],"69:15":[{"ar":"فَيَوْمَئِذٍۢ","en":"Then (on) that Day","ur":"تو اس دن","tr":"fayawma-idhin"},{"ar":"وَقَعَتِ","en":"will occur","ur":"واقع ہوجائے گی","tr":"waqaʿati"},{"ar":"ٱلْوَاقِعَةُ","en":"the Occurrence","ur":"واقع ہونے والی","tr":"l-wāqiʿatu"}],"69:16":[{"ar":"وَٱنشَقَّتِ","en":"And will split","ur":"اور پھٹ جائے گا","tr":"wa-inshaqqati"},{"ar":"ٱلسَّمَآءُ","en":"the heaven","ur":"آسمان","tr":"l-samāu"},{"ar":"فَهِىَ","en":"so it","ur":"تو وہ","tr":"fahiya"},{"ar":"يَوْمَئِذٍۢ","en":"(is on) that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"وَاهِيَةٌۭ","en":"frail","ur":"سست ہوگا ۔ کمزور ہوگا","tr":"wāhiyatun"}],"69:17":[{"ar":"وَٱلْمَلَكُ","en":"And the Angels","ur":"اور فرشتے","tr":"wal-malaku"},{"ar":"عَلَىٰٓ","en":"(will be) on","ur":"ہوں گےپر","tr":"ʿalā"},{"ar":"أَرْجَآئِهَا ۚ","en":"its edges","ur":"اس کے کناروں","tr":"arjāihā"},{"ar":"وَيَحْمِلُ","en":"and will bear","ur":"اور اٹھائے ہوئے ہوں گے","tr":"wayaḥmilu"},{"ar":"عَرْشَ","en":"(the) Throne","ur":"عرش","tr":"ʿarsha"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"تیرے رب کا","tr":"rabbika"},{"ar":"فَوْقَهُمْ","en":"above them","ur":"اپنے اوپر","tr":"fawqahum"},{"ar":"يَوْمَئِذٍۢ","en":"that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"ثَمَـٰنِيَةٌۭ","en":"eight","ur":"آٹھ (فرشتے)","tr":"thamāniyatun"}],"69:18":[{"ar":"يَوْمَئِذٍۢ","en":"That Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"تُعْرَضُونَ","en":"you will be exhibited","ur":"تم پیش کیے جاؤ گے","tr":"tuʿ'raḍūna"},{"ar":"لَا","en":"not","ur":"نہ","tr":"lā"},{"ar":"تَخْفَىٰ","en":"will be hidden","ur":"چھپ سکے گی","tr":"takhfā"},{"ar":"مِنكُمْ","en":"among you","ur":"تم سے","tr":"minkum"},{"ar":"خَافِيَةٌۭ","en":"any secret","ur":"چھپنے والی۔ کوئی راز","tr":"khāfiyatun"}],"69:19":[{"ar":"فَأَمَّا","en":"Then as for","ur":"تو رہا","tr":"fa-ammā"},{"ar":"مَنْ","en":"(him) who","ur":"وہ جو","tr":"man"},{"ar":"أُوتِىَ","en":"is given","ur":"دیا گیا","tr":"ūtiya"},{"ar":"كِتَـٰبَهُۥ","en":"his record","ur":"کتاب اپنی۔ نامہ اعمال","tr":"kitābahu"},{"ar":"بِيَمِينِهِۦ","en":"in his right hand","ur":"اپنے دائیں ہاتھ میں","tr":"biyamīnihi"},{"ar":"فَيَقُولُ","en":"will say","ur":"تو وہ کہے گا","tr":"fayaqūlu"},{"ar":"هَآؤُمُ","en":"Here","ur":"لو","tr":"
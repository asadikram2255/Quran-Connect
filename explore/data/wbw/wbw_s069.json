{"69:1":[{"ar":"ٱلْحَآقَّةُ","en":"The Inevitable Reality","ur":"حق ہونے والی۔ ثابت ہونے والی","tr":"al-ḥāqatu"}],"69:2":[{"ar":"مَا","en":"What","ur":"کیا ہے","tr":"mā"},{"ar":"ٱلْحَآقَّةُ","en":"(is) the Inevitable Reality","ur":"وہ ثابت ہوکررہنے والی","tr":"l-ḥāqatu"}],"69:3":[{"ar":"وَمَآ","en":"And what","ur":"اور کیا","tr":"wamā"},{"ar":"أَدْرَىٰكَ","en":"will make you know","ur":"چیز بتائے تجھ کو","tr":"adrāka"},{"ar":"مَا","en":"what","ur":"کیا ہے","tr":"mā"},{"ar":"ٱلْحَآقَّةُ","en":"(is) the Inevitable Reality","ur":"وہ ثابت ہوکررہنے والی","tr":"l-ḥāqatu"}],"69:4":[{"ar":"كَذَّبَتْ","en":"Denied","ur":"جھٹلایا","tr":"kadhabat"},{"ar":"ثَمُودُ","en":"Thamud","ur":"ثمود نے","tr":"thamūdu"},{"ar":"وَعَادٌۢ","en":"and Aad","ur":"اور عاد نے","tr":"waʿādun"},{"ar":"بِٱلْقَارِعَةِ","en":"the Striking Calamity","ur":"کھڑکا دینے والی کو","tr":"bil-qāriʿati"}],"69:5":[{"ar":"فَأَمَّا","en":"So as for","ur":"تو رہے","tr":"fa-ammā"},{"ar":"ثَمُودُ","en":"Thamud","ur":"ثمود","tr":"thamūdu"},{"ar":"فَأُهْلِكُوا۟","en":"they were destroyed","ur":"پس وہ ہلاک کہے گئے","tr":"fa-uh'likū"},{"ar":"بِٱلطَّاغِيَةِ","en":"by the overpowering (blast)","ur":"اونچی آواز سے","tr":"bil-ṭāghiyati"}],"69:6":[{"ar":"وَأَمَّا","en":"And as for","ur":"اور رہے","tr":"wa-ammā"},{"ar":"عَادٌۭ","en":"Aad","ur":"عاد","tr":"ʿādun"},{"ar":"فَأُهْلِكُوا۟","en":"they were destroyed","ur":"پس وہ ہلاک کیے گئے","tr":"fa-uh'likū"},{"ar":"بِرِيحٍۢ","en":"by a wind","ur":"ساتھ ایک ہوا کے","tr":"birīḥin"},{"ar":"صَرْصَرٍ","en":"screaming","ur":"پالے والی۔ تند","tr":"ṣarṣarin"},{"ar":"عَاتِيَةٍۢ","en":"violent","ur":"سرکش ۔ حد سے نکلنے والی","tr":"ʿātiyatin"}],"69:7":[{"ar":"سَخَّرَهَا","en":"Which He imposed","ur":"مسلط کردیا اس کو","tr":"sakharahā"},{"ar":"عَلَيْهِمْ","en":"upon them","ur":"ان پر","tr":"ʿalayhim"},{"ar":"سَبْعَ","en":"(for) seven","ur":"ساتھ","tr":"sabʿa"},{"ar":"لَيَالٍۢ","en":"nights","ur":"راتوں تک","tr":"layālin"},{"ar":"وَثَمَـٰنِيَةَ","en":"and eight","ur":"اور آٹھ","tr":"watha
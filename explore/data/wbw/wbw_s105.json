{"105:1":[{"ar":"أَلَمْ","en":"Have not","ur":"کیا نہیں","tr":"alam"},{"ar":"تَرَ","en":"you seen","ur":"تم نے دیکھا","tr":"tara"},{"ar":"كَيْفَ","en":"how","ur":"کس طرح","tr":"kayfa"},{"ar":"فَعَلَ","en":"dealt","ur":"کیا","tr":"faʿala"},{"ar":"رَبُّكَ","en":"your Lord","ur":"تیرے رب نے","tr":"rabbuka"},{"ar":"بِأَصْحَـٰبِ","en":"with (the) Companions","ur":"والوں کے ساتھ","tr":"bi-aṣḥābi"},{"ar":"ٱلْفِيلِ","en":"(of the) Elephant","ur":"ہاتھی (والوں کےساتھ)","tr":"l-fīli"}],"105:2":[{"ar":"أَلَمْ","en":"Did not","ur":"کیا نہیں","tr":"alam"},{"ar":"يَجْعَلْ","en":"He make","ur":"کردیا","tr":"yajʿal"},{"ar":"كَيْدَهُمْ","en":"their plan","ur":"ان کی چال کو","tr":"kaydahum"},{"ar":"فِى","en":"go","ur":"میں","tr":"fī"},{"ar":"تَضْلِيلٍۢ","en":"astray","ur":"گمراہی میں (اکارت)","tr":"taḍlīlin"}],"105:3":[{"ar":"وَأَرْسَلَ","en":"And He sent","ur":"اور بھیجے","tr":"wa-arsala"},{"ar":"عَلَيْهِمْ","en":"against them","ur":"ان پر","tr":"ʿalayhim"},{"ar":"طَيْرًا","en":"birds","ur":"پرندے","tr":"ṭayran"},{"ar":"أَبَابِيلَ","en":"(in) flocks","ur":"جھنڈ کے جھنڈ","tr":"abābīla"}],"105:4":[{"ar":"تَرْمِيهِم","en":"Striking them","ur":"پھینکتے تھے ان پر","tr":"tarmīhim"},{"ar":"بِحِجَارَةٍۢ","en":"with stones","ur":"پتھر","tr":"biḥijāratin"},{"ar":"مِّن","en":"of","ur":"کے","tr":"min"},{"ar":"سِجِّيلٍۢ","en":"baked clay","ur":"کنکر کی قسم کے","tr":"sijjīlin"}],"105:5":[{"ar":"فَجَعَلَهُمْ","en":"Then He made them","ur":"تو کردیا ان کو","tr":"fajaʿalahum"},{"ar":"كَعَصْفٍۢ","en":"like straw","ur":"بھوسے کی طرح","tr":"kaʿaṣfin"},{"ar":"مَّأْكُولٍۭ","en":"eaten up","ur":"جو کھایا ہوا ہو","tr":"makūlin"}]}
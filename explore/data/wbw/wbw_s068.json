:"زَنِيمٍ","en":"utterly useless","ur":"بداصل بھی ہے","tr":"zanīmin"}],"68:14":[{"ar":"أَن","en":"Because","ur":"کہ ہے","tr":"an"},{"ar":"كَانَ","en":"(he) is","ur":"وہ","tr":"kāna"},{"ar":"ذَا","en":"a possessor","ur":"والا","tr":"dhā"},{"ar":"مَالٍۢ","en":"(of) wealth","ur":"مال","tr":"mālin"},{"ar":"وَبَنِينَ","en":"and children","ur":"اور  بیٹوں والا","tr":"wabanīna"}],"68:15":[{"ar":"إِذَا","en":"When","ur":"جب","tr":"idhā"},{"ar":"تُتْلَىٰ","en":"are recited","ur":"پڑھی جاتی ہیں","tr":"tut'lā"},{"ar":"عَلَيْهِ","en":"to him","ur":"اس پر","tr":"ʿalayhi"},{"ar":"ءَايَـٰتُنَا","en":"Our Verses","ur":"ہماری آیات","tr":"āyātunā"},{"ar":"قَالَ","en":"he says","ur":"کہتا ہے","tr":"qāla"},{"ar":"أَسَـٰطِيرُ","en":"Stories","ur":"کہانیاں ہیں","tr":"asāṭīru"},{"ar":"ٱلْأَوَّلِينَ","en":"(of) the former (people)","ur":"پہلوں کی","tr":"l-awalīna"}],"68:16":[{"ar":"سَنَسِمُهُۥ","en":"We will brand him","ur":"عنقریب ہم داغ دیں گے اس کو۔ داغ لگائیں گے اس کو","tr":"sanasimuhu"},{"ar":"عَلَى","en":"on","ur":"اوپر","tr":"ʿalā"},{"ar":"ٱلْخُرْطُومِ","en":"the snout","ur":"ناک کے","tr":"l-khur'ṭūmi"}],"68:17":[{"ar":"إِنَّا","en":"Indeed, We","ur":"بیشک ہم نے","tr":"innā"},{"ar":"بَلَوْنَـٰهُمْ","en":"have tried them","ur":"آزمائش میں ڈالا ہم نے ان کو","tr":"balawnāhum"},{"ar":"كَمَا","en":"as","ur":"جیسا کہ","tr":"kamā"},{"ar":"بَلَوْنَآ","en":"We tried","ur":"آزمایا ہم نے","tr":"balawnā"},{"ar":"أَصْحَـٰبَ","en":"(the) companions","ur":"والوں کو","tr":"aṣḥāba"},{"ar":"ٱلْجَنَّةِ","en":"(of) the garden","ur":"باغ","tr":"l-janati"},{"ar":"إِذْ","en":"when","ur":"جب","tr":"idh"},{"ar":"أَقْسَمُوا۟","en":"they swore","ur":"انہوں نے قسم کھائی","tr":"aqsamū"},{"ar":"لَيَصْرِمُنَّهَا","en":"to pluck its fruit","ur":"البتہ ضرور کاٹ لیں گے اس کو","tr":"layaṣrimunnahā"},{"ar":"مُصْبِحِينَ","en":"(in the) morning","ur":"صبح سویرے","tr":"muṣ'biḥīna"}],"68:18":[{"ar":"وَلَا","en":"And not","ur":"اور نہ","tr":"walā"},{"ar":"يَسْتَثْنُونَ","en":"making exception","ur":"وہ استثناء کررہے تھے","tr":"yastathnūna"}],"68:19":[{"ar":"فَطَافَ","en":"So there came","ur":"تو پھر گیا","tr":"faṭāfa"},{"ar":"عَلَيْهَا","en":"upon it","ur":"اس پر","tr":"ʿalayhā"},{"ar":"طَآئِفٌۭ","en":"a visitation","ur":"ایک پھرنے والا","tr":"ṭāifun"},{"ar":"مِّن","en":"from","ur":"طرف سے","tr":"min"},{"ar":"رَّبِّكَ","en":"your Lord","ur":"تیرے رب کی","tr":"rabbika"},{"ar":"وَهُمْ","en":"while they","ur":"اور وہ","tr":"wahum"},{"ar":"نَآئِمُونَ","en":"were asleep","ur":"سو رہے تھے","tr":"nāimūna"}],"68:20":[{"ar":"فَأَصْبَحَتْ","en":"So it became","ur":"تو ہوگیا وہ باغ","tr":"fa-aṣbaḥat"},{"ar":"كَٱلصَّرِيمِ","en":"as if reaped","ur":"جڑکٹا۔ مانند جڑ کئے کے","tr":"kal-ṣarīmi"}],"68:21":[{"ar":"فَتَنَادَوْا۟","en":"And they called one another","ur":"تو ایک دوسرے کو پکارے لگے","tr":"fatanādaw"},{"ar":"مُصْبِحِينَ","en":"(at) morning","ur":"صبح سویرے","tr":"muṣ'biḥīna"}],"68:22":[{"ar":"أَنِ","en":"That","ur":"کہ","tr":"ani"},{"ar":"ٱغْدُوا۟","en":"Go early","ur":"چلو","tr":"igh'dū"},{"ar":"عَلَىٰ","en":"to","ur":"پر","tr":"ʿalā"},{"ar":"حَرْثِكُمْ","en":"your crop","ur":"اپنے کھیت","tr":"ḥarthikum"},{"ar":"إِن","en":"if","ur":"اگر","tr":"in"},{"ar":"كُنتُمْ","en":"you would","ur":"ہو تم","tr":"kuntum"},{"ar":"صَـٰرِمِينَ","en":"pluck (the) fruit","ur":"کاٹنے والے","tr":"ṣārimīna"}],"68:23":[{"ar":"فَٱنطَلَقُوا۟","en":"So they went","ur":"تو وہ چل دئیے","tr":"fa-inṭalaqū"},{"ar":"وَهُمْ","en":"while they","ur":"اور وہ","tr":"wahum"},{"ar":"يَتَخَـٰفَتُونَ","en":"lowered (their) voices","ur":"چپکے چپکے باتیں کررہے تھے","tr":"yatakhāfatūna"}],"68:24":[{"ar":"أَن","en":"That","ur":"کہ","tr":"an"},{"ar":"لَّا","en":"Not","ur":"نہیں","tr":"lā"},{"ar":"يَدْخُلَنَّهَا","en":"will enter it","ur":"داخل ہوگا اس پر","tr":"yadkhulannahā"},{"ar":"ٱلْيَوْمَ","en":"today","ur":"آج","tr":"l-yawma"},{"ar":"عَلَيْكُم","en":"upon you","ur":"تم پر","tr":"ʿalaykum"},{"ar":"مِّسْكِينٌۭ","en":"any poor person","ur":"کوئی مسکین","tr":"mis'kīnun"}],"68:25":[{"ar":"وَغَدَوْا۟","en":"And they went early","ur":"اور وہ صبح سویرے گئے","tr":"waghadaw"},{"ar":"عَلَىٰ","en":"with","ur":"اوپر","tr":"ʿalā"},{"ar":"حَرْدٍۢ","en":"determination","ur":"بخیلی کے۔ بخل کرتے ہوئے","tr":"ḥardin"},{"ar":"قَـٰدِرِينَ","en":"able","ur":"جیسا کہ قدرت رکھنے والے ہوں","tr":"qādirīna"}],"68:26":[{"ar":"فَلَمَّا","en":"But when","ur":"تو جب","tr":"falammā"},{"ar":"رَأَوْهَا","en":"they saw it","ur":"انہوں نے دیکھا اس کو","tr":"ra-awhā"},{"ar":"قَالُوٓا۟","en":"they said","ur":"کہنے لگے","tr":"qālū"},{"ar":"إِنَّا","en":"Indeed, we","ur":"بیشک ہم","tr":"innā"},{"ar":"لَضَآلُّونَ","en":"(are) surely lost","ur":"البتہ بھٹک گئے ہیں","tr":"laḍāllūna"}],"68:27":[{"ar":"بَلْ","en":"Nay","ur":"(نہیں) بلکہ","tr":"bal"},{"ar":"نَحْنُ","en":"We","ur":"ہم","tr":"naḥnu"},{"ar":"مَحْرُومُونَ","en":"(are) deprived","ur":"محروم کردئیے گئے ہیں","tr":"maḥrūmūna"}],"68:28":[{"ar":"قَالَ","en":"Said","ur":"بولا","tr":"qāla"},{"ar":"أَوْسَطُهُمْ","en":"(the) most moderate of them","ur":"ان کا درمیانہ۔ ان کا بہتر شخص","tr":"awsaṭuhum"},{"ar":"أَلَمْ","en":"Did not","ur":"کیا نہیں","tr":"alam"},{"ar":"أَقُل","en":"I tell","ur":"میں نے کہا تھا","tr":"aqul"},{"ar":"لَّكُمْ","en":"you","ur":"تم سے","tr":"lakum"},{"ar":"لَوْلَا","en":"'Why not","ur":"کیوں نہیں","tr":"lawlā"},{"ar":"تُسَبِّحُونَ","en":"you glorify (Allah)?'","ur":"تم تسبیح کرتے","tr":"tusabbiḥūna"}],"68:29":[{"ar":"قَالُوا۟","en":"They said","ur":"انہوں نے کہا","tr":"qālū"},{"ar":"سُبْحَـٰنَ","en":"Glory be","ur":"پاک ہے","tr":"sub'ḥāna"},{"ar":"رَبِّنَآ","en":"(to) our Lord","ur":"رب ہمارا","tr":"rabbinā"},{"ar":"إِنَّا","en":"Indeed, we","ur":"بیشک ہم","tr":"innā"},{"ar":"كُنَّا","en":"[we] were","ur":"تھے ہم","tr":"kunnā"},{"ar":"ظَـٰلِمِينَ","en":"wrongdoers","ur":"ظالم","tr":"ẓālimīna"}],"68:30":[{"ar":"فَأَقْبَلَ","en":"Then approached","ur":"تو متوجہ ہوا","tr":"fa-aqbala"},{"ar":"بَعْضُهُمْ","en":"some of them","ur":"ان کا بعض","tr":"baʿḍuhum"},{"ar":"عَلَىٰ","en":"to","ur":"پر","tr":"ʿalā"},{"ar":"بَعْضٍۢ","en":"others","ur":"بعض","tr":"baʿḍin"},{"ar":"يَتَلَـٰوَمُونَ","en":"blaming each other","ur":"آپس میں ملامت کرتے ہوئے","tr":"yatalāwamūna"}],"68:31":[{"ar":"قَالُوا۟","en":"They said","ur":"انہوں نے کہا","tr":"qālū"},{"ar":"يَـٰوَيْلَنَآ","en":"O woe to us","ur":"ہائے افسوس ہم پر","tr":"yāwaylanā"},{"ar":"إِنَّا","en":"Indeed, we","ur":"بیشک ہم","tr":"innā"},{"ar":"كُنَّا","en":"[we] were","ur":"تھے ہم","tr":"kunnā"},{"ar":"طَـٰغِينَ","en":"transgressors","ur":"سرکش","tr":"ṭāghīna"}],"68:32":[{"ar":"عَسَىٰ","en":"Perhaps","ur":"امید ہے کہ","tr":"ʿasā"},{"ar":"رَبُّنَآ","en":"our Lord","ur":"ہمارا رب","tr":"rabbunā"},{"ar":"أَن","en":"[that]","ur":"کہ","tr":"an"},{"ar":"يُبْدِلَنَا","en":"will substitute for us","ur":"بدل کردے ہم کو","tr":"yub'dilanā"},{"ar":"خَيْرًۭا","en":"a better","ur":"بہتر","tr":"khayran"},{"ar":"مِّنْهَآ","en":"than it","ur":"اس سے","tr":"min'hā"},{"ar":"إِنَّآ","en":"Indeed, we","ur":"بیشک ہم","tr":"innā"},{"ar":"إِلَىٰ","en":"to","ur":"طرف","tr":"ilā"},{"ar":"رَبِّنَا","en":"our Lord","ur":"اپنے رب کی","tr":"rabbinā"},{"ar":"رَٰغِبُونَ","en":"turn devoutly","ur":"رغبت کرنے والے ہیں","tr":"rāghibūna"}],"68:33":[{"ar":"كَذَٰلِكَ","en":"Such","ur":"اسی طرح ہوتا ہے۔ ایسا ہوتا ہے","tr":"kadhālika"},{"ar":"ٱلْعَذَابُ ۖ","en":"(is) the punishment","ur":"عذاب","tr":"l-ʿadhābu"},{"ar":"وَلَعَذَابُ","en":"And surely the punishment","ur":"اور البتہ عذاب","tr":"walaʿadhābu"},{"ar":"ٱلْـَٔاخِرَةِ","en":"(of) the Hereafter","ur":"آخرت کا","tr":"l-ākhirati"},{"ar":"أَكْبَرُ ۚ","en":"(is) greater","ur":"زیادہ بڑا ہے","tr":"akbaru"},{"ar":"لَوْ","en":"if","ur":"کاش","tr":"law"},{"ar":"كَانُوا۟","en":"they","ur":"وہ ہوتے","tr":"kānū"},{"ar":"يَعْلَمُونَ","en":"know","ur":"وہ جانتے","tr":"yaʿlamūna"}],"68:34":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"لِلْمُتَّقِينَ","en":"for the righteous","ur":"متقی لوگوں کے لیے","tr":"lil'muttaqīna"},{"ar":"عِندَ","en":"with","ur":"نزدیک","tr":"ʿinda"},{"ar":"رَبِّهِمْ","en":"their Lord","ur":"ان کے رب کے","tr":"rabbihim"},{"ar":"جَنَّ
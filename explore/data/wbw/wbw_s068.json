{"68:1":[{"ar":"نٓ ۚ","en":"Nun","ur":"ن","tr":"noon"},{"ar":"وَٱلْقَلَمِ","en":"By the pen","ur":"قسم ہے قلم کی","tr":"wal-qalami"},{"ar":"وَمَا","en":"and what","ur":"اور قسم ہے اس کی جو کچھ","tr":"wamā"},{"ar":"يَسْطُرُونَ","en":"they write","ur":"وہ لکھ رہے ہیں","tr":"yasṭurūna"}],"68:2":[{"ar":"مَآ","en":"Not","ur":"نہیں ہیں","tr":"mā"},{"ar":"أَنتَ","en":"you (are)","ur":"آپ","tr":"anta"},{"ar":"بِنِعْمَةِ","en":"by (the) Grace","ur":"نعمت کے ساتھ","tr":"biniʿ'mati"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کی","tr":"rabbika"},{"ar":"بِمَجْنُونٍۢ","en":"a madman","ur":"مجنون","tr":"bimajnūnin"}],"68:3":[{"ar":"وَإِنَّ","en":"And indeed","ur":"اور بیشک","tr":"wa-inna"},{"ar":"لَكَ","en":"for you","ur":"آپ کے لیے","tr":"laka"},{"ar":"لَأَجْرًا","en":"surely (is) a reward","ur":"البتہ اجر ہے","tr":"la-ajran"},{"ar":"غَيْرَ","en":"without","ur":"نہ","tr":"ghayra"},{"ar":"مَمْنُونٍۢ","en":"end","ur":"ختم ہونے والا","tr":"mamnūnin"}],"68:4":[{"ar":"وَإِنَّكَ","en":"And indeed, you","ur":"اور بیشک آپ","tr":"wa-innaka"},{"ar":"لَعَلَىٰ","en":"surely (are)","ur":"البتہ","tr":"laʿalā"},{"ar":"خُلُقٍ","en":"(of) a moral character","ur":"اخلاق کے","tr":"khuluqin"},{"ar":"عَظِيمٍۢ","en":"great","ur":"بلند مرتبے پر ہیں","tr":"ʿaẓīmin"}],"68:5":[{"ar":"فَسَتُبْصِرُ","en":"So you will see","ur":"پس عنقریب تم بھی دیکھو گے","tr":"fasatub'ṣiru"},{"ar":"وَيُبْصِرُونَ","en":"and they will see","ur":"اور وہ بھی دیکھیں گے","tr":"wayub'ṣirūna"}],"68:6":[{"ar":"بِأَييِّكُمُ","en":"Which of you","ur":"کون تم میں سے","tr":"bi-ayyikumu"},{"ar":"ٱلْمَفْتُونُ","en":"(is) the afflicted one","ur":"فتنے میں پڑا ہو ا ہے","tr":"l-maftūnu"}],"68:7":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"رَبَّكَ","en":"your Lord","ur":"رب تیرا","tr":"rabbaka"},{"ar":"هُوَ","en":"He","ur":"وہ","tr":"huwa"},{"ar":"أَعْلَمُ","en":"(is) most knowing","ur":"زیادہ جانتا ہے","tr":"aʿlamu"},{"ar":"بِمَن","en":"of (he) who","ur":"اس کو جو","tr":"biman"},{"ar":"ضَلَّ","en":"has strayed","u
{"110:1":[{"ar":"إِذَا","en":"When","ur":"جب","tr":"idhā"},{"ar":"جَآءَ","en":"comes","ur":"آگئی","tr":"jāa"},{"ar":"نَصْرُ","en":"(the) Help","ur":"مدد","tr":"naṣru"},{"ar":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کی","tr":"l-lahi"},{"ar":"وَٱلْفَتْحُ","en":"and the Victory","ur":"اور فتح","tr":"wal-fatḥu"}],"110:2":[{"ar":"وَرَأَيْتَ","en":"And you see","ur":"اور تم نے دیکھا","tr":"wara-ayta"},{"ar":"ٱلنَّاسَ","en":"the people","ur":"لوگوں کو","tr":"l-nāsa"},{"ar":"يَدْخُلُونَ","en":"entering","ur":"داخل ہو رہے ہیں","tr":"yadkhulūna"},{"ar":"فِى","en":"into","ur":"میں","tr":"fī"},{"ar":"دِينِ","en":"(the) religion","ur":"دین (میں)","tr":"dīni"},{"ar":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے","tr":"l-lahi"},{"ar":"أَفْوَاجًۭا","en":"(in) multitudes","ur":"فوج در فوج","tr":"afwājan"}],"110:3":[{"ar":"فَسَبِّحْ","en":"Then glorify","ur":"تو تسبیح کرو","tr":"fasabbiḥ"},{"ar":"بِحَمْدِ","en":"with (the) praises","ur":"حمد کے ساتھ","tr":"biḥamdi"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کی","tr":"rabbika"},{"ar":"وَٱسْتَغْفِرْهُ ۚ","en":"and ask His forgiveness","ur":"اور بخشش مانگو اس سے","tr":"wa-is'taghfir'hu"},{"ar":"إِنَّهُۥ","en":"Indeed, He","ur":"بیشک وہ","tr":"innahu"},{"ar":"كَانَ","en":"is","ur":"ہے","tr":"kāna"},{"ar":"تَوَّابًۢا","en":"Oft-Returning","ur":"توبہ قبول کرنے والا","tr":"tawwāban"}]}
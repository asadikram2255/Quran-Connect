{"91:1":[{"ar":"وَٱلشَّمْسِ","en":"By the sun","ur":"قسم ہے سورج کی","tr":"wal-shamsi"},{"ar":"وَضُحَىٰهَا","en":"and its brightness","ur":"اور قسم ہے اس کی دھوپ کی","tr":"waḍuḥāhā"}],"91:2":[{"ar":"وَٱلْقَمَرِ","en":"And the moon","ur":"اور قسم ہے چاند کی","tr":"wal-qamari"},{"ar":"إِذَا","en":"when","ur":"جبکہ","tr":"idhā"},{"ar":"تَلَىٰهَا","en":"it follows it","ur":"وہ اس کے پیچھے آئے","tr":"talāhā"}],"91:3":[{"ar":"وَٱلنَّهَارِ","en":"And the day","ur":"اور قسم ہے دن کی","tr":"wal-nahāri"},{"ar":"إِذَا","en":"when","ur":"جبکہ","tr":"idhā"},{"ar":"جَلَّىٰهَا","en":"it displays it","ur":"وہ اس کو ظاہر کرے","tr":"jallāhā"}],"91:4":[{"ar":"وَٱلَّيْلِ","en":"And the night","ur":"اور قسم ہے رات کی","tr":"wa-al-layli"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"يَغْشَىٰهَا","en":"it covers it","ur":"وہ چھا جائے اس پر","tr":"yaghshāhā"}],"91:5":[{"ar":"وَٱلسَّمَآءِ","en":"And the heaven","ur":"اور قسم ہے آسمان کی","tr":"wal-samāi"},{"ar":"وَمَا","en":"and (He) Who","ur":"اور اس کی","tr":"wamā"},{"ar":"بَنَىٰهَا","en":"constructed it","ur":"جس نے بنایا اس کو","tr":"banāhā"}],"91:6":[{"ar":"وَٱلْأَرْضِ","en":"And the earth","ur":"اور قسم ہے زمین کی","tr":"wal-arḍi"},{"ar":"وَمَا","en":"and by (He) Who","ur":"اور اس کی","tr":"wamā"},{"ar":"طَحَىٰهَا","en":"spread it","ur":"جس نے بچھایا اس کو","tr":"ṭaḥāhā"}],"91:7":[{"ar":"وَنَفْسٍۢ","en":"And (the) soul","ur":"اور قسم ہے نفس انسانی کی","tr":"wanafsin"},{"ar":"وَمَا","en":"and (He) Who","ur":"اور اس کی","tr":"wamā"},{"ar":"سَوَّىٰهَا","en":"proportioned it","ur":"جس نے درست کیا اس کو/ ہموار کیا اس کو","tr":"sawwāhā"}],"91:8":[{"ar":"فَأَلْهَمَهَا","en":"And He inspired it","ur":"پس اس نے الہام کیا اس کو","tr":"fa-alhamahā"},{"ar":"فُجُورَهَا","en":"(to distinguish) its wickedness","ur":"اور اس کی بدی کو","tr":"fujūrahā"},{"ar":"وَتَقْوَىٰهَا","en":"and its righteousness","ur":"اور اس کے تقویٰ کو","tr":"wataqwāhā"}],"91:9":[{"ar":"قَدْ","en":"Indeed","ur":"یقیناً","tr":"qad"},{"ar":"أَفْلَحَ","en":"he succeeds","ur":"فلاح پا گیا","tr":"aflaḥa"},{"ar":"مَن","en":"who","ur":"جس نے","tr":"man"},{"ar":"زَكَّىٰهَا","en":"purifies it","ur":"پاک کیا اس کو","tr":"zakkāhā"}],"91:10":[{"ar":"وَقَدْ","en":"And indeed","ur":"اور یقیناً","tr":"waqad"},{"ar":"خَابَ","en":"he fails","ur":"ناکام ہوا","tr":"khāba"},{"ar":"مَن","en":"who","ur":"جس نے","tr":"man"},{"ar":"دَسَّىٰهَا","en":"buries it","ur":"دبا دیا اس کو","tr":"dassāhā"}],"91:11":[{"ar":"كَذَّبَتْ","en":"Denied","ur":"جھٹلایا","tr":"kadhabat"},{"ar":"ثَمُودُ","en":"Thamud","ur":"ثمود نے","tr":"thamūdu"},{"ar":"بِطَغْوَىٰهَآ","en":"by their transgression","ur":"اپنی سرکشی کے ساتھ","tr":"biṭaghwāhā"}],"91:12":[{"ar":"إِذِ","en":"When","ur":"جب","tr":"idhi"},{"ar":"ٱنۢبَعَثَ","en":"(was) sent forth","ur":"اٹھا","tr":"inbaʿatha"},{"ar":"أَشْقَىٰهَا","en":"(the) most wicked of them","ur":"سب سے بڑا بدبخت اس کا","tr":"ashqāhā"}],"91:13":[{"ar":"فَقَالَ","en":"But said","ur":"تو کہا","tr":"faqāla"},{"ar":"لَهُمْ","en":"to them","ur":"ان کو","tr":"lahum"},{"ar":"رَسُولُ","en":"(the) Messenger","ur":"رسول نے","tr":"rasūlu"},{"ar":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے","tr":"l-lahi"},{"ar":"نَاقَةَ","en":"(It is the) she-camel","ur":"اونٹنی ہے","tr":"nāqata"},{"ar":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کی","tr":"l-lahi"},{"ar":"وَسُقْيَـٰهَا","en":"and her drink","ur":"اور پانی پلانا اس کو","tr":"wasuq'yāhā"}],"91:14":[{"ar":"فَكَذَّبُوهُ","en":"But they denied him","ur":"تو انہوں نے جھٹلایا اس کو","tr":"fakadhabūhu"},{"ar":"فَعَقَرُوهَا","en":"and they hamstrung her","ur":"پھر کاٹ ڈالا اس کو","tr":"faʿaqarūhā"},{"ar":"فَدَمْدَمَ","en":"So destroyed","ur":"تو ہلاکت ڈالی","tr":"fadamdama"},{"ar":"عَلَيْهِمْ","en":"them","ur":"ان پر","tr":"ʿalayhim"},{"ar":"رَبُّهُم","en":"their Lord","ur":"ان کے رب نے","tr":"rabbuhum"},{"ar":"بِذَنۢبِهِمْ","en":"for their sin","ur":"ان کے گناہوں کی وجہ سے","tr":"bidhanbihim"},{"ar":"فَسَوَّىٰهَا","en":"and leveled them","ur":"پھر برابر کردیا اس کو","tr":"fasawwāhā"}],"91:15":[{"ar":"وَلَا","en":"And not","ur":"اور نہیں","tr":"walā"},{"ar":"يَخَافُ","en":"He fears","ur":"وہ ڈرتا","tr":"yakhāfu"},{"ar":"عُقْبَـٰهَا","en":"its consequences","ur":"اس کے انجام سے","tr":"ʿuq'bāhā"}]}
{"84:1":[{"ar":"إِذَا","en":"When","ur":"جب","tr":"idhā"},{"ar":"ٱلسَّمَآءُ","en":"the sky","ur":"آسمان","tr":"l-samāu"},{"ar":"ٱنشَقَّتْ","en":"is split asunder","ur":"پھٹ جائے گا","tr":"inshaqqat"}],"84:2":[{"ar":"وَأَذِنَتْ","en":"And has listened","ur":"اور کان لگائے گا","tr":"wa-adhinat"},{"ar":"لِرَبِّهَا","en":"to its Lord","ur":"اپنے رب کے لئے","tr":"lirabbihā"},{"ar":"وَحُقَّتْ","en":"and was obligated","ur":"اور حق یہی ہے/ یہی حق دیا گیا ہے","tr":"waḥuqqat"}],"84:3":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْأَرْضُ","en":"the earth","ur":"زمین","tr":"l-arḍu"},{"ar":"مُدَّتْ","en":"is spread","ur":"پھیلادی جائے گی","tr":"muddat"}],"84:4":[{"ar":"وَأَلْقَتْ","en":"And has cast out","ur":"اور ڈال دی جائے گی","tr":"wa-alqat"},{"ar":"مَا","en":"what","ur":"جو","tr":"mā"},{"ar":"فِيهَا","en":"(is) in it","ur":"اس میں ہے","tr":"fīhā"},{"ar":"وَتَخَلَّتْ","en":"and becomes empty","ur":"اور خالی ہوجائے گی","tr":"watakhallat"}],"84:5":[{"ar":"وَأَذِنَتْ","en":"And has listened","ur":"اور کان لگائے گی","tr":"wa-adhinat"},{"ar":"لِرَبِّهَا","en":"to its Lord","ur":"اپنے رب کے لئے","tr":"lirabbihā"},{"ar":"وَحُقَّتْ","en":"and was obligated","ur":"اور حق یہی ہے/ یہی حق دی گئی ہے","tr":"waḥuqqat"}],"84:6":[{"ar":"يَـٰٓأَيُّهَا","en":"O","ur":"اے","tr":"yāayyuhā"},{"ar":"ٱلْإِنسَـٰنُ","en":"mankind","ur":"انسان","tr":"l-insānu"},{"ar":"إِنَّكَ","en":"Indeed, you","ur":"بیشک","tr":"innaka"},{"ar":"كَادِحٌ","en":"(are) laboring","ur":"تو محنت کرنے والا ہے","tr":"kādiḥun"},{"ar":"إِلَىٰ","en":"to","ur":"طرف","tr":"ilā"},{"ar":"رَبِّكَ","en":"your Lord","ur":"اپنے رب کی","tr":"rabbika"},{"ar":"كَدْحًۭا","en":"(with) exertion","ur":"خوب محنت","tr":"kadḥan"},{"ar":"فَمُلَـٰقِيهِ","en":"and you (will) meet Him","ur":"پھر ملنے والا ہے اس سے","tr":"famulāqīhi"}],"84:7":[{"ar":"فَأَمَّا","en":"Then as for","ur":"تو رہا","tr":"fa-ammā"},{"ar":"مَنْ","en":"(him) who","ur":"وہ جو","tr":"man"},{"ar":"أُوتِىَ","en":"is given","ur":"دیا گیا","tr":"ūtiya"},{"ar":"كِتَـٰبَهُۥ","en":"his record","ur":"کتاب اپنی","tr":"kitābahu"},{"ar":"بِيَمِينِهِۦ","en":"in his right (hand)","ur":"اپنے دائیں ہاتھ میں","tr":"biyamīnihi"}],"84:8":[{"ar":"فَسَوْفَ","en":"Then soon","ur":"تو عنقریب","tr":"fasawfa"},{"ar":"يُحَاسَبُ","en":"his account will be taken","ur":"حساب کیا جائے گا وہ","tr":"yuḥāsabu"},{"ar":"حِسَابًۭا","en":"an account","ur":"حساب","tr":"ḥisāban"},{"ar":"يَسِيرًۭا","en":"easy","ur":"آسان","tr":"yasīran"}],"84:9":[{"ar":"وَيَنقَلِبُ","en":"And he will return","ur":"اور وہ لوٹے گا","tr":"wayanqalibu"},{"ar":"إِلَىٰٓ","en":"to","ur":"طرف","tr":"ilā"},{"ar":"أَهْلِهِۦ","en":"his people","ur":"اپنے گھر والوں کی (طرف)","tr":"ahlihi"},{"ar":"مَسْرُورًۭا","en":"happily","ur":"خوش","tr":"masrūran"}],"84:10":[{"ar":"وَأَمَّا","en":"But as for","ur":"اور رہا","tr":"wa-ammā"},{"ar":"مَنْ","en":"(him) who","ur":"وہ جو","tr":"man"},{"ar":"أُوتِىَ","en":"is given","ur":"دیا گیا","tr":"ūtiya"},{"ar":"كِتَـٰبَهُۥ","en":"his record","ur":"اپنی کتاب/ نامہ اعمال","tr":"kitābahu"},{"ar":"وَرَآءَ","en":"behind","ur":"پیچھے","tr":"warāa"},{"ar":"ظَهْرِهِۦ","en":"his back","ur":"اپنی پیٹھ کے","tr":"ẓahrihi"}],"84:11":[{"ar":"فَسَوْفَ","en":"Then soon","ur":"تو عنقریب","tr":"fasawfa"},{"ar":"يَدْعُوا۟","en":"he will call","ur":"بلائے گا","tr":"yadʿū"},{"ar":"ثُبُورًۭا","en":"(for) destruction","ur":"ہلاکت کو","tr":"thubūran"}],"84:12":[{"ar":"وَيَصْلَىٰ","en":"And he will burn","ur":"اور داخل ہوگا","tr":"wayaṣlā"},{"ar":"سَعِيرًا","en":"(in) a Blaze","ur":"بھڑکتی آگ میں","tr":"saʿīran"}],"84:13":[{"ar":"إِنَّهُۥ","en":"Indeed, he","ur":"بیشک وہ","tr":"innahu"},{"ar":"كَانَ","en":"had been","ur":"تھا","tr":"kāna"},{"ar":"فِىٓ","en":"among","ur":"میں","tr":"fī"},{"ar":"أَهْلِهِۦ","en":"his people","ur":"اپنے گھر والوں (میں )","tr":"ahlihi"},{"ar":"مَسْرُورًا","en":"happy","ur":"مسرور/ خوش","tr":"masrūran"}],"84:14":[{"ar":"إِنَّهُۥ","en":"Indeed, he","ur":"بیشک وہ","tr":"innahu"},{"ar":"ظَنَّ","en":"(had) thought","ur":"سمجھتا تھا","tr":"ẓanna"},{"ar":"أَن","en":"that","ur":"کہ","tr":"an"},{"ar":"لَّن","en":"never","ur":"ہرگز نہیں","tr":"lan"},{"ar":"يَحُورَ","en":"he would return","ur":"وہ لوٹے گا","tr":"yaḥūra"}],"84:15":[{"ar":"بَلَىٰٓ","en":"Yes","ur":"کیوں نہیں","tr":"balā"},{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"رَبَّهُۥ","en":"his Lord","ur":"اس کا رب","tr":"rabbahu"},{"ar":"كَانَ","en":"was","ur":"تھا","tr":"kāna"},{"ar":"بِهِۦ","en":"of him","ur":"اس کو","tr":"bihi"},{"ar":"بَصِيرًۭا","en":"All-Seer","ur":"دیکھنے والا","tr":"baṣīran"}],"84:16":[{"ar":"فَلَآ","en":"But nay","ur":"پس نہیں","tr":"falā"},{"ar":"أُقْسِمُ","en":"I swear","ur":"میں قسم کھاتا ہوں","tr":"uq'simu"},{"ar":"بِٱلشَّفَقِ","en":"by the twilight glow","ur":"شفق کی","tr":"bil-shafaqi"}],"84:17":[{"ar":"وَٱلَّيْلِ","en":"And the night","ur":"اور رات کی","tr":"wa-al-layli"},{"ar":"وَمَا","en":"and what","ur":"اور اس کی جو","tr":"wamā"},{"ar":"وَسَقَ","en":"it envelops","ur":"وہ اکٹھا کرے/ سمیٹ لے","tr":"wasaqa"}],"84:18":[{"ar":"وَٱلْقَمَرِ","en":"And the moon","ur":"اور چاند کی","tr":"wal-qamari"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"ٱتَّسَقَ","en":"it becomes full","ur":"وہ پورا ہو جائے","tr":"ittasaqa"}],"84:19":[{"ar":"لَتَرْكَبُنَّ","en":"You will surely embark","ur":"البتہ تم ضرور سوار ہوگے","tr":"latarkabunna"},{"ar":"طَبَقًا","en":"(to) stage","ur":"ایک حالت پر","tr":"ṭabaqan"},{"ar":"عَن","en":"from","ur":"سے","tr":"ʿan"},{"ar":"طَبَقٍۢ","en":"stage","ur":"دوسری حالت(سے)","tr":"ṭabaqin"}],"84:20":[{"ar":"فَمَا","en":"So what","ur":"پس کیا ہے","tr":"famā"},{"ar":"لَهُمْ","en":"(is) for them","ur":"ان کو","tr":"lahum"},{"ar":"لَا","en":"not","ur":"نہیں","tr":"lā"},{"ar":"يُؤْمِنُونَ","en":"they believe","ur":"وہ ایمان لاتے","tr":"yu'minūna"}],"84:21":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"قُرِئَ","en":"is recited","ur":"پڑھا جاتا ہے","tr":"quri-a"},{"ar":"عَلَيْهِمُ","en":"to them","ur":"ان پر","tr":"ʿalayhimu"},{"ar":"ٱلْقُرْءَانُ","en":"the Quran","ur":"قرآن","tr":"l-qur'ānu"},{"ar":"لَا","en":"not","ur":"نہیں","tr":"lā"},{"ar":"يَسْجُدُونَ ۩","en":"they prostrate","ur":"وہ سجدہ  کرتے","tr":"yasjudūna"}],"84:22":[{"ar":"بَلِ","en":"Nay","ur":"بلکہ","tr":"bali"},{"ar":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا","tr":"kafarū"},{"ar":"يُكَذِّبُونَ","en":"deny","ur":"وہ جھٹلاتے ہیں","tr":"yukadhibūna"}],"84:23":[{"ar":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ","tr":"wal-lahu"},{"ar":"أَعْلَمُ","en":"(is) most knowing","ur":"خوب جانتا ہے","tr":"aʿlamu"},{"ar":"بِمَا","en":"of what","ur":"ساتھ اس کے جو","tr":"bimā"},{"ar":"يُوعُونَ","en":"they keep within themselves","ur":"وہ سمیٹ رہے ہیں","tr":"yūʿūna"}],"84:24":[{"ar":"فَبَشِّرْهُم","en":"so give them tidings","ur":"پس خوش خبری دے دیجئے  ان کو","tr":"fabashir'hum"},{"ar":"بِعَذَابٍ","en":"of a punishment","ur":"عذاب","tr":"biʿadhābin"},{"ar":"أَلِيمٍ","en":"painful","ur":"درد ناک کی","tr":"alīmin"}],"84:25":[{"ar":"إِلَّا","en":"Except","ur":"سوائے","tr":"illā"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں کے","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے عمل کئے","tr":"waʿamilū"},{"ar":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے","tr":"l-ṣāliḥāti"},{"ar":"لَهُمْ","en":"For them","ur":"ان کے لئے","tr":"lahum"},{"ar":"أَجْرٌ","en":"(is) a reward","ur":"اجر ہے","tr":"ajrun"},{"ar":"غَيْرُ","en":"never","ur":"نہ","tr":"ghayru"},{"ar":"مَمْنُونٍۭ","en":"ending","ur":"ختم ہونے والا","tr":"mamnūnin"}]}
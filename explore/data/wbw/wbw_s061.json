مان لایا","tr":"faāmanat"},{"ar":"طَّآئِفَةٌۭ","en":"a group","ur":"ایک گروہ","tr":"ṭāifatun"},{"ar":"مِّنۢ","en":"of","ur":"سے","tr":"min"},{"ar":"بَنِىٓ","en":"Children","ur":"بنی","tr":"banī"},{"ar":"إِسْرَٰٓءِيلَ","en":"(of) Israel","ur":"اسرائیل میں سے","tr":"is'rāīla"},{"ar":"وَكَفَرَت","en":"and disbelieved","ur":"اور انکار کردیا","tr":"wakafarat"},{"ar":"طَّآئِفَةٌۭ ۖ","en":"a group","ur":"ایک گروہ نے","tr":"ṭāifatun"},{"ar":"فَأَيَّدْنَا","en":"So We supported","ur":"تو تائید کی ہم نے۔ مدد کی ہم نے","tr":"fa-ayyadnā"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں کی","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"believed","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"عَلَىٰ","en":"against","ur":"اوپر","tr":"ʿalā"},{"ar":"عَدُوِّهِمْ","en":"their enemy","ur":"ان کے دشمنوں کے","tr":"ʿaduwwihim"},{"ar":"فَأَصْبَحُوا۟","en":"and they became","ur":"تو ہوگئے وہ","tr":"fa-aṣbaḥū"},{"ar":"ظَـٰهِرِينَ","en":"dominant","ur":"غالب آنے والے","tr":"ẓāhirīna"}]}
{"63:1":[{"ar":"إِذَا","en":"When","ur":"جب","tr":"idhā"},{"ar":"جَآءَكَ","en":"come to you","ur":"آتے ہیں تیرے پاس","tr":"jāaka"},{"ar":"ٱلْمُنَـٰفِقُونَ","en":"the hypocrites","ur":"منافق","tr":"l-munāfiqūna"},{"ar":"قَالُوا۟","en":"they say","ur":"کہتے ہیں","tr":"qālū"},{"ar":"نَشْهَدُ","en":"We testify","ur":"ہم گواہی دیتے ہیں","tr":"nashhadu"},{"ar":"إِنَّكَ","en":"that you","ur":"بیشک آپ","tr":"innaka"},{"ar":"لَرَسُولُ","en":"(are) surely (the) Messenger","ur":"البتہ رسول ہیں","tr":"larasūlu"},{"ar":"ٱللَّهِ ۗ","en":"(of) Allah","ur":"اللہ کے","tr":"l-lahi"},{"ar":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ","tr":"wal-lahu"},{"ar":"يَعْلَمُ","en":"knows","ur":"جانتا ہے","tr":"yaʿlamu"},{"ar":"إِنَّكَ","en":"that you","ur":"بیشک آپ","tr":"innaka"},{"ar":"لَرَسُولُهُۥ","en":"(are) surely His Messenger","ur":"البتہ اس کے رسول ہیں","tr":"larasūluhu"},{"ar":"وَٱللَّهُ","en":"and Allah","ur":"اور اللہ","tr":"wal-lahu"},{"ar":"يَشْهَدُ","en":"testifies","ur":"گواہی دیتا ہے","tr":"yashhadu"},{"ar":"إِنَّ","en":"that","ur":"بیشک","tr":"inna"},{"ar":"ٱلْمُنَـٰفِقِينَ","en":"the hypocrites","ur":"منافق","tr":"l-munāfiqīna"},{"ar":"لَكَـٰذِبُونَ","en":"(are) surely liars","ur":"البتہ جھوٹے ہیں","tr":"lakādhibūna"}],"63:2":[{"ar":"ٱتَّخَذُوٓا۟","en":"They take","ur":"انہوں نے بنا لیا","tr":"ittakhadhū"},{"ar":"أَيْمَـٰنَهُمْ","en":"their oaths","ur":"اپنی قسموں کو","tr":"aymānahum"},{"ar":"جُنَّةًۭ","en":"(as) a cover","ur":"ڈھال","tr":"junnatan"},{"ar":"فَصَدُّوا۟","en":"so they turn away","ur":"تو انہوں نے روکا","tr":"faṣaddū"},{"ar":"عَن","en":"from","ur":"سے","tr":"ʿan"},{"ar":"سَبِيلِ","en":"(the) Way","ur":"راستے سے","tr":"sabīli"},{"ar":"ٱللَّهِ ۚ","en":"(of) Allah","ur":"اللہ کے","tr":"l-lahi"},{"ar":"إِنَّهُمْ","en":"Indeed, [they]","ur":"بیشک وہ","tr":"innahum"},{"ar":"سَآءَ","en":"evil is","ur":"کتنا برا ہے","tr":"sāa"},{"ar":"مَا","en":"what","ur":"جو کچھ","tr":"mā"},{"ar":"كَانُوا۟","en":"they used to","ur":"وہ ہیں","tr":"kānū"},{"ar":"يَعْمَلُونَ","en":"do","ur":"وہ کررہے","tr":"yaʿmalūna"}],"63:3":[{"ar":"ذَٰلِكَ","en":"That","ur":"یہ","tr":"dhālika"},{"ar":"بِأَنَّهُمْ","en":"(is) because","ur":"بوجہ اس کے کہ بیشک وہ","tr":"bi-annahum"},{"ar":"ءَامَنُوا۟","en":"they believed","ur":"ایمان لائے","tr":"āmanū"},{"ar":"ثُمَّ","en":"then","ur":"پھر","tr":"thumma"},{"ar":"كَفَرُوا۟","en":"they disbelieved","ur":"انہوں نے کفر کیا","tr":"kafarū"},{"ar":"فَطُبِعَ","en":"so were sealed","ur":"تو مہر لگا دی گئی","tr":"faṭubiʿa"},{"ar":"عَلَىٰ","en":"[upon]","ur":"اوپر","tr":"ʿalā"},{"ar":"قُلُوبِهِمْ","en":"their hearts","ur":"ان کے دلوں کے","tr":"qulūbihim"},{"ar":"فَهُمْ","en":"so they","ur":"پس وہ","tr":"fahum"},{"ar":"لَا","en":"(do) not","ur":"نہیں","tr":"lā"},{"ar":"يَفْقَهُونَ","en":"understand","ur":"سمجھتے ہیں","tr":"yafqahūna"}],"63:4":[{"ar":"۞ وَإِذَا","en":"And when","ur":"پھر جب","tr":"wa-idhā"},{"ar":"رَأَيْتَهُمْ","en":"you see them","ur":"تم دیکھو ان کو","tr":"ra-aytahum"},{"ar":"تُعْجِبُكَ","en":"pleases you","ur":"اچھے لگیں گے تم کو","tr":"tuʿ'jibuka"},{"ar":"أَجْسَامُهُمْ ۖ","en":"their bodies","ur":"ان کے جسم","tr":"ajsāmuhum"},{"ar":"وَإِن","en":"and if","ur":"اور اگر","tr":"wa-in"},{"ar":"يَقُولُوا۟","en":"they speak","ur":"وہ بات کریں","tr":"yaqūlū"},{"ar":"تَسْمَعْ","en":"you listen","ur":"تم سنتے جاؤ","tr":"tasmaʿ"},{"ar":"لِقَوْلِهِمْ ۖ","en":"to their speech","ur":"ان کی بات کو","tr":"liqawlihim"},{"ar":"كَأَنَّهُمْ","en":"as if they (were)","ur":"گویا کہ وہ","tr":"ka-annahum"},{"ar":"خُشُبٌۭ","en":"pieces of wood","ur":"لکڑیاں ہیں","tr":"khushubun"},{"ar":"مُّسَنَّدَةٌۭ ۖ","en":"propped up","ur":"تختہ لگائی ہوئیں","tr":"musannadatun"},{"ar":"يَحْسَبُونَ","en":"They think","ur":"وہ سمجھتے ہیں","tr":"yaḥsabūna"},{"ar":"كُلَّ","en":"every","ur":"ہر","tr":"kulla"},{"ar":"صَيْحَةٍ","en":"shout","ur":"سخت آواز کو","tr":"ṣayḥatin"},{"ar":"عَلَيْهِمْ ۚ","en":"(is) against them","ur":"اپنے اوپر","tr":"ʿalayhim"},{"ar":"هُمُ","en":"They","ur":"وہ","tr":"humu"},{"ar":"ٱلْعَدُوُّ","en":"(are) the enemy","ur":"
{"78:1":[{"ar":"عَمَّ","en":"About what","ur":"کس چیز کے بارے میں","tr":"ʿamma"},{"ar":"يَتَسَآءَلُونَ","en":"are they asking one another","ur":"وہ ایک دوسرے سے سوال کر رہے ہیں","tr":"yatasāalūna"}],"78:2":[{"ar":"عَنِ","en":"About","ur":"بارے میں","tr":"ʿani"},{"ar":"ٱلنَّبَإِ","en":"the News","ur":"اس خبر کے","tr":"l-naba-i"},{"ar":"ٱلْعَظِيمِ","en":"the Great","ur":"جو بڑی ہے","tr":"l-ʿaẓīmi"}],"78:3":[{"ar":"ٱلَّذِى","en":"(About) which","ur":"وہ جو","tr":"alladhī"},{"ar":"هُمْ","en":"they","ur":"وہ","tr":"hum"},{"ar":"فِيهِ","en":"(are) concerning it","ur":"اس میں","tr":"fīhi"},{"ar":"مُخْتَلِفُونَ","en":"(in) disagreement","ur":"اختلاف کر رہے ہیں","tr":"mukh'talifūna"}],"78:4":[{"ar":"كَلَّا","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"سَيَعْلَمُونَ","en":"(soon) they will know","ur":"عنقریب وہ جان لیں گے","tr":"sayaʿlamūna"}],"78:5":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"كَلَّا","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"سَيَعْلَمُونَ","en":"(soon) they will know","ur":"عنقریب وہ جان لیں گے","tr":"sayaʿlamūna"}],"78:6":[{"ar":"أَلَمْ","en":"Have not","ur":"کیا نہیں","tr":"alam"},{"ar":"نَجْعَلِ","en":"We made","ur":"ہم نے بنایا","tr":"najʿali"},{"ar":"ٱلْأَرْضَ","en":"the earth","ur":"زمین کو","tr":"l-arḍa"},{"ar":"مِهَـٰدًۭا","en":"a resting place","ur":"فرش","tr":"mihādan"}],"78:7":[{"ar":"وَٱلْجِبَالَ","en":"And the mountains","ur":"اور پہاڑوں کو","tr":"wal-jibāla"},{"ar":"أَوْتَادًۭا","en":"(as) pegs","ur":"میخیں","tr":"awtādan"}],"78:8":[{"ar":"وَخَلَقْنَـٰكُمْ","en":"And We created you","ur":"اور پیدا کیا ہم نے تم کو","tr":"wakhalaqnākum"},{"ar":"أَزْوَٰجًۭا","en":"(in) pairs","ur":"جوڑوں کی شکل میں","tr":"azwājan"}],"78:9":[{"ar":"وَجَعَلْنَا","en":"And We made","ur":"اور بنایا ہم نے","tr":"wajaʿalnā"},{"ar":"نَوْمَكُمْ","en":"your sleep","ur":"تمہاری نیند کو","tr":"nawmakum"},{"ar":"سُبَاتًۭا","en":"(for) rest","ur":"آرام کا ذریعہ","tr":"subātan"}],"78:10":[{"ar":"وَجَعَلْنَا","en":"And We made","ur":"اور بنایا ہم نے",
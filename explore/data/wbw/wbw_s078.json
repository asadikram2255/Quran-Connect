,"tr":"bardan"},{"ar":"وَلَا","en":"and not","ur":"اور نہ","tr":"walā"},{"ar":"شَرَابًا","en":"any drink","ur":"پینے کی چیز","tr":"sharāban"}],"78:25":[{"ar":"إِلَّا","en":"Except","ur":"مگر","tr":"illā"},{"ar":"حَمِيمًۭا","en":"scalding water","ur":"کھولتا","tr":"ḥamīman"},{"ar":"وَغَسَّاقًۭا","en":"and purulence","ur":"اور بہتی پیپ","tr":"waghassāqan"}],"78:26":[{"ar":"جَزَآءًۭ","en":"A recompense","ur":"بدلہ ہے","tr":"jazāan"},{"ar":"وِفَاقًا","en":"appropriate","ur":"پورا پورا","tr":"wifāqan"}],"78:27":[{"ar":"إِنَّهُمْ","en":"Indeed, they","ur":"بیشک وہ","tr":"innahum"},{"ar":"كَانُوا۟","en":"were","ur":"وہ تھے","tr":"kānū"},{"ar":"لَا","en":"not","ur":"نہ","tr":"lā"},{"ar":"يَرْجُونَ","en":"expecting","ur":"امید رکھتے تھے","tr":"yarjūna"},{"ar":"حِسَابًۭا","en":"an account","ur":"حساب کی","tr":"ḥisāban"}],"78:28":[{"ar":"وَكَذَّبُوا۟","en":"And they denied","ur":"اور انہوں نے جھٹلایا","tr":"wakadhabū"},{"ar":"بِـَٔايَـٰتِنَا","en":"Our Signs","ur":"ہماری آیات کو","tr":"biāyātinā"},{"ar":"كِذَّابًۭا","en":"(with) denial","ur":"جھٹلانا","tr":"kidhāban"}],"78:29":[{"ar":"وَكُلَّ","en":"And every","ur":"اور ہر","tr":"wakulla"},{"ar":"شَىْءٍ","en":"thing","ur":"چیز کو","tr":"shayin"},{"ar":"أَحْصَيْنَـٰهُ","en":"We have enumerated it","ur":"شمار کر رکھا ہے ہم نے اس کو/ گھیر رکھا ہے ہم نے اس کو","tr":"aḥṣaynāhu"},{"ar":"كِتَـٰبًۭا","en":"(in) a Book","ur":"کتاب میں","tr":"kitāban"}],"78:30":[{"ar":"فَذُوقُوا۟","en":"So taste","ur":"پس چکھو","tr":"fadhūqū"},{"ar":"فَلَن","en":"and never","ur":"پس ہرگز نہ","tr":"falan"},{"ar":"نَّزِيدَكُمْ","en":"We will increase you","ur":"ہم زیادہ دیں گے تم کو","tr":"nazīdakum"},{"ar":"إِلَّا","en":"except","ur":"مگر","tr":"illā"},{"ar":"عَذَابًا","en":"(in) punishment","ur":"عذاب","tr":"ʿadhāban"}],"78:31":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"لِلْمُتَّقِينَ","en":"for the righteous","ur":"متقی لوگوں کے لئے","tr":"lil'muttaqīna"},{"ar":"مَفَازًا","en":"(is) success","ur":"کامیابی ہے","tr":"mafāzan"}],"78:32"
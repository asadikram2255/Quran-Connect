":"مَا","en":"what","ur":"جو","tr":"mā"},{"ar":"قَدَّمَتْ","en":"have sent forth","ur":"آگے بھیجا","tr":"qaddamat"},{"ar":"يَدَاهُ","en":"his hands","ur":"اس کے دونوں ہاتھوں نے","tr":"yadāhu"},{"ar":"وَيَقُولُ","en":"and will say","ur":"اور کہے گا","tr":"wayaqūlu"},{"ar":"ٱلْكَافِرُ","en":"the disbeliever","ur":"کافر","tr":"l-kāfiru"},{"ar":"يَـٰلَيْتَنِى","en":"O I wish","ur":"اے کاش کہ میں","tr":"yālaytanī"},{"ar":"كُنتُ","en":"I were","ur":"میں ہوتا","tr":"kuntu"},{"ar":"تُرَٰبًۢا","en":"dust","ur":"مٹی/خاک","tr":"turāban"}]}
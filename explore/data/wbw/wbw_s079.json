{"ar":"إِلَىٰ","en":"to","ur":"طرف","tr":"ilā"},{"ar":"فِرْعَوْنَ","en":"Firaun","ur":"فرعون کے","tr":"fir'ʿawna"},{"ar":"إِنَّهُۥ","en":"Indeed, he","ur":"بیشک وہ","tr":"innahu"},{"ar":"طَغَىٰ","en":"(has) transgressed","ur":"سرکش ہوگیا ہے","tr":"ṭaghā"}],"79:18":[{"ar":"فَقُلْ","en":"And say","ur":"پس کہو","tr":"faqul"},{"ar":"هَل","en":"Would","ur":"کیا","tr":"hal"},{"ar":"لَّكَ","en":"[for] you","ur":"تیرے لئے ہے","tr":"laka"},{"ar":"إِلَىٰٓ","en":"[to]","ur":"طرف اس بات کے","tr":"ilā"},{"ar":"أَن","en":"[that]","ur":"کہ","tr":"an"},{"ar":"تَزَكَّىٰ","en":"purify yourself","ur":"تو پاکیزگی اختیار کرے","tr":"tazakkā"}],"79:19":[{"ar":"وَأَهْدِيَكَ","en":"And I will guide you","ur":"اور میں رہنمائی کروں تیری","tr":"wa-ahdiyaka"},{"ar":"إِلَىٰ","en":"to","ur":"طرف","tr":"ilā"},{"ar":"رَبِّكَ","en":"your Lord","ur":"تیرے رب کی","tr":"rabbika"},{"ar":"فَتَخْشَىٰ","en":"so you would fear","ur":"تاکہ تو ڈرے","tr":"fatakhshā"}],"79:20":[{"ar":"فَأَرَىٰهُ","en":"Then he showed him","ur":"پس دکھائی اس کو","tr":"fa-arāhu"},{"ar":"ٱلْـَٔايَةَ","en":"the sign","ur":"نشانی","tr":"l-āyata"},{"ar":"ٱلْكُبْرَىٰ","en":"the great","ur":"بہت بڑی","tr":"l-kub'rā"}],"79:21":[{"ar":"فَكَذَّبَ","en":"But he denied","ur":"تو اس نے جھٹلادیا","tr":"fakadhaba"},{"ar":"وَعَصَىٰ","en":"and disobeyed","ur":"اور نافرمانی کی","tr":"waʿaṣā"}],"79:22":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"أَدْبَرَ","en":"he turned his back","ur":"اس نے پیٹھ پھیری","tr":"adbara"},{"ar":"يَسْعَىٰ","en":"striving","ur":"دوڑتے ہوئے","tr":"yasʿā"}],"79:23":[{"ar":"فَحَشَرَ","en":"And he gathered","ur":"پھر اس نے اکٹھا کیا","tr":"faḥashara"},{"ar":"فَنَادَىٰ","en":"and called out","ur":"پھر پکارا","tr":"fanādā"}],"79:24":[{"ar":"فَقَالَ","en":"Then he said","ur":"پھر کہا","tr":"faqāla"},{"ar":"أَنَا۠","en":"I am","ur":"میں","tr":"anā"},{"ar":"رَبُّكُمُ","en":"your Lord","ur":"تمہارا رب ہوں","tr":"rabbukumu"},{"ar":"ٱلْأَعْلَىٰ","en":"the Most High","ur":"سب سے اعلیٰ/ سب سے بڑا","tr":"l-aʿlā"}],"79:25":[{"ar":"فَأَخَذَهُ","en":"So seized him","ur":"تو پکڑ لیا اس کو","tr":"fa-akhadhahu"},{"ar":"ٱللَّهُ","en":"Allah","ur":"اللہ نے","tr":"l-lahu"},{"ar":"نَكَالَ","en":"(with) an exemplary punishment","ur":"عذاب میں","tr":"nakāla"},{"ar":"ٱلْـَٔاخِرَةِ","en":"(for) the last","ur":"آخرت کے (عذاب میں(/ سزا میں","tr":"l-ākhirati"},{"ar":"وَٱلْأُولَىٰٓ","en":"and the first","ur":"اور دنیا کے","tr":"wal-ūlā"}],"79:26":[{"ar":"إِنَّ","en":"Indeed","ur":"یقیناً","tr":"inna"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"ذَٰلِكَ","en":"that","ur":"اس (میں)","tr":"dhālika"},{"ar":"لَعِبْرَةًۭ","en":"surely (is) a lesson","ur":"البتہ عبرت ہے","tr":"laʿib'ratan"},{"ar":"لِّمَن","en":"for whoever","ur":"واسطے اس کے جو","tr":"liman"},{"ar":"يَخْشَىٰٓ","en":"fears","ur":"ڈرتا ہو","tr":"yakhshā"}],"79:27":[{"ar":"ءَأَنتُمْ","en":"Are you","ur":"کیا تم","tr":"a-antum"},{"ar":"أَشَدُّ","en":"a more difficult","ur":"زیادہ سخت ہو","tr":"ashaddu"},{"ar":"خَلْقًا","en":"creation","ur":"تخلیق میں","tr":"khalqan"},{"ar":"أَمِ","en":"or","ur":"یا","tr":"ami"},{"ar":"ٱلسَّمَآءُ ۚ","en":"the heaven","ur":"آسمان","tr":"l-samāu"},{"ar":"بَنَىٰهَا","en":"He constructed it","ur":"اس نے بنایا اس کو","tr":"banāhā"}],"79:28":[{"ar":"رَفَعَ","en":"He raised","ur":"اٹھایا","tr":"rafaʿa"},{"ar":"سَمْكَهَا","en":"its ceiling","ur":"اس کی بلندی کو","tr":"samkahā"},{"ar":"فَسَوَّىٰهَا","en":"and proportioned it","ur":"پھر درست کردیا اس کو","tr":"fasawwāhā"}],"79:29":[{"ar":"وَأَغْطَشَ","en":"And He darkened","ur":"اور ڈھانک دیا","tr":"wa-aghṭasha"},{"ar":"لَيْلَهَا","en":"its night","ur":"اس کی رات کو","tr":"laylahā"},{"ar":"وَأَخْرَجَ","en":"and brought out","ur":"اور نکالا","tr":"wa-akhraja"},{"ar":"ضُحَىٰهَا","en":"its brightness","ur":"اس کی دھوپ کو/ اس کے دن کو/ اگلا پہر","tr":"ḍuḥāhā"}],"79:30":[{"ar":"وَٱلْأَرْضَ","en":"And the earth","ur":"اور زمین کو","tr":"wal-arḍa"},{"ar":"بَعْدَ","en":"after","ur":"بعد","tr":"baʿda"},{"ar":"ذَٰلِكَ","en":"that","ur":"اس کے","tr":"dhālika"},{"ar":"دَحَىٰهَآ","en":"He spread it","ur":"اس نے بچھا دیا","tr":"daḥāhā"}],"79:31":[{"ar":"أَخْرَجَ","en":"He brought forth","ur":"اس نے نکالا","tr":"akhraja"},{"ar":"مِنْهَا","en":"from it","ur":"اس سے","tr":"min'hā"},{"ar":"مَآءَهَا","en":"its water","ur":"اس کا پانی","tr":"māahā"},{"ar":"وَمَرْعَىٰهَا","en":"and its pasture","ur":"اور اس کا چارہ","tr":"wamarʿāhā"}],"79:32":[{"ar":"وَٱلْجِبَالَ","en":"And the mountains","ur":"اور پہاڑوں کو","tr":"wal-jibāla"},{"ar":"أَرْسَىٰهَا","en":"He made them firm","ur":"اس نے گاڑ دیا ان کو","tr":"arsāhā"}],"79:33":[{"ar":"مَتَـٰعًۭا","en":"(As) a provision","ur":"فائدے کی چیزیں/ فائدے کا سامان","tr":"matāʿan"},{"ar":"لَّكُمْ","en":"for you","ur":"واسطے تمہارے","tr":"lakum"},{"ar":"وَلِأَنْعَـٰمِكُمْ","en":"and for your cattle","ur":"اور تمہارے مویشیوں کے لئے","tr":"wali-anʿāmikum"}],"79:34":[{"ar":"فَإِذَا","en":"But when","ur":"پھر جب","tr":"fa-idhā"},{"ar":"جَآءَتِ","en":"comes","ur":"آجائے گی","tr":"jāati"},{"ar":"ٱلطَّآمَّةُ","en":"the Overwhelming Calamity","ur":"آفت","tr":"l-ṭāmatu"},{"ar":"ٱلْكُبْرَىٰ","en":"the great","ur":"بڑی","tr":"l-kub'rā"}],"79:35":[{"ar":"يَوْمَ","en":"(The) Day","ur":"اس دن","tr":"yawma"},{"ar":"يَتَذَكَّرُ","en":"will remember","ur":"یاد کرے گا","tr":"yatadhakkaru"},{"ar":"ٱلْإِنسَـٰنُ","en":"man","ur":"انسان","tr":"l-insānu"},{"ar":"مَا","en":"what","ur":"جو","tr":"mā"},{"ar":"سَعَىٰ","en":"he strove (for)","ur":"اس نے کوشش کی","tr":"saʿā"}],"79:36":[{"ar":"وَبُرِّزَتِ","en":"And will be made manifest","ur":"اور کھول دی جائے گی/ ظاہر کردی جائے گی","tr":"waburrizati"},{"ar":"ٱلْجَحِيمُ","en":"the Hellfire","ur":"جہنم","tr":"l-jaḥīmu"},{"ar":"لِمَن","en":"to (him) who","ur":"واسطے اس کے جو","tr":"liman"},{"ar":"يَرَىٰ","en":"sees","ur":"دیکھتا ہو","tr":"yarā"}],"79:37":[{"ar":"فَأَمَّا","en":"Then as for","ur":"تو رہا","tr":"fa-ammā"},{"ar":"مَن","en":"(him) who","ur":"وہ جس نے","tr":"man"},{"ar":"طَغَىٰ","en":"transgressed","ur":"سرکشی کی","tr":"ṭaghā"}],"79:38":[{"ar":"وَءَاثَرَ","en":"And preferred","ur":"اور ترجیح دی","tr":"waāthara"},{"ar":"ٱلْحَيَوٰةَ","en":"the life","ur":"زندگی کو","tr":"l-ḥayata"},{"ar":"ٱلدُّنْيَا","en":"(of) the world","ur":"دنیا کی","tr":"l-dun'yā"}],"79:39":[{"ar":"فَإِنَّ","en":"Then indeed","ur":"تو بیشک","tr":"fa-inna"},{"ar":"ٱلْجَحِيمَ","en":"the Hellfire","ur":"جہنم ہی","tr":"l-jaḥīma"},{"ar":"هِىَ","en":"it","ur":"وہ","tr":"hiya"},{"ar":"ٱلْمَأْوَىٰ","en":"(is) the refuge","ur":"ٹھکانہ ہوگی","tr":"l-mawā"}],"79:40":[{"ar":"وَأَمَّا","en":"But as for","ur":"اور رہا","tr":"wa-ammā"},{"ar":"مَنْ","en":"(him) who","ur":"وہ جو","tr":"man"},{"ar":"خَافَ","en":"feared","ur":"ڈرا","tr":"khāfa"},{"ar":"مَقَامَ","en":"standing","ur":"کھڑے ہونے سے","tr":"maqāma"},{"ar":"رَبِّهِۦ","en":"(before) his Lord","ur":"اپنے رب کے سامنے","tr":"rabbihi"},{"ar":"وَنَهَى","en":"and restrained","ur":"اور روکا اس نے","tr":"wanahā"},{"ar":"ٱلنَّفْسَ","en":"his soul","ur":"نفس کو","tr":"l-nafsa"},{"ar":"عَنِ","en":"from","ur":"سے","tr":"ʿani"},{"ar":"ٱلْهَوَىٰ","en":"the vain desires","ur":"خواہشات (سے)","tr":"l-hawā"}],"79:41":[{"ar":"فَإِنَّ","en":"Then indeed","ur":"تو یقیناً","tr":"fa-inna"},{"ar":"ٱلْجَنَّةَ","en":"Paradise","ur":"جنت ہی","tr":"l-janata"},{"ar":"هِىَ","en":"it (is)","ur":"وہ","tr":"hiya"},{"ar":"ٱلْمَأْوَىٰ","en":"the refuge","ur":"ٹھکانہ ہوگی","tr":"l-mawā"}],"79:42":[{"ar":"يَسْـَٔلُونَكَ","en":"They ask you","ur":"وہ سوال کرتے ہیں آپ سے","tr":"yasalūnaka"},{"ar":"عَنِ","en":"about","ur":"بارے میں","tr":"ʿani"},{"ar":"ٱلسَّاعَةِ","en":"the Hour","ur":"قیامت کے","tr":"l-sāʿati"},{"ar":"أَيَّانَ","en":"when","ur":"کب ہے","tr":"ayyāna"},{"ar":"مُرْسَىٰهَا","en":"(is) its arrival","ur":"ٹھہرنا اس کا","tr":"mur'sāhā"}],"79:43":[{"ar":"فِيمَ","en":"In what","ur":"کس (فکر) میں ہیں","tr":"fīma"},{"ar":"أَنتَ","en":"(are) you","ur":"تو","tr":"anta"},{"ar":"مِن","en":"[of]","ur":"سے","tr":"min"},{"ar":"ذِكْرَىٰهَآ","en":"(to) mention it","ur":"اس کے ذکر سے","tr":"dhik'rāhā"}],"79:44":[{"ar":"إِلَىٰ","en":"To","ur":"طرف","tr":"ilā"},{"ar":"رَبِّكَ","en":"your Lord","ur":"تیرے رب کی","tr":"rabbika"},{"ar":"مُنتَهَىٰهَآ","en":"(is) its finality","ur":"اس کی انتہاء ہے","tr":"muntahāhā"}],"79:45":[{"ar":"إِنَّمَآ","en":"Only","ur":"بیشک","tr":"innamā"},{"ar":"أَنتَ","en":"you","ur":"تو","tr":"anta"},{"ar":"مُنذِرُ","en":"(are) a warner","ur":"خبردار کرنے والا ہے","tr":"mundhiru"},{"ar":"مَن","en":"(for him) who","ur":"اس کو جو","tr":"man"},{"ar":"يَخْشَىٰهَا","en":"fears it","ur":"ڈرتا ہو اس سے","tr":"yakhshāhā"}],"79:46":[{"ar":"كَأَنَّهُمْ","en":"As though they","ur":"گویا کہ وہ","tr":"ka-annahum"},{"ar":"يَوْمَ","en":"(the) Day","ur":"جس دن","tr":"yawma"},{"ar":"يَرَوْنَهَا","en":"they see it","ur":"وہ دیکھ لیں گے اس کو ( تو کہیں گے گویا کہ)","tr":"yarawnahā"},{"ar":"لَمْ","en":"not","ur":"نہیں","tr":"lam"},{"ar":"يَلْبَثُوٓا۟","en":"they had remained","ur":"وہ ٹھہرے","tr":"yalbathū"},{"ar":"إِلَّا","en":"except","ur":"مگر","tr":"illā"},{"ar":"عَشِيَّةً","en":"an evening","ur":"شام کا وقت","tr":"ʿashiyyatan"},{"ar":"أَوْ","en":"or","ur":"یا","tr":"aw"},{"ar":"ضُحَىٰهَا","en":"a morning thereof","ur":"اس کی صبح","tr":"ḍuḥāhā"}]}
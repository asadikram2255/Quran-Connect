{"79:1":[{"ar":"وَٱلنَّـٰزِعَـٰتِ","en":"By those who extract","ur":"قسم ہے ان فرشتوں کی جو کھینچنے والے ہیں","tr":"wal-nāziʿāti"},{"ar":"غَرْقًۭا","en":"violently","ur":"غرق ہوکر/ ڈوب کر","tr":"gharqan"}],"79:2":[{"ar":"وَٱلنَّـٰشِطَـٰتِ","en":"And those who draw out","ur":"قسم ہے ان فرشتوں کی جو آسانی سے نکالنے والے ہیں","tr":"wal-nāshiṭāti"},{"ar":"نَشْطًۭا","en":"gently","ur":"نکال لینا","tr":"nashṭan"}],"79:3":[{"ar":"وَٱلسَّـٰبِحَـٰتِ","en":"And those who glide","ur":"قسم ہے ان فرشتوں کی جو تیرنے والے ہیں","tr":"wal-sābiḥāti"},{"ar":"سَبْحًۭا","en":"swimming","ur":"تیرنا","tr":"sabḥan"}],"79:4":[{"ar":"فَٱلسَّـٰبِقَـٰتِ","en":"And those who race each other","ur":"پھر آگے بڑھنے والوں کی/ سبقت کرنے والوں کی","tr":"fal-sābiqāti"},{"ar":"سَبْقًۭا","en":"(in) a race","ur":"سبقت کرنا/ آگے بڑھنا","tr":"sabqan"}],"79:5":[{"ar":"فَٱلْمُدَبِّرَٰتِ","en":"And those who arrange","ur":"پھر تدبیر کرنے والوں کی","tr":"fal-mudabirāti"},{"ar":"أَمْرًۭا","en":"(the) matter","ur":"کام میں/ کام کی","tr":"amran"}],"79:6":[{"ar":"يَوْمَ","en":"(The) Day","ur":"جس دن","tr":"yawma"},{"ar":"تَرْجُفُ","en":"will quake","ur":"کانپے گی","tr":"tarjufu"},{"ar":"ٱلرَّاجِفَةُ","en":"the quaking one","ur":"کانپنے والی","tr":"l-rājifatu"}],"79:7":[{"ar":"تَتْبَعُهَا","en":"Follows it","ur":"پیچھے آئے گی اس کے","tr":"tatbaʿuhā"},{"ar":"ٱلرَّادِفَةُ","en":"the subsequent","ur":"پیچھے آنے والی","tr":"l-rādifatu"}],"79:8":[{"ar":"قُلُوبٌۭ","en":"Hearts","ur":"کچھ دل","tr":"qulūbun"},{"ar":"يَوْمَئِذٍۢ","en":"that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"وَاجِفَةٌ","en":"will palpitate","ur":"دھڑکنے والے ہیں/ ہوں گے","tr":"wājifatun"}],"79:9":[{"ar":"أَبْصَـٰرُهَا","en":"Their eyes","ur":"نگاہیں ان کی","tr":"abṣāruhā"},{"ar":"خَـٰشِعَةٌۭ","en":"humbled","ur":"دبی ہوئی ہوں گی/ سہمی ہوئی ہوں گی","tr":"khāshiʿatun"}],"79:10":[{"ar":"يَقُولُونَ","en":"They say","ur":"کہتے ہیں","tr":"yaqūlūna"},{"ar":"أَءِنَّا","en":"Will we","ur":"کیا بیشک ہم","tr":"a-innā"},{"ar":"لَمَرْدُودُونَ","en":"indeed be r
{"50:1":[{"ar":"قٓ ۚ","en":"Qaf","ur":"ق","tr":"qaf"},{"ar":"وَٱلْقُرْءَانِ","en":"By the Quran","ur":"قسم ہے قرآن کی","tr":"wal-qur'āni"},{"ar":"ٱلْمَجِيدِ","en":"the Glorious","ur":"مجید-بزرگی والے","tr":"l-majīdi"}],"50:2":[{"ar":"بَلْ","en":"Nay","ur":"بلکہ","tr":"bal"},{"ar":"عَجِبُوٓا۟","en":"they wonder","ur":"انہیں تعجب ہوا","tr":"ʿajibū"},{"ar":"أَن","en":"that","ur":"کہ","tr":"an"},{"ar":"جَآءَهُم","en":"has come to them","ur":"آگیا ان کے پاس","tr":"jāahum"},{"ar":"مُّنذِرٌۭ","en":"a warner","ur":"ایک ڈرانے والا","tr":"mundhirun"},{"ar":"مِّنْهُمْ","en":"from them","ur":"ان میں سے","tr":"min'hum"},{"ar":"فَقَالَ","en":"So say","ur":"تو کہا","tr":"faqāla"},{"ar":"ٱلْكَـٰفِرُونَ","en":"the disbelievers","ur":"کافروں نے","tr":"l-kāfirūna"},{"ar":"هَـٰذَا","en":"This","ur":"یہ","tr":"hādhā"},{"ar":"شَىْءٌ","en":"(is) a thing","ur":"ایک چیز ہے","tr":"shayon"},{"ar":"عَجِيبٌ","en":"amazing","ur":"بہت ہی عجیب","tr":"ʿajībun"}],"50:3":[{"ar":"أَءِذَا","en":"What! When","ur":"کیا جب","tr":"a-idhā"},{"ar":"مِتْنَا","en":"we die","ur":"ہم مرجائیں گے","tr":"mit'nā"},{"ar":"وَكُنَّا","en":"and have become","ur":"اور ہم ہوجائیں گے","tr":"wakunnā"},{"ar":"تُرَابًۭا ۖ","en":"dust","ur":"مٹی","tr":"turāban"},{"ar":"ذَٰلِكَ","en":"That","ur":"یہ","tr":"dhālika"},{"ar":"رَجْعٌۢ","en":"(is) a return","ur":"پلٹنا۔ پھر آنا","tr":"rajʿun"},{"ar":"بَعِيدٌۭ","en":"far","ur":"دور کا ہے۔ ناممکن ہے","tr":"baʿīdun"}],"50:4":[{"ar":"قَدْ","en":"Certainly","ur":"تحقیق","tr":"qad"},{"ar":"عَلِمْنَا","en":"We know","ur":"ہم نے جان لیا","tr":"ʿalim'nā"},{"ar":"مَا","en":"what","ur":"اس کا بھی جو","tr":"mā"},{"ar":"تَنقُصُ","en":"diminishes","ur":"کمی کرتی ہے","tr":"tanquṣu"},{"ar":"ٱلْأَرْضُ","en":"the earth","ur":"زمین","tr":"l-arḍu"},{"ar":"مِنْهُمْ ۖ","en":"of them","ur":"ان میں سے","tr":"min'hum"},{"ar":"وَعِندَنَا","en":"and with Us","ur":"اور ہمارے پاس","tr":"waʿindanā"},{"ar":"كِتَـٰبٌ","en":"(is) a Book","ur":"ایک کتاب ہے","tr":"kitābun"},{"ar":"حَفِيظٌۢ","en":"guarded","ur":"محفو
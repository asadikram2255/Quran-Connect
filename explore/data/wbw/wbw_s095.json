{"95:1":[{"ar":"وَٱلتِّينِ","en":"By the fig","ur":"قسم ہے تین (انجیر) کی","tr":"wal-tīni"},{"ar":"وَٱلزَّيْتُونِ","en":"and the olive","ur":"اور زیتون کی","tr":"wal-zaytūni"}],"95:2":[{"ar":"وَطُورِ","en":"And (the) Mount","ur":"اور طور","tr":"waṭūri"},{"ar":"سِينِينَ","en":"Sinai","ur":"سینا کی","tr":"sīnīna"}],"95:3":[{"ar":"وَهَـٰذَا","en":"And this","ur":"اور قسم ہے اس","tr":"wahādhā"},{"ar":"ٱلْبَلَدِ","en":"[the] city","ur":"شہر کی","tr":"l-baladi"},{"ar":"ٱلْأَمِينِ","en":"[the] secure","ur":"جو پر امن ہے","tr":"l-amīni"}],"95:4":[{"ar":"لَقَدْ","en":"Indeed","ur":"البتہ تحقیق","tr":"laqad"},{"ar":"خَلَقْنَا","en":"We created","ur":"پیدا کیا ہم نے","tr":"khalaqnā"},{"ar":"ٱلْإِنسَـٰنَ","en":"man","ur":"انسان کو","tr":"l-insāna"},{"ar":"فِىٓ","en":"in","ur":"میں","tr":"fī"},{"ar":"أَحْسَنِ","en":"(the) best","ur":"بہترین","tr":"aḥsani"},{"ar":"تَقْوِيمٍۢ","en":"mould","ur":"ساخت پر","tr":"taqwīmin"}],"95:5":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"رَدَدْنَـٰهُ","en":"We returned him","ur":"پھیر دیا ہم نے اس کو","tr":"radadnāhu"},{"ar":"أَسْفَلَ","en":"(to the) lowest","ur":"سب سے زیادہ نچلا/نیچے","tr":"asfala"},{"ar":"سَـٰفِلِينَ","en":"(of the) low","ur":"نچلوں میں سے/ نیچوں میں سے","tr":"sāfilīna"}],"95:6":[{"ar":"إِلَّا","en":"Except","ur":"مگر","tr":"illā"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے عمل کئے","tr":"waʿamilū"},{"ar":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے","tr":"l-ṣāliḥāti"},{"ar":"فَلَهُمْ","en":"then for them","ur":"تو ان کے لئے","tr":"falahum"},{"ar":"أَجْرٌ","en":"(is a) reward","ur":"اجر ہے","tr":"ajrun"},{"ar":"غَيْرُ","en":"never","ur":"نہ","tr":"ghayru"},{"ar":"مَمْنُونٍۢ","en":"ending","ur":"ختم ہونے والا","tr":"mamnūnin"}],"95:7":[{"ar":"فَمَا","en":"Then what","ur":"تو کون","tr":"famā"},{"ar":"يُكَذِّبُكَ","en":"causes you to deny","ur":"جھٹلائے گا تجھ کو","tr":"yukadhibuka"},{"ar":"بَعْدُ","en":"after (this)","ur":"بعد","tr":"baʿdu"},{"ar":"بِٱلدِّينِ","en":"the judgment","ur":"جزا سزا کے","tr":"bil-dīni"}],"95:8":[{"ar":"أَلَيْسَ","en":"Is not","ur":"کیا نہیں ہے","tr":"alaysa"},{"ar":"ٱللَّهُ","en":"Allah","ur":"اللہ","tr":"l-lahu"},{"ar":"بِأَحْكَمِ","en":"(the) Most Just","ur":"سب فیصلہ کرنے والوں میں بڑھ کر","tr":"bi-aḥkami"},{"ar":"ٱلْحَـٰكِمِينَ","en":"(of) the Judges","ur":"فیصلہ کرنے والا","tr":"l-ḥākimīna"}]}
{"49:1":[{"ar":"يَـٰٓأَيُّهَا","en":"O you who believe","ur":"اے","tr":"yāayyuhā"},{"ar":"ٱلَّذِينَ","en":"O you who believe","ur":"لوگو !","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"O you who believe","ur":"جو ایمان لائے ہو","tr":"āmanū"},{"ar":"لَا","en":"(Do) not","ur":"نہ","tr":"lā"},{"ar":"تُقَدِّمُوا۟","en":"put (yourselves) forward","ur":"تم پیش قدمی کرو۔  آگے بڑھو","tr":"tuqaddimū"},{"ar":"بَيْنَ","en":"before Allah","ur":"","tr":"bayna"},{"ar":"يَدَىِ","en":"before Allah","ur":"آگے","tr":"yadayi"},{"ar":"ٱللَّهِ","en":"before Allah","ur":"اللہ کے","tr":"l-lahi"},{"ar":"وَرَسُولِهِۦ ۖ","en":"and His Messenger","ur":"اور اس کے رسول کے","tr":"warasūlihi"},{"ar":"وَٱتَّقُوا۟","en":"and fear Allah","ur":"اور ڈرو","tr":"wa-ittaqū"},{"ar":"ٱللَّهَ ۚ","en":"and fear Allah","ur":"اللہ سے","tr":"l-laha"},{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ","tr":"l-laha"},{"ar":"سَمِيعٌ","en":"(is) All-Hearer","ur":"سننے والا ہے","tr":"samīʿun"},{"ar":"عَلِيمٌۭ","en":"All-Knower","ur":"جاننے والا","tr":"ʿalīmun"}],"49:2":[{"ar":"يَـٰٓأَيُّهَا","en":"O you who believe","ur":"اے","tr":"yāayyuhā"},{"ar":"ٱلَّذِينَ","en":"O you who believe","ur":"لوگو","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"O you who believe","ur":"جو ایمان لائے ہو","tr":"āmanū"},{"ar":"لَا","en":"(Do) not","ur":"نہ","tr":"lā"},{"ar":"تَرْفَعُوٓا۟","en":"raise","ur":"بلند کرو","tr":"tarfaʿū"},{"ar":"أَصْوَٰتَكُمْ","en":"your voices","ur":"اپنی آوازوں کو","tr":"aṣwātakum"},{"ar":"فَوْقَ","en":"above","ur":"پر","tr":"fawqa"},{"ar":"صَوْتِ","en":"(the) voice","ur":"آواز پر","tr":"ṣawti"},{"ar":"ٱلنَّبِىِّ","en":"(of) the Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم) کی","tr":"l-nabiyi"},{"ar":"وَلَا","en":"and (do) not","ur":"اور نہ","tr":"walā"},{"ar":"تَجْهَرُوا۟","en":"be loud","ur":"بلند کرو","tr":"tajharū"},{"ar":"لَهُۥ","en":"to him","ur":"اس کے لیے","tr":"lahu"},{"ar":"بِٱلْقَوْلِ","en":"in speech","ur":"بات کو","tr":"bil-qawli"},{"ar":"كَجَهْرِ","en"
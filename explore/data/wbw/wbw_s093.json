{"93:1":[{"ar":"وَٱلضُّحَىٰ","en":"By the morning brightness","ur":"قسم ہے روز روشن کی","tr":"wal-ḍuḥā"}],"93:2":[{"ar":"وَٱلَّيْلِ","en":"And the night","ur":"اور رات کی","tr":"wa-al-layli"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"سَجَىٰ","en":"it covers with darkness","ur":"وہ ڈھانپ لے","tr":"sajā"}],"93:3":[{"ar":"مَا","en":"Not","ur":"نہیں","tr":"mā"},{"ar":"وَدَّعَكَ","en":"has forsaken you","ur":"چھوڑا تجھ کو","tr":"waddaʿaka"},{"ar":"رَبُّكَ","en":"your Lord","ur":"تیرے رب نے","tr":"rabbuka"},{"ar":"وَمَا","en":"and not","ur":"اور نہ","tr":"wamā"},{"ar":"قَلَىٰ","en":"He is displeased","ur":"وہ ناراض ہوا","tr":"qalā"}],"93:4":[{"ar":"وَلَلْـَٔاخِرَةُ","en":"And surely the Hereafter","ur":"اور البتہ آخرت/ انجام","tr":"walalākhiratu"},{"ar":"خَيْرٌۭ","en":"(is) better","ur":"بہتر ہے","tr":"khayrun"},{"ar":"لَّكَ","en":"for you","ur":"تیرے لئے","tr":"laka"},{"ar":"مِنَ","en":"than","ur":"سے","tr":"mina"},{"ar":"ٱلْأُولَىٰ","en":"the first","ur":"آغاز سے/ ابتداء سے","tr":"l-ūlā"}],"93:5":[{"ar":"وَلَسَوْفَ","en":"And soon","ur":"اور البتہ عنقریب","tr":"walasawfa"},{"ar":"يُعْطِيكَ","en":"will give you","ur":"عطا کرے گا تجھ کو","tr":"yuʿ'ṭīka"},{"ar":"رَبُّكَ","en":"your Lord","ur":"تیرا رب","tr":"rabbuka"},{"ar":"فَتَرْضَىٰٓ","en":"then you will be satisfied","ur":"تو تو راضی ہوجائے گا/ خوش ہوجائے گا","tr":"fatarḍā"}],"93:6":[{"ar":"أَلَمْ","en":"Did not","ur":"کیا نہیں","tr":"alam"},{"ar":"يَجِدْكَ","en":"He find you","ur":"پایا تجھ کو","tr":"yajid'ka"},{"ar":"يَتِيمًۭا","en":"an orphan","ur":"یتیم","tr":"yatīman"},{"ar":"فَـَٔاوَىٰ","en":"and give shelter","ur":"پھر اس نے ٹھکانہ فراہم کیا","tr":"faāwā"}],"93:7":[{"ar":"وَوَجَدَكَ","en":"And He found you","ur":"اور پایا تجھ کو","tr":"wawajadaka"},{"ar":"ضَآلًّۭا","en":"lost","ur":"راہ بھولا","tr":"ḍāllan"},{"ar":"فَهَدَىٰ","en":"so He guided","ur":"تو اس نے ہدایت بخشی/ رہنمائی کی","tr":"fahadā"}],"93:8":[{"ar":"وَوَجَدَكَ","en":"And He found you","ur":"اور پایا تجھ کو","tr":"wawajadaka"},{"ar":"عَآئِلًۭا","en":"in need","ur":"مفلس","tr":"ʿāilan"},{"ar":"فَأَغْنَىٰ","en":"so He made self-sufficient","ur":"تو اس نے غنی کردیا","tr":"fa-aghnā"}],"93:9":[{"ar":"فَأَمَّا","en":"So as for","ur":"تو رہا","tr":"fa-ammā"},{"ar":"ٱلْيَتِيمَ","en":"the orphan","ur":"یتیم","tr":"l-yatīma"},{"ar":"فَلَا","en":"then (do) not","ur":"پس نہ","tr":"falā"},{"ar":"تَقْهَرْ","en":"oppress","ur":"سختی کر","tr":"taqhar"}],"93:10":[{"ar":"وَأَمَّا","en":"And as for","ur":"اور رہا","tr":"wa-ammā"},{"ar":"ٱلسَّآئِلَ","en":"one who asks","ur":"سوالی","tr":"l-sāila"},{"ar":"فَلَا","en":"then (do) not","ur":"پس نہ","tr":"falā"},{"ar":"تَنْهَرْ","en":"repel","ur":"جھڑکو","tr":"tanhar"}],"93:11":[{"ar":"وَأَمَّا","en":"But as for","ur":"اور رہی","tr":"wa-ammā"},{"ar":"بِنِعْمَةِ","en":"(the) Favor","ur":"نعمت","tr":"biniʿ'mati"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کی","tr":"rabbika"},{"ar":"فَحَدِّثْ","en":"narrate","ur":"پس بیان کرو","tr":"faḥaddith"}]}
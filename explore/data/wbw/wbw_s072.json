:[{"ar":"وَأَنَّا","en":"And that we","ur":"اور بیشک ہم","tr":"wa-annā"},{"ar":"لَا","en":"not","ur":"نہیں","tr":"lā"},{"ar":"نَدْرِىٓ","en":"we know","ur":"ہم جانتے","tr":"nadrī"},{"ar":"أَشَرٌّ","en":"whether evil","ur":"کیا شر","tr":"asharrun"},{"ar":"أُرِيدَ","en":"is intended","ur":"ارادہ کیا گیا","tr":"urīda"},{"ar":"بِمَن","en":"for (those) who","ur":"ساتھ ان کے","tr":"biman"},{"ar":"فِى","en":"(are) in","ur":"جو  میں ہیں","tr":"fī"},{"ar":"ٱلْأَرْضِ","en":"the earth","ur":"زمین","tr":"l-arḍi"},{"ar":"أَمْ","en":"or","ur":"یا","tr":"am"},{"ar":"أَرَادَ","en":"intends","ur":"ارادہ کیا","tr":"arāda"},{"ar":"بِهِمْ","en":"for them","ur":"ساتھ ان کے","tr":"bihim"},{"ar":"رَبُّهُمْ","en":"their Lord","ur":"ان کے رب نے","tr":"rabbuhum"},{"ar":"رَشَدًۭا","en":"a right path","ur":"بھلائی کا","tr":"rashadan"}],"72:11":[{"ar":"وَأَنَّا","en":"And that [we]","ur":"اور بیشک ہم","tr":"wa-annā"},{"ar":"مِنَّا","en":"among us","ur":"ہم میں سے","tr":"minnā"},{"ar":"ٱلصَّـٰلِحُونَ","en":"(are) the righteous","ur":"نیک لوگ ہیں","tr":"l-ṣāliḥūna"},{"ar":"وَمِنَّا","en":"and among us","ur":"اور ہم میں سے","tr":"waminnā"},{"ar":"دُونَ","en":"(are) other than","ur":"علاوہ ہیں","tr":"dūna"},{"ar":"ذَٰلِكَ ۖ","en":"that","ur":"اس کے","tr":"dhālika"},{"ar":"كُنَّا","en":"We","ur":"ہیں ہم","tr":"kunnā"},{"ar":"طَرَآئِقَ","en":"(are on) ways","ur":"طریقوں میں","tr":"ṭarāiqa"},{"ar":"قِدَدًۭا","en":"different","ur":"مختلف","tr":"qidadan"}],"72:12":[{"ar":"وَأَنَّا","en":"And that we","ur":"اور بیشک ہم","tr":"wa-annā"},{"ar":"ظَنَنَّآ","en":"[we] have become certain","ur":"سمجھتے تھے ہم","tr":"ẓanannā"},{"ar":"أَن","en":"that","ur":"کہ","tr":"an"},{"ar":"لَّن","en":"never","ur":"ہرگز نہیں","tr":"lan"},{"ar":"نُّعْجِزَ","en":"we will cause failure","ur":"ہم عاجز کرسکتے","tr":"nuʿ'jiza"},{"ar":"ٱللَّهَ","en":"(to) Allah","ur":"اللہ کو","tr":"l-laha"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"ٱلْأَرْضِ","en":"the earth","ur":"زمین","tr":"l-arḍi"},{"ar":"وَلَن","en":"and never","u
{"72:1":[{"ar":"قُلْ","en":"Say","ur":"کہہ دیجیے","tr":"qul"},{"ar":"أُوحِىَ","en":"It has been revealed","ur":"وحی کی گئی","tr":"ūḥiya"},{"ar":"إِلَىَّ","en":"to me","ur":"میری طرف","tr":"ilayya"},{"ar":"أَنَّهُ","en":"that","ur":"بیشک","tr":"annahu"},{"ar":"ٱسْتَمَعَ","en":"listened","ur":"غور سے سنا","tr":"is'tamaʿa"},{"ar":"نَفَرٌۭ","en":"a group","ur":"ایک گروہ نے","tr":"nafarun"},{"ar":"مِّنَ","en":"of","ur":"میں سے","tr":"mina"},{"ar":"ٱلْجِنِّ","en":"the jinn","ur":"جنوں","tr":"l-jini"},{"ar":"فَقَالُوٓا۟","en":"and they said","ur":"تو انہوں نے کہا","tr":"faqālū"},{"ar":"إِنَّا","en":"Indeed, we","ur":"بیشک ہم","tr":"innā"},{"ar":"سَمِعْنَا","en":"heard","ur":"سنا ہم نے","tr":"samiʿ'nā"},{"ar":"قُرْءَانًا","en":"a Quran","ur":"ایک قرآن","tr":"qur'ānan"},{"ar":"عَجَبًۭا","en":"amazing","ur":"عجیب","tr":"ʿajaban"}],"72:2":[{"ar":"يَهْدِىٓ","en":"It guides","ur":"رہنمائی کرتا ہے","tr":"yahdī"},{"ar":"إِلَى","en":"to","ur":"طرف","tr":"ilā"},{"ar":"ٱلرُّشْدِ","en":"the right way","ur":"ہدایت کی","tr":"l-rush'di"},{"ar":"فَـَٔامَنَّا","en":"so we believe","ur":"پس ایمان لائے ہم","tr":"faāmannā"},{"ar":"بِهِۦ ۖ","en":"in it","ur":"ساتھ اس کے","tr":"bihi"},{"ar":"وَلَن","en":"and never","ur":"اور ہرگز نہیں","tr":"walan"},{"ar":"نُّشْرِكَ","en":"we will associate","ur":"ہم شریک کریں گے","tr":"nush'rika"},{"ar":"بِرَبِّنَآ","en":"with our Lord","ur":"اپنے رب کے ساتھ","tr":"birabbinā"},{"ar":"أَحَدًۭا","en":"anyone","ur":"کسی ایک کو","tr":"aḥadan"}],"72:3":[{"ar":"وَأَنَّهُۥ","en":"And that He","ur":"اور بیشک وہ","tr":"wa-annahu"},{"ar":"تَعَـٰلَىٰ","en":"Exalted is","ur":"بلند ہے","tr":"taʿālā"},{"ar":"جَدُّ","en":"(the) Majesty","ur":"شان","tr":"jaddu"},{"ar":"رَبِّنَا","en":"(of) our Lord","ur":"ہمارے رب کی","tr":"rabbinā"},{"ar":"مَا","en":"not","ur":"نہیں","tr":"mā"},{"ar":"ٱتَّخَذَ","en":"He has taken","ur":"بنائی اس نے","tr":"ittakhadha"},{"ar":"صَـٰحِبَةًۭ","en":"a wife","ur":"کوئی بیوی","tr":"ṣāḥibatan"},{"ar":"وَلَا","en":"and not","ur":"اور نہ کوئی","tr":"w
{"112:1":[{"ar":"قُلْ","en":"Say","ur":"کہہ دیجئے","tr":"qul"},{"ar":"هُوَ","en":"He","ur":"وہ","tr":"huwa"},{"ar":"ٱللَّهُ","en":"(is) Allah","ur":"اللہ","tr":"l-lahu"},{"ar":"أَحَدٌ","en":"the One","ur":"ایک ہے","tr":"aḥadun"}],"112:2":[{"ar":"ٱللَّهُ","en":"Allah","ur":"اللہ","tr":"al-lahu"},{"ar":"ٱلصَّمَدُ","en":"the Eternal, the Absolute","ur":"بےنیاز ہے","tr":"l-ṣamadu"}],"112:3":[{"ar":"لَمْ","en":"Not","ur":"نہ","tr":"lam"},{"ar":"يَلِدْ","en":"He begets","ur":"اس نے جنا","tr":"yalid"},{"ar":"وَلَمْ","en":"and not","ur":"اور نہ","tr":"walam"},{"ar":"يُولَدْ","en":"He is begotten","ur":"وہ جنا گیا","tr":"yūlad"}],"112:4":[{"ar":"وَلَمْ","en":"And not","ur":"اور نہیں","tr":"walam"},{"ar":"يَكُن","en":"is","ur":"ہے","tr":"yakun"},{"ar":"لَّهُۥ","en":"for Him","ur":"اس کے لئے","tr":"lahu"},{"ar":"كُفُوًا","en":"equivalent","ur":"برابر کا","tr":"kufuwan"},{"ar":"أَحَدٌۢ","en":"any [one]","ur":"کوئی ایک بھی","tr":"aḥadun"}]}
{"90:1":[{"ar":"لَآ","en":"Nay","ur":"نہیں","tr":"lā"},{"ar":"أُقْسِمُ","en":"I swear","ur":"میں قسم کھاتا ہوں","tr":"uq'simu"},{"ar":"بِهَـٰذَا","en":"by this","ur":"اس","tr":"bihādhā"},{"ar":"ٱلْبَلَدِ","en":"city","ur":"شہر کی","tr":"l-baladi"}],"90:2":[{"ar":"وَأَنتَ","en":"And you","ur":"اور تو","tr":"wa-anta"},{"ar":"حِلٌّۢ","en":"(are) free (to dwell)","ur":"حلال ہے/ داخل ہونے والا ہے","tr":"ḥillun"},{"ar":"بِهَـٰذَا","en":"in this","ur":"اس","tr":"bihādhā"},{"ar":"ٱلْبَلَدِ","en":"city","ur":"شہر میں","tr":"l-baladi"}],"90:3":[{"ar":"وَوَالِدٍۢ","en":"And the begetter","ur":"اور قسم ہے والد کی/ باپ کی","tr":"wawālidin"},{"ar":"وَمَا","en":"and what","ur":"اس کی جو","tr":"wamā"},{"ar":"وَلَدَ","en":"he begot","ur":"اس نے جنم دیا","tr":"walada"}],"90:4":[{"ar":"لَقَدْ","en":"Certainly","ur":"البتہ تحقیق","tr":"laqad"},{"ar":"خَلَقْنَا","en":"We have created","ur":"پیدا کیا ہم نے","tr":"khalaqnā"},{"ar":"ٱلْإِنسَـٰنَ","en":"man","ur":"انسان کو","tr":"l-insāna"},{"ar":"فِى","en":"(to be) in","ur":"میں","tr":"fī"},{"ar":"كَبَدٍ","en":"hardship","ur":"محنت میں/ سختی میں","tr":"kabadin"}],"90:5":[{"ar":"أَيَحْسَبُ","en":"Does he think","ur":"کیا وہ سمجھتا ہے","tr":"ayaḥsabu"},{"ar":"أَن","en":"that","ur":"کہ ہرگز","tr":"an"},{"ar":"لَّن","en":"not","ur":"نہیں","tr":"lan"},{"ar":"يَقْدِرَ","en":"has power","ur":"قادر ہوسکے گا/ قابو پاسکے گا","tr":"yaqdira"},{"ar":"عَلَيْهِ","en":"over him","ur":"اس پر","tr":"ʿalayhi"},{"ar":"أَحَدٌۭ","en":"anyone","ur":"کوئی ایک","tr":"aḥadun"}],"90:6":[{"ar":"يَقُولُ","en":"He will say","ur":"وہ کہتا ہے","tr":"yaqūlu"},{"ar":"أَهْلَكْتُ","en":"I have squandered","ur":"میں نے ہلاک کیا","tr":"ahlaktu"},{"ar":"مَالًۭا","en":"wealth","ur":"مال","tr":"mālan"},{"ar":"لُّبَدًا","en":"abundant","ur":"ڈھیروں","tr":"lubadan"}],"90:7":[{"ar":"أَيَحْسَبُ","en":"Does he think","ur":"کیا وہ سمجھتا ہے","tr":"ayaḥsabu"},{"ar":"أَن","en":"that","ur":"کہ","tr":"an"},{"ar":"لَّمْ","en":"not","ur":"نہیں","tr":"lam"},{"ar":"يَرَهُۥٓ","en":"sees him","ur":"دیکھا اس کو","tr":"yarahu"},{"ar":"أَحَدٌ","en":"anyone","ur":"کسی ایک نے","tr":"aḥadun"}],"90:8":[{"ar":"أَلَمْ","en":"Have not","ur":"کیا نہیں","tr":"alam"},{"ar":"نَجْعَل","en":"We made","ur":"ہم نے بنائیں","tr":"najʿal"},{"ar":"لَّهُۥ","en":"for him","ur":"اس کے لئے","tr":"lahu"},{"ar":"عَيْنَيْنِ","en":"two eyes","ur":"دو آنکھیں","tr":"ʿaynayni"}],"90:9":[{"ar":"وَلِسَانًۭا","en":"And a tongue","ur":"اور ایک زبان","tr":"walisānan"},{"ar":"وَشَفَتَيْنِ","en":"and two lips","ur":"اور دو ہونٹ","tr":"washafatayni"}],"90:10":[{"ar":"وَهَدَيْنَـٰهُ","en":"And shown him","ur":"اور راہ دکھائی ہم نے اس کو/ دکھائے ہم نے اس کو","tr":"wahadaynāhu"},{"ar":"ٱلنَّجْدَيْنِ","en":"the two ways","ur":"دو راستوں کی/ دو راستے","tr":"l-najdayni"}],"90:11":[{"ar":"فَلَا","en":"But not","ur":"پس نہ","tr":"falā"},{"ar":"ٱقْتَحَمَ","en":"he has attempted","ur":"گزرا وہ","tr":"iq'taḥama"},{"ar":"ٱلْعَقَبَةَ","en":"the steep path","ur":"پہاڑ کی گھاٹی میں","tr":"l-ʿaqabata"}],"90:12":[{"ar":"وَمَآ","en":"And what","ur":"اور کیا چیز","tr":"wamā"},{"ar":"أَدْرَىٰكَ","en":"can make you know","ur":"بتائے تجھ کو","tr":"adrāka"},{"ar":"مَا","en":"what","ur":"کہ کیا ہے","tr":"mā"},{"ar":"ٱلْعَقَبَةُ","en":"the steep path (is)","ur":"وہ دشوار گزار گھاٹی","tr":"l-ʿaqabatu"}],"90:13":[{"ar":"فَكُّ","en":"(It is) freeing","ur":"آزاد کرنا","tr":"fakku"},{"ar":"رَقَبَةٍ","en":"a neck","ur":"ایک گردن کا","tr":"raqabatin"}],"90:14":[{"ar":"أَوْ","en":"Or","ur":"یا","tr":"aw"},{"ar":"إِطْعَـٰمٌۭ","en":"feeding","ur":"کھانا کھلانا","tr":"iṭ'ʿāmun"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"يَوْمٍۢ","en":"a day","ur":"ایک دن","tr":"yawmin"},{"ar":"ذِى","en":"of","ur":"والے کو","tr":"dhī"},{"ar":"مَسْغَبَةٍۢ","en":"severe hunger","ur":"بھوک (والے کو )","tr":"masghabatin"}],"90:15":[{"ar":"يَتِيمًۭا","en":"An orphan","ur":"کسی یتیم کو","tr":"yatīman"},{"ar":"ذَا","en":"of","ur":"والے","tr":"dhā"},{"ar":"مَقْرَبَةٍ","en":"near relationship","ur":"قریبی کو/ قربت والے","tr":"maqrabatin"}],"90:16":[{"ar":"أَوْ","en":"Or","ur":"یا","tr":"aw"},{"ar":"مِسْكِينًۭا","en":"a needy person","ur":"کسی مسکین کو","tr":"mis'kīnan"},{"ar":"ذَا","en":"in","ur":"","tr":"dhā"},{"ar":"مَتْرَبَةٍۢ","en":"misery","ur":"خاک نشین کو","tr":"matrabatin"}],"90:17":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"كَانَ","en":"he is","ur":"ہوگا وہ","tr":"kāna"},{"ar":"مِنَ","en":"of","ur":"سے","tr":"mina"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں میں (سے)","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","ur":"اور انہوں نے ایک دوسرے کو تلقین کی","tr":"watawāṣaw"},{"ar":"بِٱلصَّبْرِ","en":"to patience","ur":"صبر کی","tr":"bil-ṣabri"},{"ar":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","ur":"اور ایک دوسرے کو تلقین کی","tr":"watawāṣaw"},{"ar":"بِٱلْمَرْحَمَةِ","en":"to compassion","ur":"رحم کی/ مہربانی کی","tr":"bil-marḥamati"}],"90:18":[{"ar":"أُو۟لَـٰٓئِكَ","en":"Those","ur":"یہی لوگ","tr":"ulāika"},{"ar":"أَصْحَـٰبُ","en":"(are the) companions","ur":"والے ہیں","tr":"aṣḥābu"},{"ar":"ٱلْمَيْمَنَةِ","en":"(of) the right (hand)","ur":"دائیں بازو (والے ہیں)","tr":"l-maymanati"}],"90:19":[{"ar":"وَٱلَّذِينَ","en":"But those who","ur":"اور وہ لوگ","tr":"wa-alladhīna"},{"ar":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا","tr":"kafarū"},{"ar":"بِـَٔايَـٰتِنَا","en":"in Our Verses","ur":"ہماری آیات کے ساتھ","tr":"biāyātinā"},{"ar":"هُمْ","en":"they","ur":"وہ","tr":"hum"},{"ar":"أَصْحَـٰبُ","en":"(are the) companions","ur":"والے ہیں","tr":"aṣḥābu"},{"ar":"ٱلْمَشْـَٔمَةِ","en":"(of) the left (hand)","ur":"بائیں ہاتھ (والے ہیں)","tr":"l-mashamati"}],"90:20":[{"ar":"عَلَيْهِمْ","en":"Over them","ur":"ان پر","tr":"ʿalayhim"},{"ar":"نَارٌۭ","en":"(will be the) Fire","ur":"آگ ہے","tr":"nārun"},{"ar":"مُّؤْصَدَةٌۢ","en":"closed in","ur":"بند کی ہوئی","tr":"mu'ṣadatun"}]}
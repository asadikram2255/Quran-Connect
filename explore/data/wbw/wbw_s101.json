{"101:1":[{"ar":"ٱلْقَارِعَةُ","en":"The Striking Calamity","ur":"عظیم حادثہ/ کھڑ کھڑانے والی","tr":"al-qāriʿatu"}],"101:2":[{"ar":"مَا","en":"What","ur":"کیا ہے","tr":"mā"},{"ar":"ٱلْقَارِعَةُ","en":"(is) the Striking Calamity","ur":"وہ عظیم حادثہ/ کیا ہے وہ کھڑ کھڑانے والی","tr":"l-qāriʿatu"}],"101:3":[{"ar":"وَمَآ","en":"And what","ur":"اور کیا چیز","tr":"wamā"},{"ar":"أَدْرَىٰكَ","en":"will make you know","ur":"بتائے تجھ کو","tr":"adrāka"},{"ar":"مَا","en":"what","ur":"کہ وہ کیا ہے","tr":"mā"},{"ar":"ٱلْقَارِعَةُ","en":"(is) the Striking Calamity","ur":"کھڑ کھڑانے والی / وہ عظیم حادثہ کیا ہے","tr":"l-qāriʿatu"}],"101:4":[{"ar":"يَوْمَ","en":"(The) Day","ur":"جس دن","tr":"yawma"},{"ar":"يَكُونُ","en":"will be","ur":"ہوں گے","tr":"yakūnu"},{"ar":"ٱلنَّاسُ","en":"the mankind","ur":"لوگ","tr":"l-nāsu"},{"ar":"كَٱلْفَرَاشِ","en":"like moths","ur":"ٹڈیوں کی طرح","tr":"kal-farāshi"},{"ar":"ٱلْمَبْثُوثِ","en":"scattered","ur":"بکھرے ہوئے","tr":"l-mabthūthi"}],"101:5":[{"ar":"وَتَكُونُ","en":"And will be","ur":"اور ہوں گے","tr":"watakūnu"},{"ar":"ٱلْجِبَالُ","en":"the mountains","ur":"پہاڑ","tr":"l-jibālu"},{"ar":"كَٱلْعِهْنِ","en":"like wool","ur":"رنگین روئی کی طرح","tr":"kal-ʿih'ni"},{"ar":"ٱلْمَنفُوشِ","en":"fluffed up","ur":"جو دھنی ہوئی ہو","tr":"l-manfūshi"}],"101:6":[{"ar":"فَأَمَّا","en":"Then as for","ur":"تو رہا","tr":"fa-ammā"},{"ar":"مَن","en":"(him) whose","ur":"وہ جس کے","tr":"man"},{"ar":"ثَقُلَتْ","en":"(are) heavy","ur":"بھاری ہوئے","tr":"thaqulat"},{"ar":"مَوَٰزِينُهُۥ","en":"his scales","ur":"پلڑے اس کے","tr":"mawāzīnuhu"}],"101:7":[{"ar":"فَهُوَ","en":"Then he","ur":"تو وہ","tr":"fahuwa"},{"ar":"فِى","en":"(will be) in","ur":"میں","tr":"fī"},{"ar":"عِيشَةٍۢ","en":"a life","ur":"زندگی میں ہوگا","tr":"ʿīshatin"},{"ar":"رَّاضِيَةٍۢ","en":"pleasant","ur":"پسندیدہ","tr":"rāḍiyatin"}],"101:8":[{"ar":"وَأَمَّا","en":"But as for","ur":"اور رہا","tr":"wa-ammā"},{"ar":"مَنْ","en":"(him) whose","ur":"وہ جس کے","tr":"man"},{"ar":"خَفَّتْ","en":"(are) light","ur":"ہلکے ہوئے","tr":"khaffat"},{"ar":"مَوَٰزِينُهُۥ","en":"his scales","ur":"پلڑے اس کے/ اوزان اس کے/ وزن اس کے","tr":"mawāzīnuhu"}],"101:9":[{"ar":"فَأُمُّهُۥ","en":"His abode","ur":"تو اس کی ماں","tr":"fa-ummuhu"},{"ar":"هَاوِيَةٌۭ","en":"(will be the) Pit","ur":"ہاویہ ہوگی (جہنم)","tr":"hāwiyatun"}],"101:10":[{"ar":"وَمَآ","en":"And what","ur":"اور کیا چیز","tr":"wamā"},{"ar":"أَدْرَىٰكَ","en":"will make you know","ur":"بتائے تجھ کو","tr":"adrāka"},{"ar":"مَا","en":"what","ur":"کیا","tr":"mā"},{"ar":"هِيَهْ","en":"it is","ur":"وہ  ہے","tr":"hiyah"}],"101:11":[{"ar":"نَارٌ","en":"A Fire","ur":"آگ ہے","tr":"nārun"},{"ar":"حَامِيَةٌۢ","en":"intensely hot","ur":"بھڑکتی ہوئی/دہکتی ہوئی","tr":"ḥāmiyatun"}]}
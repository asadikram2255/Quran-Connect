{"111:1":[{"ar":"تَبَّتْ","en":"Perish","ur":"ٹوٹ گئے","tr":"tabbat"},{"ar":"يَدَآ","en":"(the) hands","ur":"دونوں ہاتھ","tr":"yadā"},{"ar":"أَبِى","en":"(of) Abu","ur":"ابو","tr":"abī"},{"ar":"لَهَبٍۢ","en":"Lahab","ur":"لہب کے","tr":"lahabin"},{"ar":"وَتَبَّ","en":"and perish he","ur":"اور وہ ہلاک ہوا","tr":"watabba"}],"111:2":[{"ar":"مَآ","en":"Not","ur":"نہ","tr":"mā"},{"ar":"أَغْنَىٰ","en":"(will) avail","ur":"کام آیا","tr":"aghnā"},{"ar":"عَنْهُ","en":"him","ur":"اس کو","tr":"ʿanhu"},{"ar":"مَالُهُۥ","en":"his wealth","ur":"اس کا مال","tr":"māluhu"},{"ar":"وَمَا","en":"and what","ur":"اور جو","tr":"wamā"},{"ar":"كَسَبَ","en":"he earned","ur":"اس نے کمایا","tr":"kasaba"}],"111:3":[{"ar":"سَيَصْلَىٰ","en":"He will be burnt","ur":"عنقریب وہ داخل ہوگا","tr":"sayaṣlā"},{"ar":"نَارًۭا","en":"(in) a Fire","ur":"آگ میں","tr":"nāran"},{"ar":"ذَاتَ","en":"of","ur":"والی","tr":"dhāta"},{"ar":"لَهَبٍۢ","en":"Blazing Flames","ur":"شعلے (والی)","tr":"lahabin"}],"111:4":[{"ar":"وَٱمْرَأَتُهُۥ","en":"And his wife","ur":"اور اس کی بیوی","tr":"wa-im'ra-atuhu"},{"ar":"حَمَّالَةَ","en":"(the) carrier","ur":"اٹھانے والی","tr":"ḥammālata"},{"ar":"ٱلْحَطَبِ","en":"(of) firewood","ur":"لکڑی کے گٹھے کو","tr":"l-ḥaṭabi"}],"111:5":[{"ar":"فِى","en":"In","ur":"میں","tr":"fī"},{"ar":"جِيدِهَا","en":"her neck","ur":"اس کی گردن میں ہوگی","tr":"jīdihā"},{"ar":"حَبْلٌۭ","en":"(will be) a rope","ur":"رسی","tr":"ḥablun"},{"ar":"مِّن","en":"of","ur":"کی","tr":"min"},{"ar":"مَّسَدٍۭ","en":"palm-fiber","ur":"مونجھ کی","tr":"masadin"}]}
{"52:1":[{"ar":"وَٱلطُّورِ","en":"By the Mount","ur":"قسم ہے طور کی","tr":"wal-ṭūri"}],"52:2":[{"ar":"وَكِتَـٰبٍۢ","en":"And by (the) Book","ur":"اور کتاب کی","tr":"wakitābin"},{"ar":"مَّسْطُورٍۢ","en":"written","ur":"لکھی ہوئی","tr":"masṭūrin"}],"52:3":[{"ar":"فِى","en":"In","ur":"میں","tr":"fī"},{"ar":"رَقٍّۢ","en":"parchment","ur":"جھلی","tr":"raqqin"},{"ar":"مَّنشُورٍۢ","en":"unrolled","ur":"پھیلی ہوئی","tr":"manshūrin"}],"52:4":[{"ar":"وَٱلْبَيْتِ","en":"By the House","ur":"اور قسم ہے گھر کی","tr":"wal-bayti"},{"ar":"ٱلْمَعْمُورِ","en":"frequented","ur":"آباد","tr":"l-maʿmūri"}],"52:5":[{"ar":"وَٱلسَّقْفِ","en":"By the roof","ur":"اور چھت کی","tr":"wal-saqfi"},{"ar":"ٱلْمَرْفُوعِ","en":"raised high","ur":"جو اونچی ہے","tr":"l-marfūʿi"}],"52:6":[{"ar":"وَٱلْبَحْرِ","en":"By the sea","ur":"اور سمندر کی","tr":"wal-baḥri"},{"ar":"ٱلْمَسْجُورِ","en":"filled","ur":"جو موجزن ہے","tr":"l-masjūri"}],"52:7":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"عَذَابَ","en":"(the) punishment","ur":"عذاب","tr":"ʿadhāba"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"تیرے رب کا","tr":"rabbika"},{"ar":"لَوَٰقِعٌۭ","en":"(will) surely occur","ur":"البتہ واقع ہونے والا ہے","tr":"lawāqiʿun"}],"52:8":[{"ar":"مَّا","en":"Not","ur":"نہیں","tr":"mā"},{"ar":"لَهُۥ","en":"for it","ur":"اس کے لیے","tr":"lahu"},{"ar":"مِن","en":"any","ur":"کوئی","tr":"min"},{"ar":"دَافِعٍۢ","en":"preventer","ur":"دور کرنے والا","tr":"dāfiʿin"}],"52:9":[{"ar":"يَوْمَ","en":"(On the) Day","ur":"جس دن","tr":"yawma"},{"ar":"تَمُورُ","en":"will shake","ur":"پھٹ جائے گا۔ لرزے گا،","tr":"tamūru"},{"ar":"ٱلسَّمَآءُ","en":"the heaven","ur":"آسمان","tr":"l-samāu"},{"ar":"مَوْرًۭا","en":"(with violent) shake","ur":"لرزنا۔ ڈگمگانا","tr":"mawran"}],"52:10":[{"ar":"وَتَسِيرُ","en":"And will move away","ur":"اور چلیں گے","tr":"watasīru"},{"ar":"ٱلْجِبَالُ","en":"the mountains","ur":"پہاڑ","tr":"l-jibālu"},{"ar":"سَيْرًۭا","en":"(with an awful) movement","ur":"چلنا","tr":"sayran"}],"52:11":[{"ar":"فَوَيْلٌۭ","e
","ur":"تم صبر کرو","tr":"taṣbirū"},{"ar":"سَوَآءٌ","en":"(it is) same","ur":"برابر ہے","tr":"sawāon"},{"ar":"عَلَيْكُمْ ۖ","en":"for you","ur":"تم پر","tr":"ʿalaykum"},{"ar":"إِنَّمَا","en":"Only","ur":"بیشک","tr":"innamā"},{"ar":"تُجْزَوْنَ","en":"you are being recompensed","ur":"تم بدلہ دیئے جاتے ہو","tr":"tuj'zawna"},{"ar":"مَا","en":"(for) what","ur":"جو","tr":"mā"},{"ar":"كُنتُمْ","en":"you used to","ur":"تھے تم","tr":"kuntum"},{"ar":"تَعْمَلُونَ","en":"do","ur":"تم عمل کرتے","tr":"taʿmalūna"}],"52:17":[{"ar":"إِنَّ","en":"Indeed","ur":"یشک","tr":"inna"},{"ar":"ٱلْمُتَّقِينَ","en":"the righteous","ur":"متقی لوگ","tr":"l-mutaqīna"},{"ar":"فِى","en":"(will be) in","ur":"میں","tr":"fī"},{"ar":"جَنَّـٰتٍۢ","en":"Gardens","ur":"باغوں","tr":"jannātin"},{"ar":"وَنَعِيمٍۢ","en":"and pleasure","ur":"اور نعمتوں میں ہوں گے","tr":"wanaʿīmin"}],"52:18":[{"ar":"فَـٰكِهِينَ","en":"Enjoying","ur":"خوش ہوں گے","tr":"fākihīna"},{"ar":"بِمَآ","en":"in what","ur":"بوجہ اس کے","tr":"bimā"},{"ar":"ءَاتَىٰهُمْ","en":"has given them","ur":"جو دے گا ان کو","tr":"ātāhum"},{"ar":"رَبُّهُمْ","en":"their Lord","ur":"ان کا رب","tr":"rabbuhum"},{"ar":"وَوَقَىٰهُمْ","en":"and protected them","ur":"اور بچا لے گا ان کو","tr":"wawaqāhum"},{"ar":"رَبُّهُمْ","en":"their Lord","ur":"ان کا رب","tr":"rabbuhum"},{"ar":"عَذَابَ","en":"(from the) punishment","ur":"عذاب میں","tr":"ʿadhāba"},{"ar":"ٱلْجَحِيمِ","en":"(of) Hellfire","ur":"جہنم کے","tr":"l-jaḥīmi"}],"52:19":[{"ar":"كُلُوا۟","en":"Eat","ur":"کھاؤ","tr":"kulū"},{"ar":"وَٱشْرَبُوا۟","en":"and drink","ur":"اور پیو","tr":"wa-ish'rabū"},{"ar":"هَنِيٓـًٔۢا","en":"(in) satisfaction","ur":"مزے سے","tr":"hanīan"},{"ar":"بِمَا","en":"for what","ur":"بوجہ اس کے جو","tr":"bimā"},{"ar":"كُنتُمْ","en":"you used to","ur":"تھے تم","tr":"kuntum"},{"ar":"تَعْمَلُونَ","en":"do","ur":"تم عمل کرتے","tr":"taʿmalūna"}],"52:20":[{"ar":"مُتَّكِـِٔينَ","en":"Reclining","ur":"تکیہ لگائے ہوئے ہوں گے","tr":"muttakiīna"},{"ar":"عَلَىٰ","en":"on","ur":"اوپر","tr":"ʿalā"},{"ar":"سُرُرٍۢ","en":"thrones","ur":"تختوں کے","tr":"sururin"},{"ar":"مَّصْفُوفَةٍۢ ۖ","en":"lined up","ur":"صف باندھے ہوئے","tr":"maṣfūfatin"},{"ar":"وَزَوَّجْنَـٰهُم","en":"and We will marry them","ur":"اور بیادہ دیں گے ہم ان کو","tr":"wazawwajnāhum"},{"ar":"بِحُورٍ","en":"to fair ones","ur":"ساتھ سفید عورتوں کے،","tr":"biḥūrin"},{"ar":"عِينٍۢ","en":"(with) large eyes","ur":"بڑی آنکھوں والی","tr":"ʿīnin"}],"52:21":[{"ar":"وَٱلَّذِينَ","en":"And those who","ur":"اور وہ لوگ جو","tr":"wa-alladhīna"},{"ar":"ءَامَنُوا۟","en":"believed","ur":"ایمان لائے","tr":"āmanū"},{"ar":"وَٱتَّبَعَتْهُمْ","en":"and followed them","ur":"اور پیروی کی ان کی","tr":"wa-ittabaʿathum"},{"ar":"ذُرِّيَّتُهُم","en":"their offspring","ur":"ان کی اولاد نے","tr":"dhurriyyatuhum"},{"ar":"بِإِيمَـٰنٍ","en":"in faith","ur":"ایمان کے ساتھ","tr":"biīmānin"},{"ar":"أَلْحَقْنَا","en":"We will join","ur":"ہم ملا دیں گے","tr":"alḥaqnā"},{"ar":"بِهِمْ","en":"with them","ur":"ان کے ساتھ","tr":"bihim"},{"ar":"ذُرِّيَّتَهُمْ","en":"their offspring","ur":"ان کی اولاد کو","tr":"dhurriyyatahum"},{"ar":"وَمَآ","en":"and not","ur":"اور نہ","tr":"wamā"},{"ar":"أَلَتْنَـٰهُم","en":"We will deprive them","ur":"کمی کریں گے ہم ان کے","tr":"alatnāhum"},{"ar":"مِّنْ","en":"of","ur":"سے","tr":"min"},{"ar":"عَمَلِهِم","en":"their deeds","ur":"عمل میں ان کے","tr":"ʿamalihim"},{"ar":"مِّن","en":"(in) any","ur":"","tr":"min"},{"ar":"شَىْءٍۢ ۚ","en":"thing","ur":"کچھ بھی","tr":"shayin"},{"ar":"كُلُّ","en":"Every","ur":"ہر","tr":"kullu"},{"ar":"ٱمْرِئٍۭ","en":"person","ur":"شخص","tr":"im'ri-in"},{"ar":"بِمَا","en":"for what","ur":"ساتھ اس کے","tr":"bimā"},{"ar":"كَسَبَ","en":"he earned","ur":"جو اس نے کمائی کی","tr":"kasaba"},{"ar":"رَهِينٌۭ","en":"(is) pledged","ur":"رھن ہے۔ گروی ہے","tr":"rahīnun"}],"52:22":[{"ar":"وَأَمْدَدْنَـٰهُم","en":"And We will provide them","ur":"اور مدد دیں گے ہم ان کو۔ زیادہ دیں گے ہم ان کو۔ پے در پے دیں گے ہم ان کو","tr":"wa-amdadnāhum"},{"ar":"بِفَـٰكِهَةٍۢ","en":"with fruit","ur":"پھل","tr":"
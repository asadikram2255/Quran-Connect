{"114:1":[{"ar":"قُلْ","en":"Say","ur":"کہہ دیجئے","tr":"qul"},{"ar":"أَعُوذُ","en":"I seek refuge","ur":"میں پناہ چاہتا ہوں","tr":"aʿūdhu"},{"ar":"بِرَبِّ","en":"in (the) Lord","ur":"رب کی","tr":"birabbi"},{"ar":"ٱلنَّاسِ","en":"(of) mankind","ur":"انسانوں کے","tr":"l-nāsi"}],"114:2":[{"ar":"مَلِكِ","en":"(The) King","ur":"بادشاہ","tr":"maliki"},{"ar":"ٱلنَّاسِ","en":"(of) mankind","ur":"انسانوں کے","tr":"l-nāsi"}],"114:3":[{"ar":"إِلَـٰهِ","en":"(The) God","ur":"الٰہ کی/معبود کی","tr":"ilāhi"},{"ar":"ٱلنَّاسِ","en":"(of) mankind","ur":"انسانوں کے","tr":"l-nāsi"}],"114:4":[{"ar":"مِن","en":"From","ur":"سے","tr":"min"},{"ar":"شَرِّ","en":"(the) evil","ur":"شر","tr":"sharri"},{"ar":"ٱلْوَسْوَاسِ","en":"(of) the whisperer","ur":"وسوسہ ڈالنے والے","tr":"l-waswāsi"},{"ar":"ٱلْخَنَّاسِ","en":"the one who withdraws","ur":"بار بار پلٹ کر آنے والے کے","tr":"l-khanāsi"}],"114:5":[{"ar":"ٱلَّذِى","en":"The one who","ur":"وہ جو","tr":"alladhī"},{"ar":"يُوَسْوِسُ","en":"whispers","ur":"وسوسہ ڈالتا ہے","tr":"yuwaswisu"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"صُدُورِ","en":"(the) breasts","ur":"سینوں","tr":"ṣudūri"},{"ar":"ٱلنَّاسِ","en":"(of) mankind","ur":"انسانوں کے","tr":"l-nāsi"}],"114:6":[{"ar":"مِنَ","en":"From","ur":"سے","tr":"mina"},{"ar":"ٱلْجِنَّةِ","en":"the jinn","ur":"جنوں میں","tr":"l-jinati"},{"ar":"وَٱلنَّاسِ","en":"and men","ur":"اور انسانوں میں","tr":"wal-nāsi"}]}
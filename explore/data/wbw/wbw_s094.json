{"94:1":[{"ar":"أَلَمْ","en":"Have not","ur":"کیا نہیں","tr":"alam"},{"ar":"نَشْرَحْ","en":"We expanded","ur":"ہم نے کھول دیا","tr":"nashraḥ"},{"ar":"لَكَ","en":"for you","ur":"تیرے لئے","tr":"laka"},{"ar":"صَدْرَكَ","en":"your breast","ur":"سینہ تیرا","tr":"ṣadraka"}],"94:2":[{"ar":"وَوَضَعْنَا","en":"And We removed","ur":"اور اٹھالیا ہم نے","tr":"wawaḍaʿnā"},{"ar":"عَنكَ","en":"from you","ur":"تجھ سے","tr":"ʿanka"},{"ar":"وِزْرَكَ","en":"your burden","ur":"بوجھ تیرا","tr":"wiz'raka"}],"94:3":[{"ar":"ٱلَّذِىٓ","en":"Which","ur":"وہ جس نے","tr":"alladhī"},{"ar":"أَنقَضَ","en":"weighed upon","ur":"توڑ دی تھی","tr":"anqaḍa"},{"ar":"ظَهْرَكَ","en":"your back","ur":"تیری کمر","tr":"ẓahraka"}],"94:4":[{"ar":"وَرَفَعْنَا","en":"And We raised high","ur":"اور بلند کیا ہم نے","tr":"warafaʿnā"},{"ar":"لَكَ","en":"for you","ur":"تیرے لئے","tr":"laka"},{"ar":"ذِكْرَكَ","en":"your reputation","ur":"تیرا ذکر","tr":"dhik'raka"}],"94:5":[{"ar":"فَإِنَّ","en":"So indeed","ur":"پس یقیناً","tr":"fa-inna"},{"ar":"مَعَ","en":"with","ur":"ساتھ","tr":"maʿa"},{"ar":"ٱلْعُسْرِ","en":"the hardship","ur":"تنگی کے","tr":"l-ʿus'ri"},{"ar":"يُسْرًا","en":"(is) ease","ur":"آسانی ہے","tr":"yus'ran"}],"94:6":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"مَعَ","en":"with","ur":"ساتھ","tr":"maʿa"},{"ar":"ٱلْعُسْرِ","en":"the hardship","ur":"تنگی کے","tr":"l-ʿus'ri"},{"ar":"يُسْرًۭا","en":"(is) ease","ur":"آسانی ہے","tr":"yus'ran"}],"94:7":[{"ar":"فَإِذَا","en":"So when","ur":"پس جب","tr":"fa-idhā"},{"ar":"فَرَغْتَ","en":"you have finished","ur":"تم فارغ ہوجاؤ","tr":"faraghta"},{"ar":"فَٱنصَبْ","en":"then labor hard","ur":"تو محنت کرو/ کھڑے ہوجاؤ","tr":"fa-inṣab"}],"94:8":[{"ar":"وَإِلَىٰ","en":"And to","ur":"اور  طرف","tr":"wa-ilā"},{"ar":"رَبِّكَ","en":"your Lord","ur":"اپنے رب کی","tr":"rabbika"},{"ar":"فَٱرْغَب","en":"turn your attention","ur":"پس راغب ہوجاؤ/ رغبت کرو","tr":"fa-ir'ghab"}]}
{"113:1":[{"ar":"قُلْ","en":"Say","ur":"کہہ دیجئے","tr":"qul"},{"ar":"أَعُوذُ","en":"I seek refuge","ur":"میں پناہ چاہتا ہوں","tr":"aʿūdhu"},{"ar":"بِرَبِّ","en":"in (the) Lord","ur":"رب کی","tr":"birabbi"},{"ar":"ٱلْفَلَقِ","en":"(of) the dawn","ur":"صبح کے","tr":"l-falaqi"}],"113:2":[{"ar":"مِن","en":"From","ur":"سے","tr":"min"},{"ar":"شَرِّ","en":"(the) evil","ur":"شر","tr":"sharri"},{"ar":"مَا","en":"(of) what","ur":"ہر اس چیز کے  جو","tr":"mā"},{"ar":"خَلَقَ","en":"He created","ur":"اس نے پیدا کی","tr":"khalaqa"}],"113:3":[{"ar":"وَمِن","en":"And from","ur":"اور سے","tr":"wamin"},{"ar":"شَرِّ","en":"(the) evil","ur":"شر","tr":"sharri"},{"ar":"غَاسِقٍ","en":"(of) darkness","ur":"اندھیرا کرنے والی کے","tr":"ghāsiqin"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"وَقَبَ","en":"it spreads","ur":"وہ داخل ہوجائے","tr":"waqaba"}],"113:4":[{"ar":"وَمِن","en":"And from","ur":"اور سے","tr":"wamin"},{"ar":"شَرِّ","en":"(the) evil","ur":"شر","tr":"sharri"},{"ar":"ٱلنَّفَّـٰثَـٰتِ","en":"(of) the blowers","ur":"پھونکنے والیوں کے","tr":"l-nafāthāti"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"ٱلْعُقَدِ","en":"the knots","ur":"گرہوں (میں)","tr":"l-ʿuqadi"}],"113:5":[{"ar":"وَمِن","en":"And from","ur":"اور سے","tr":"wamin"},{"ar":"شَرِّ","en":"(the) evil","ur":"شر","tr":"sharri"},{"ar":"حَاسِدٍ","en":"(of) an envier","ur":"حاسد کے","tr":"ḥāsidin"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"حَسَدَ","en":"he envies","ur":"وہ حسد کرے","tr":"ḥasada"}]}
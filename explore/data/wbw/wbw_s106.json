{"106:1":[{"ar":"لِإِيلَـٰفِ","en":"For (the) familiarity","ur":"مانوس کرنے کے لئے","tr":"liīlāfi"},{"ar":"قُرَيْشٍ","en":"(of the) Quraish","ur":"قریش کو","tr":"qurayshin"}],"106:2":[{"ar":"إِۦلَـٰفِهِمْ","en":"Their familiarity","ur":"مانوس کرنا ان کو","tr":"īlāfihim"},{"ar":"رِحْلَةَ","en":"(with the) journey","ur":"سفر میں","tr":"riḥ'lata"},{"ar":"ٱلشِّتَآءِ","en":"(of) winter","ur":"سردی کے","tr":"l-shitāi"},{"ar":"وَٱلصَّيْفِ","en":"and summer","ur":"اور گرمی کے","tr":"wal-ṣayfi"}],"106:3":[{"ar":"فَلْيَعْبُدُوا۟","en":"So let them worship","ur":"پس چاہیے کہ وہ عبادت کریں","tr":"falyaʿbudū"},{"ar":"رَبَّ","en":"(the) Lord","ur":"رب کی","tr":"rabba"},{"ar":"هَـٰذَا","en":"(of) this","ur":"اس","tr":"hādhā"},{"ar":"ٱلْبَيْتِ","en":"House","ur":"گھر کے","tr":"l-bayti"}],"106:4":[{"ar":"ٱلَّذِىٓ","en":"The One Who","ur":"جس نے","tr":"alladhī"},{"ar":"أَطْعَمَهُم","en":"feeds them","ur":"کھلایا ان کو","tr":"aṭʿamahum"},{"ar":"مِّن","en":"[from]","ur":"سے","tr":"min"},{"ar":"جُوعٍۢ","en":"(against) hunger","ur":"بھوک (سے)","tr":"jūʿin"},{"ar":"وَءَامَنَهُم","en":"and gives them security","ur":"اور امن دیا ان کو","tr":"waāmanahum"},{"ar":"مِّنْ","en":"from","ur":"سے","tr":"min"},{"ar":"خَوْفٍۭ","en":"fear","ur":"خوف (سے)","tr":"khawfin"}]}
ufika"}],"51:10":[{"ar":"قُتِلَ","en":"Cursed be","ur":"مارے گئے","tr":"qutila"},{"ar":"ٱلْخَرَّٰصُونَ","en":"the liars","ur":"اندازے لگانے والے","tr":"l-kharāṣūna"}],"51:11":[{"ar":"ٱلَّذِينَ","en":"Those who","ur":"یہ لوگ","tr":"alladhīna"},{"ar":"هُمْ","en":"[they]","ur":"وہ ہیں","tr":"hum"},{"ar":"فِى","en":"(are) in","ur":"میں","tr":"fī"},{"ar":"غَمْرَةٍۢ","en":"flood","ur":"جو غفلت (میں)","tr":"ghamratin"},{"ar":"سَاهُونَ","en":"(of) heedlessness","ur":"بھولے ہوئے ہیں","tr":"sāhūna"}],"51:12":[{"ar":"يَسْـَٔلُونَ","en":"They ask","ur":"وہ سوال کرتے ہیں","tr":"yasalūna"},{"ar":"أَيَّانَ","en":"When","ur":"کب ہوگا","tr":"ayyāna"},{"ar":"يَوْمُ","en":"(is the) Day","ur":"دن","tr":"yawmu"},{"ar":"ٱلدِّينِ","en":"(of) Judgment","ur":"جزا سزا کا","tr":"l-dīni"}],"51:13":[{"ar":"يَوْمَ","en":"A Day","ur":"اس روز","tr":"yawma"},{"ar":"هُمْ","en":"they","ur":"وہ","tr":"hum"},{"ar":"عَلَى","en":"over","ur":"پر","tr":"ʿalā"},{"ar":"ٱلنَّارِ","en":"the Fire","ur":"آگ","tr":"l-nāri"},{"ar":"يُفْتَنُونَ","en":"will be tried","ur":"تپائے جائیں گے","tr":"yuf'tanūna"}],"51:14":[{"ar":"ذُوقُوا۟","en":"Taste","ur":"چکھو","tr":"dhūqū"},{"ar":"فِتْنَتَكُمْ","en":"your trial","ur":"اپنی گمراہی کو۔ اپنے عذاب کو","tr":"fit'natakum"},{"ar":"هَـٰذَا","en":"This","ur":"یہ","tr":"hādhā"},{"ar":"ٱلَّذِى","en":"(is) what","ur":"وہ چیز ہے","tr":"alladhī"},{"ar":"كُنتُم","en":"you were","ur":"تھے تم","tr":"kuntum"},{"ar":"بِهِۦ","en":"for it","ur":"ساتھ اس کے","tr":"bihi"},{"ar":"تَسْتَعْجِلُونَ","en":"seeking to hasten","ur":"تم جلدی مچاتے","tr":"tastaʿjilūna"}],"51:15":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"ٱلْمُتَّقِينَ","en":"the righteous","ur":"متقی لوگ","tr":"l-mutaqīna"},{"ar":"فِى","en":"(will be) in","ur":"میں","tr":"fī"},{"ar":"جَنَّـٰتٍۢ","en":"Gardens","ur":"باغات (میں)","tr":"jannātin"},{"ar":"وَعُيُونٍ","en":"and springs","ur":"اور چشموں میں ہوں گے","tr":"waʿuyūnin"}],"51:16":[{"ar":"ءَاخِذِينَ","en":"Taking","ur":"لینے والے ہوں گے","tr":"ākhidhīna"},{"ar
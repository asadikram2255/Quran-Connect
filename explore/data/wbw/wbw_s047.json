{"47:1":[{"ar":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا","tr":"kafarū"},{"ar":"وَصَدُّوا۟","en":"and turn away","ur":"اور روکا","tr":"waṣaddū"},{"ar":"عَن","en":"from","ur":"سے","tr":"ʿan"},{"ar":"سَبِيلِ","en":"(the) way of Allah","ur":"راستے (سے)","tr":"sabīli"},{"ar":"ٱللَّهِ","en":"(the) way of Allah","ur":"اللہ کے","tr":"l-lahi"},{"ar":"أَضَلَّ","en":"He will cause to be lost","ur":"ضائع کردیئے (اللہ نے)","tr":"aḍalla"},{"ar":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"ان کے اعمال","tr":"aʿmālahum"}],"47:2":[{"ar":"وَٱلَّذِينَ","en":"And those who","ur":"اور وہ لوگ","tr":"wa-alladhīna"},{"ar":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے  عمل کیے","tr":"waʿamilū"},{"ar":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے","tr":"l-ṣāliḥāti"},{"ar":"وَءَامَنُوا۟","en":"and believe","ur":"اور وہ ایمان لائے","tr":"waāmanū"},{"ar":"بِمَا","en":"in what","ur":"ساتھ اس کے جو","tr":"bimā"},{"ar":"نُزِّلَ","en":"is revealed","ur":"نازل کیا گیا","tr":"nuzzila"},{"ar":"عَلَىٰ","en":"to","ur":"پر","tr":"ʿalā"},{"ar":"مُحَمَّدٍۢ","en":"Muhammad","ur":"محمد (صلی اللہ علیہ وآلہ وسلم)","tr":"muḥammadin"},{"ar":"وَهُوَ","en":"and it","ur":"اور وہ","tr":"wahuwa"},{"ar":"ٱلْحَقُّ","en":"(is) the truth","ur":"حق ہے","tr":"l-ḥaqu"},{"ar":"مِن","en":"from","ur":"سے","tr":"min"},{"ar":"رَّبِّهِمْ ۙ","en":"their Lord","ur":"ان کے رب کی طرف (سے)","tr":"rabbihim"},{"ar":"كَفَّرَ","en":"He will remove","ur":"اس نے دور کردیں","tr":"kaffara"},{"ar":"عَنْهُمْ","en":"from them","ur":"ان سے","tr":"ʿanhum"},{"ar":"سَيِّـَٔاتِهِمْ","en":"their misdeeds","ur":"ان کی برائیاں","tr":"sayyiātihim"},{"ar":"وَأَصْلَحَ","en":"and improve","ur":"اور درست کردیا","tr":"wa-aṣlaḥa"},{"ar":"بَالَهُمْ","en":"their condition","ur":"ان کا حال","tr":"bālahum"}],"47:3":[{"ar":"ذَٰلِكَ","en":"That","ur":"یہ","tr":"dhālika"},{"ar":"بِأَنَّ","en":"(is) because","ur":"بوجہ
{"55:1":[{"ar":"ٱلرَّحْمَـٰنُ","en":"The Most Gracious","ur":"الرحمان","tr":"al-raḥmānu"}],"55:2":[{"ar":"عَلَّمَ","en":"He taught","ur":"اس نے تعلیم دی","tr":"ʿallama"},{"ar":"ٱلْقُرْءَانَ","en":"the Quran","ur":"قرآن کی","tr":"l-qur'āna"}],"55:3":[{"ar":"خَلَقَ","en":"He created","ur":"اس نے پیدا کیا","tr":"khalaqa"},{"ar":"ٱلْإِنسَـٰنَ","en":"[the] man","ur":"انسان کو","tr":"l-insāna"}],"55:4":[{"ar":"عَلَّمَهُ","en":"He taught him","ur":"سکھایا اس کو","tr":"ʿallamahu"},{"ar":"ٱلْبَيَانَ","en":"[the] speech","ur":"بولنا","tr":"l-bayāna"}],"55:5":[{"ar":"ٱلشَّمْسُ","en":"The sun","ur":"سورج","tr":"al-shamsu"},{"ar":"وَٱلْقَمَرُ","en":"and the moon","ur":"اور چاند","tr":"wal-qamaru"},{"ar":"بِحُسْبَانٍۢ","en":"by (precise) calculation","ur":"حساب کے ساتھ ہیں","tr":"biḥus'bānin"}],"55:6":[{"ar":"وَٱلنَّجْمُ","en":"And the stars","ur":"اور تارے","tr":"wal-najmu"},{"ar":"وَٱلشَّجَرُ","en":"and the trees","ur":"اور درخت","tr":"wal-shajaru"},{"ar":"يَسْجُدَانِ","en":"both prostrate","ur":"سجدہ کر رہے ہیں","tr":"yasjudāni"}],"55:7":[{"ar":"وَٱلسَّمَآءَ","en":"And the heaven","ur":"اور آسمان","tr":"wal-samāa"},{"ar":"رَفَعَهَا","en":"He raised it","ur":"اس نے بلند کیا اس کو","tr":"rafaʿahā"},{"ar":"وَوَضَعَ","en":"and He has set up","ur":"اور قائم کردی۔ رکھ دی","tr":"wawaḍaʿa"},{"ar":"ٱلْمِيزَانَ","en":"the balance","ur":"میزان","tr":"l-mīzāna"}],"55:8":[{"ar":"أَلَّا","en":"That not","ur":"کہ نہ","tr":"allā"},{"ar":"تَطْغَوْا۟","en":"you may transgress","ur":"تم خلل ڈالو۔ زیادتی کرو","tr":"taṭghaw"},{"ar":"فِى","en":"in","ur":"میں","tr":"fī"},{"ar":"ٱلْمِيزَانِ","en":"the balance","ur":"میزان","tr":"l-mīzāni"}],"55:9":[{"ar":"وَأَقِيمُوا۟","en":"And establish","ur":"اور قائم کرو۔ تولو","tr":"wa-aqīmū"},{"ar":"ٱلْوَزْنَ","en":"the weight","ur":"وزن کو","tr":"l-wazna"},{"ar":"بِٱلْقِسْطِ","en":"in justice","ur":"انصاف کے ساتھ","tr":"bil-qis'ṭi"},{"ar":"وَلَا","en":"and (do) not","ur":"اور نہ","tr":"walā"},{"ar":"تُخْسِرُوا۟","en":"make deficient","ur":"خسارہ کر کے دو ۔ نق
{"98:1":[{"ar":"لَمْ","en":"Not","ur":"نہیں","tr":"lam"},{"ar":"يَكُنِ","en":"were","ur":"تھے وہ","tr":"yakuni"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"لوگ","tr":"alladhīna"},{"ar":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا","tr":"kafarū"},{"ar":"مِنْ","en":"from","ur":"سے","tr":"min"},{"ar":"أَهْلِ","en":"(the) People","ur":"اہل","tr":"ahli"},{"ar":"ٱلْكِتَـٰبِ","en":"of the Book","ur":"کتاب میں سے","tr":"l-kitābi"},{"ar":"وَٱلْمُشْرِكِينَ","en":"and the polytheists","ur":"اور مشرکین میں سے","tr":"wal-mush'rikīna"},{"ar":"مُنفَكِّينَ","en":"to be abandoned","ur":"باز آنے والے","tr":"munfakkīna"},{"ar":"حَتَّىٰ","en":"until","ur":"یہاں تک کہ","tr":"ḥattā"},{"ar":"تَأْتِيَهُمُ","en":"(there) comes to them","ur":"آجائے ان کے پاس","tr":"tatiyahumu"},{"ar":"ٱلْبَيِّنَةُ","en":"the clear evidence","ur":"واضح دلیل","tr":"l-bayinatu"}],"98:2":[{"ar":"رَسُولٌۭ","en":"A Messenger","ur":"ایک رسول","tr":"rasūlun"},{"ar":"مِّنَ","en":"from","ur":"سے","tr":"mina"},{"ar":"ٱللَّهِ","en":"Allah","ur":"اللہ کی طرف (سے)","tr":"l-lahi"},{"ar":"يَتْلُوا۟","en":"reciting","ur":"جو پڑھتا ہے","tr":"yatlū"},{"ar":"صُحُفًۭا","en":"pages","ur":"صحیفے","tr":"ṣuḥufan"},{"ar":"مُّطَهَّرَةًۭ","en":"purified","ur":"پاکیزہ","tr":"muṭahharatan"}],"98:3":[{"ar":"فِيهَا","en":"Wherein","ur":"اس میں","tr":"fīhā"},{"ar":"كُتُبٌۭ","en":"(are) writings","ur":"احکام ہیں/ تحریریں ہیں","tr":"kutubun"},{"ar":"قَيِّمَةٌۭ","en":"correct","ur":"درست","tr":"qayyimatun"}],"98:4":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"تَفَرَّقَ","en":"became divided","ur":"تفرقہ کیا","tr":"tafarraqa"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں نے","tr":"alladhīna"},{"ar":"أُوتُوا۟","en":"were given","ur":"جو دیئے گئے","tr":"ūtū"},{"ar":"ٱلْكِتَـٰبَ","en":"the Book","ur":"کتاب","tr":"l-kitāba"},{"ar":"إِلَّا","en":"until","ur":"مگر","tr":"illā"},{"ar":"مِنۢ","en":"from","ur":"کے","tr":"min"},{"ar":"بَعْدِ","en":"after","ur":"بعد اس کے","tr":"baʿdi"},{"ar":"مَا","en":"what","ur":"جو","t
{"103:1":[{"ar":"وَٱلْعَصْرِ","en":"By the time","ur":"قسم ہے زمانے کی","tr":"wal-ʿaṣri"}],"103:2":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"ٱلْإِنسَـٰنَ","en":"mankind","ur":"تمام انسان","tr":"l-insāna"},{"ar":"لَفِى","en":"(is) surely, in","ur":"البتہ میں","tr":"lafī"},{"ar":"خُسْرٍ","en":"loss","ur":"نقصان میں ہیں/ خسارے میں ہیں","tr":"khus'rin"}],"103:3":[{"ar":"إِلَّا","en":"Except","ur":"سوائے","tr":"illā"},{"ar":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں کے","tr":"alladhīna"},{"ar":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے","tr":"āmanū"},{"ar":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے ے کام کئے","tr":"waʿamilū"},{"ar":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے","tr":"l-ṣāliḥāti"},{"ar":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","ur":"اور ایک دوسرے کو  تلقین کی","tr":"watawāṣaw"},{"ar":"بِٱلْحَقِّ","en":"to the truth","ur":"حق کی","tr":"bil-ḥaqi"},{"ar":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","ur":"اور ایک دوسرے کو  تلقین کی","tr":"watawāṣaw"},{"ar":"بِٱلصَّبْرِ","en":"to [the] patience","ur":"صبر کی","tr":"bil-ṣabri"}]}
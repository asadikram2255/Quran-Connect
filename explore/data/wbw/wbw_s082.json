{"82:1":[{"ar":"إِذَا","en":"When","ur":"جب","tr":"idhā"},{"ar":"ٱلسَّمَآءُ","en":"the sky","ur":"آسمان","tr":"l-samāu"},{"ar":"ٱنفَطَرَتْ","en":"(is) cleft asunder","ur":"پھٹ جائے گا","tr":"infaṭarat"}],"82:2":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْكَوَاكِبُ","en":"the stars","ur":"تارے","tr":"l-kawākibu"},{"ar":"ٱنتَثَرَتْ","en":"scatter","ur":"بکھرجائیں گے","tr":"intatharat"}],"82:3":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْبِحَارُ","en":"the seas","ur":"سمندر","tr":"l-biḥāru"},{"ar":"فُجِّرَتْ","en":"are made to gush forth","ur":"پھاڑ دیئے جائیں گے","tr":"fujjirat"}],"82:4":[{"ar":"وَإِذَا","en":"And when","ur":"اور جب","tr":"wa-idhā"},{"ar":"ٱلْقُبُورُ","en":"the graves","ur":"قبریں","tr":"l-qubūru"},{"ar":"بُعْثِرَتْ","en":"are overturned","ur":"کھول دی جائیں گی","tr":"buʿ'thirat"}],"82:5":[{"ar":"عَلِمَتْ","en":"Will know","ur":"جان لے گا","tr":"ʿalimat"},{"ar":"نَفْسٌۭ","en":"a soul","ur":"ہر شخص","tr":"nafsun"},{"ar":"مَّا","en":"what","ur":"جو","tr":"mā"},{"ar":"قَدَّمَتْ","en":"it has sent forth","ur":"اس نے آگے بھیجا","tr":"qaddamat"},{"ar":"وَأَخَّرَتْ","en":"and left behind","ur":"اور جو پیچھے رکھا","tr":"wa-akharat"}],"82:6":[{"ar":"يَـٰٓأَيُّهَا","en":"O","ur":"اے","tr":"yāayyuhā"},{"ar":"ٱلْإِنسَـٰنُ","en":"man","ur":"انسان","tr":"l-insānu"},{"ar":"مَا","en":"What","ur":"کس چیز نے","tr":"mā"},{"ar":"غَرَّكَ","en":"has deceived you","ur":"دھوکے میں ڈالا تجھ کو","tr":"gharraka"},{"ar":"بِرَبِّكَ","en":"concerning your Lord","ur":"تیرے رب","tr":"birabbika"},{"ar":"ٱلْكَرِيمِ","en":"the Most Noble","ur":"کریم کے بارے میں","tr":"l-karīmi"}],"82:7":[{"ar":"ٱلَّذِى","en":"Who","ur":"وہ جس نے","tr":"alladhī"},{"ar":"خَلَقَكَ","en":"created you","ur":"پیدا کیا تجھ کو","tr":"khalaqaka"},{"ar":"فَسَوَّىٰكَ","en":"then fashioned you","ur":"پھر درست کیا تجھ کو","tr":"fasawwāka"},{"ar":"فَعَدَلَكَ","en":"then balanced you","ur":"پھر برابر کیا تجھ کو","tr":"faʿadalaka"}],"82:8":[{"ar":"فِىٓ","en":"In","ur":"میں","tr":"fī"},{"ar":"أَىِّ","en":"whatever","ur":"جس","tr":"ayyi"},{"ar":"صُورَةٍۢ","en":"form","ur":"شکل   (میں)","tr":"ṣūratin"},{"ar":"مَّا","en":"what","ur":"جو","tr":"mā"},{"ar":"شَآءَ","en":"He willed","ur":"اس نے چاہا","tr":"shāa"},{"ar":"رَكَّبَكَ","en":"He assembled you","ur":"جوڑ دیا تجھ کو","tr":"rakkabaka"}],"82:9":[{"ar":"كَلَّا","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"بَلْ","en":"But","ur":"بلکہ","tr":"bal"},{"ar":"تُكَذِّبُونَ","en":"you deny","ur":"تم جھٹلاتے ہو","tr":"tukadhibūna"},{"ar":"بِٱلدِّينِ","en":"the Judgment","ur":"جزا وسزا کو","tr":"bil-dīni"}],"82:10":[{"ar":"وَإِنَّ","en":"And indeed","ur":"اور بیشک","tr":"wa-inna"},{"ar":"عَلَيْكُمْ","en":"over you","ur":"تم پر","tr":"ʿalaykum"},{"ar":"لَحَـٰفِظِينَ","en":"(are) surely guardians","ur":"البتہ حفاظت کرنے والے ہیں/ نگرانی کرنے والے","tr":"laḥāfiẓīna"}],"82:11":[{"ar":"كِرَامًۭا","en":"Noble","ur":"بزرگ/محترم","tr":"kirāman"},{"ar":"كَـٰتِبِينَ","en":"recording","ur":"لکھنے والے ہیں","tr":"kātibīna"}],"82:12":[{"ar":"يَعْلَمُونَ","en":"They know","ur":"جانتے ہیں","tr":"yaʿlamūna"},{"ar":"مَا","en":"whatever","ur":"جو کچھ","tr":"mā"},{"ar":"تَفْعَلُونَ","en":"you do","ur":"تم کرتے ہو","tr":"tafʿalūna"}],"82:13":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"ٱلْأَبْرَارَ","en":"the righteous","ur":"نیک لوگ","tr":"l-abrāra"},{"ar":"لَفِى","en":"(will be) surely in","ur":"البتہ میں","tr":"lafī"},{"ar":"نَعِيمٍۢ","en":"bliss","ur":"نعمتوں میں ہوں گے","tr":"naʿīmin"}],"82:14":[{"ar":"وَإِنَّ","en":"And indeed","ur":"اور بیشک","tr":"wa-inna"},{"ar":"ٱلْفُجَّارَ","en":"the wicked","ur":"بدکار لوگ","tr":"l-fujāra"},{"ar":"لَفِى","en":"(will be) surely in","ur":"البتہ میں","tr":"lafī"},{"ar":"جَحِيمٍۢ","en":"Hellfire","ur":"جہنم میں ہوں گے","tr":"jaḥīmin"}],"82:15":[{"ar":"يَصْلَوْنَهَا","en":"They will burn (in) it","ur":"وہ داخل ہوں گے اس میں","tr":"yaṣlawnahā"},{"ar":"يَوْمَ","en":"(on the) Day","ur":"دن","tr":"yawma"},{"ar":"ٱلدِّينِ","en":"(of) the Judgment","ur":"جزا سزا کے (دن)/ بدلے کے (دن)","tr":"l-dīni"}],"82:16":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"هُمْ","en":"they","ur":"وہ","tr":"hum"},{"ar":"عَنْهَا","en":"from it","ur":"اس سے","tr":"ʿanhā"},{"ar":"بِغَآئِبِينَ","en":"(will be) absent","ur":"کچھ غائب ہونے والے","tr":"bighāibīna"}],"82:17":[{"ar":"وَمَآ","en":"And what","ur":"اور کیا چیز","tr":"wamā"},{"ar":"أَدْرَىٰكَ","en":"can make you know","ur":"بتائے تجھ کو","tr":"adrāka"},{"ar":"مَا","en":"what","ur":"کیا ہے ؟","tr":"mā"},{"ar":"يَوْمُ","en":"(is the) Day","ur":"دن","tr":"yawmu"},{"ar":"ٱلدِّينِ","en":"(of) the Judgment","ur":"بدلے کا","tr":"l-dīni"}],"82:18":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"مَآ","en":"what","ur":"کیا چیز","tr":"mā"},{"ar":"أَدْرَىٰكَ","en":"can make you know","ur":"بتائے تجھ کو","tr":"adrāka"},{"ar":"مَا","en":"what","ur":"کہ کیا ہے ؟","tr":"mā"},{"ar":"يَوْمُ","en":"(is the) Day","ur":"دن","tr":"yawmu"},{"ar":"ٱلدِّينِ","en":"(of) the Judgment","ur":"بدلے کا","tr":"l-dīni"}],"82:19":[{"ar":"يَوْمَ","en":"(The) Day","ur":"جس دن","tr":"yawma"},{"ar":"لَا","en":"not","ur":"نہ","tr":"lā"},{"ar":"تَمْلِكُ","en":"will have power","ur":"مالک ہوگا","tr":"tamliku"},{"ar":"نَفْسٌۭ","en":"a soul","ur":"کوئی نفس","tr":"nafsun"},{"ar":"لِّنَفْسٍۢ","en":"for a soul","ur":"کسی نفس کے لئے","tr":"linafsin"},{"ar":"شَيْـًۭٔا ۖ","en":"anything","ur":"کچھ بھی/ کسی چیز کا بھی","tr":"shayan"},{"ar":"وَٱلْأَمْرُ","en":"and the Command","ur":"اور تمام معاملہ ہوگا","tr":"wal-amru"},{"ar":"يَوْمَئِذٍۢ","en":"that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"لِّلَّهِ","en":"(will be) with Allah","ur":"اللہ ہی کے لئے","tr":"lillahi"}]}
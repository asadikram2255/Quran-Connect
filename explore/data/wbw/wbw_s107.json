{"107:1":[{"ar":"أَرَءَيْتَ","en":"Have you seen","ur":"کیا دیکھا تم نے","tr":"ara-ayta"},{"ar":"ٱلَّذِى","en":"the one who","ur":"اس شخص کو","tr":"alladhī"},{"ar":"يُكَذِّبُ","en":"denies","ur":"جو جھٹلاتا ہے","tr":"yukadhibu"},{"ar":"بِٱلدِّينِ","en":"the Judgment","ur":"جزا و سزا کو","tr":"bil-dīni"}],"107:2":[{"ar":"فَذَٰلِكَ","en":"Then that","ur":"پس یہ وہ","tr":"fadhālika"},{"ar":"ٱلَّذِى","en":"(is) the one who","ur":"شخص ہے","tr":"alladhī"},{"ar":"يَدُعُّ","en":"repulses","ur":"جو دھکے دیتا ہے","tr":"yaduʿʿu"},{"ar":"ٱلْيَتِيمَ","en":"the orphan","ur":"یتیم کو","tr":"l-yatīma"}],"107:3":[{"ar":"وَلَا","en":"And (does) not","ur":"اور نہیں","tr":"walā"},{"ar":"يَحُضُّ","en":"feel the urge","ur":"رغبت دلاتا","tr":"yaḥuḍḍu"},{"ar":"عَلَىٰ","en":"to","ur":"پر","tr":"ʿalā"},{"ar":"طَعَامِ","en":"feed","ur":"کھانے پر/کھانا دینے پر","tr":"ṭaʿāmi"},{"ar":"ٱلْمِسْكِينِ","en":"the poor","ur":"مسکین کے","tr":"l-mis'kīni"}],"107:4":[{"ar":"فَوَيْلٌۭ","en":"So woe","ur":"پس ہلاکت ہے","tr":"fawaylun"},{"ar":"لِّلْمُصَلِّينَ","en":"to those who pray","ur":"نمازیوں کے لئے","tr":"lil'muṣallīna"}],"107:5":[{"ar":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"هُمْ","en":"[they]","ur":"وہ","tr":"hum"},{"ar":"عَن","en":"about","ur":"سے","tr":"ʿan"},{"ar":"صَلَاتِهِمْ","en":"their prayers","ur":"اپنی نمازوں (سے)","tr":"ṣalātihim"},{"ar":"سَاهُونَ","en":"(are) neglectful","ur":"بےخبر ہیں","tr":"sāhūna"}],"107:6":[{"ar":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ","tr":"alladhīna"},{"ar":"هُمْ","en":"[they]","ur":"وہ","tr":"hum"},{"ar":"يُرَآءُونَ","en":"make show","ur":"دکھاوا کرتے ہیں","tr":"yurāūna"}],"107:7":[{"ar":"وَيَمْنَعُونَ","en":"And they deny","ur":"اور روکتے ہیں","tr":"wayamnaʿūna"},{"ar":"ٱلْمَاعُونَ","en":"[the] small kindnesses","ur":"برتنے کی چھوٹی سی چیز کو بھی","tr":"l-māʿūna"}]}
{"102:1":[{"ar":"أَلْهَىٰكُمُ","en":"Diverts you","ur":"غافل کئے رکھا تم کو","tr":"alhākumu"},{"ar":"ٱلتَّكَاثُرُ","en":"the competition to increase","ur":"ایک دوسرے سے بڑھ کر کثرت حاصل کرنے کی دھن نے/ بہتات کی طلب نے","tr":"l-takāthuru"}],"102:2":[{"ar":"حَتَّىٰ","en":"Until","ur":"یہاں تک کہ","tr":"ḥattā"},{"ar":"زُرْتُمُ","en":"you visit","ur":"زیارت کرلی تم نے/ پہنچ گئے تم","tr":"zur'tumu"},{"ar":"ٱلْمَقَابِرَ","en":"the graves","ur":"مقبروں میں/ قبروں میں","tr":"l-maqābira"}],"102:3":[{"ar":"كَلَّا","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"سَوْفَ","en":"Soon","ur":"عنقریب","tr":"sawfa"},{"ar":"تَعْلَمُونَ","en":"you will know","ur":"تم جان لو گے","tr":"taʿlamūna"}],"102:4":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"كَلَّا","en":"nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"سَوْفَ","en":"Soon","ur":"عنقریب","tr":"sawfa"},{"ar":"تَعْلَمُونَ","en":"you will know","ur":"تم جان لو گے","tr":"taʿlamūna"}],"102:5":[{"ar":"كَلَّا","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"لَوْ","en":"If","ur":"کاش","tr":"law"},{"ar":"تَعْلَمُونَ","en":"you know","ur":"تم جانتے ہوتے","tr":"taʿlamūna"},{"ar":"عِلْمَ","en":"(with) a knowledge","ur":"جاننا","tr":"ʿil'ma"},{"ar":"ٱلْيَقِينِ","en":"(of) certainty","ur":"یقین کا","tr":"l-yaqīni"}],"102:6":[{"ar":"لَتَرَوُنَّ","en":"Surely you will see","ur":"البتہ تم ضرور دیکھو گے","tr":"latarawunna"},{"ar":"ٱلْجَحِيمَ","en":"the Hellfire","ur":"جہنم کو","tr":"l-jaḥīma"}],"102:7":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"لَتَرَوُنَّهَا","en":"surely you will see it","ur":"البتہ تم ضرور دیکھو گے اس کو","tr":"latarawunnahā"},{"ar":"عَيْنَ","en":"(with the) eye","ur":"آنکھ سے","tr":"ʿayna"},{"ar":"ٱلْيَقِينِ","en":"(of) certainty","ur":"یقین کی","tr":"l-yaqīni"}],"102:8":[{"ar":"ثُمَّ","en":"Then","ur":"پھر","tr":"thumma"},{"ar":"لَتُسْـَٔلُنَّ","en":"surely you will be asked","ur":"البتہ تم ضرور پوچھے جاؤ گے","tr":"latus'alunna"},{"ar":"يَوْمَئِذٍ","en":"that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"عَنِ","en":"about","ur":"بارے میں","tr":"ʿani"},{"ar":"ٱلنَّعِيمِ","en":"the pleasures","ur":"نعمتوں کے","tr":"l-naʿīmi"}]}
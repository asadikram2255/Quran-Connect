,"ur":"پھاڑی ہم نے","tr":"shaqaqnā"},{"ar":"ٱلْأَرْضَ","en":"the earth","ur":"زمین","tr":"l-arḍa"},{"ar":"شَقًّۭا","en":"splitting","ur":"پھاڑنا","tr":"shaqqan"}],"80:27":[{"ar":"فَأَنۢبَتْنَا","en":"Then We caused to grow","ur":"پھر اگایا ہم نے","tr":"fa-anbatnā"},{"ar":"فِيهَا","en":"therein","ur":"اس میں","tr":"fīhā"},{"ar":"حَبًّۭا","en":"grain","ur":"غلہ","tr":"ḥabban"}],"80:28":[{"ar":"وَعِنَبًۭا","en":"And grapes","ur":"اور انگور","tr":"waʿinaban"},{"ar":"وَقَضْبًۭا","en":"and green fodder","ur":"اور ترکاری","tr":"waqaḍban"}],"80:29":[{"ar":"وَزَيْتُونًۭا","en":"And olive","ur":"اور زیتون","tr":"wazaytūnan"},{"ar":"وَنَخْلًۭا","en":"and date-palms","ur":"اور کھجور","tr":"wanakhlan"}],"80:30":[{"ar":"وَحَدَآئِقَ","en":"And gardens","ur":"اور باغات","tr":"waḥadāiqa"},{"ar":"غُلْبًۭا","en":"(of) thick foliage","ur":"گھنے","tr":"ghul'ban"}],"80:31":[{"ar":"وَفَـٰكِهَةًۭ","en":"And fruits","ur":"اور پھل","tr":"wafākihatan"},{"ar":"وَأَبًّۭا","en":"and grass","ur":"اور چارہ","tr":"wa-abban"}],"80:32":[{"ar":"مَّتَـٰعًۭا","en":"(As) a provision","ur":"فائدے کی چیزیں ہیں","tr":"matāʿan"},{"ar":"لَّكُمْ","en":"for you","ur":"تمہارے لئے","tr":"lakum"},{"ar":"وَلِأَنْعَـٰمِكُمْ","en":"and for your cattle","ur":"اور تمہارے مویشیوں کے لئے","tr":"wali-anʿāmikum"}],"80:33":[{"ar":"فَإِذَا","en":"But when","ur":"تو جب","tr":"fa-idhā"},{"ar":"جَآءَتِ","en":"comes","ur":"آجائے گی","tr":"jāati"},{"ar":"ٱلصَّآخَّةُ","en":"the Deafening Blast","ur":"کان پھاڑنے والی/ بہرا کردینے والی سخت آواز","tr":"l-ṣākhatu"}],"80:34":[{"ar":"يَوْمَ","en":"(The) Day","ur":"اس دن","tr":"yawma"},{"ar":"يَفِرُّ","en":"will flee","ur":"دوڑے گا","tr":"yafirru"},{"ar":"ٱلْمَرْءُ","en":"a man","ur":"انسان","tr":"l-maru"},{"ar":"مِنْ","en":"from","ur":"سے","tr":"min"},{"ar":"أَخِيهِ","en":"his brother","ur":"اپنے بھائی","tr":"akhīhi"}],"80:35":[{"ar":"وَأُمِّهِۦ","en":"And his mother","ur":"اور اپنی ماں سے","tr":"wa-ummihi"},{"ar":"وَأَبِيهِ","en":"and his father","ur":"اور اپنے باپ سے","tr":"wa-abīhi"}],"80:36":[{"ar":"وَصَـٰحِبَتِهِۦ","en":"And his wife","ur":"اور اپنی بیوی سے","tr":"waṣāḥibatihi"},{"ar":"وَبَنِيهِ","en":"and his children","ur":"اور اپنے بیٹے سے","tr":"wabanīhi"}],"80:37":[{"ar":"لِكُلِّ","en":"For every","ur":"واسطے ہر","tr":"likulli"},{"ar":"ٱمْرِئٍۢ","en":"man","ur":"شخص کے","tr":"im'ri-in"},{"ar":"مِّنْهُمْ","en":"among them","ur":"ان میں سے","tr":"min'hum"},{"ar":"يَوْمَئِذٍۢ","en":"that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"شَأْنٌۭ","en":"(will be) a matter","ur":"ایک (خاص) حالت ہوگی","tr":"shanun"},{"ar":"يُغْنِيهِ","en":"occupying him","ur":"جو بےپرواہ کردے گی اس کو","tr":"yugh'nīhi"}],"80:38":[{"ar":"وُجُوهٌۭ","en":"Faces","ur":"کچھ چہرے","tr":"wujūhun"},{"ar":"يَوْمَئِذٍۢ","en":"that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"مُّسْفِرَةٌۭ","en":"(will be) bright","ur":"روشن ہوں گے","tr":"mus'firatun"}],"80:39":[{"ar":"ضَاحِكَةٌۭ","en":"Laughing","ur":"ہنستے ہوں گے","tr":"ḍāḥikatun"},{"ar":"مُّسْتَبْشِرَةٌۭ","en":"rejoicing at good news","ur":"شادمان ہوں گے","tr":"mus'tabshiratun"}],"80:40":[{"ar":"وَوُجُوهٌۭ","en":"And faces","ur":"کچھ چہرے","tr":"wawujūhun"},{"ar":"يَوْمَئِذٍ","en":"that Day","ur":"اس دن","tr":"yawma-idhin"},{"ar":"عَلَيْهَا","en":"upon them","ur":"ان پر","tr":"ʿalayhā"},{"ar":"غَبَرَةٌۭ","en":"(will be) dust","ur":"غبار ہوگا","tr":"ghabaratun"}],"80:41":[{"ar":"تَرْهَقُهَا","en":"Will cover them","ur":"ڈھانکے گی ان کو","tr":"tarhaquhā"},{"ar":"قَتَرَةٌ","en":"darkness","ur":"سیاہی","tr":"qataratun"}],"80:42":[{"ar":"أُو۟لَـٰٓئِكَ","en":"Those","ur":"یہی لوگ","tr":"ulāika"},{"ar":"هُمُ","en":"[they]","ur":"وہ ہیں","tr":"humu"},{"ar":"ٱلْكَفَرَةُ","en":"(are) the disbelievers","ur":"جو کافر ہیں","tr":"l-kafaratu"},{"ar":"ٱلْفَجَرَةُ","en":"the wicked ones","ur":"جو فاجر ہیں/ بدکار ہیں","tr":"l-fajaratu"}]}
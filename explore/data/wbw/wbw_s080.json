{"80:1":[{"ar":"عَبَسَ","en":"He frowned","ur":"ترش رو ہوا","tr":"ʿabasa"},{"ar":"وَتَوَلَّىٰٓ","en":"and turned away","ur":"اور منہ موڑا","tr":"watawallā"}],"80:2":[{"ar":"أَن","en":"Because","ur":"کہ","tr":"an"},{"ar":"جَآءَهُ","en":"came to him","ur":"آیا اس کے پاس","tr":"jāahu"},{"ar":"ٱلْأَعْمَىٰ","en":"the blind man","ur":"اندھا","tr":"l-aʿmā"}],"80:3":[{"ar":"وَمَا","en":"But what","ur":"اور کیا چیز","tr":"wamā"},{"ar":"يُدْرِيكَ","en":"would make you know","ur":"بتائے تجھ کو","tr":"yud'rīka"},{"ar":"لَعَلَّهُۥ","en":"that he might","ur":"شاید کہ وہ","tr":"laʿallahu"},{"ar":"يَزَّكَّىٰٓ","en":"purify himself","ur":"وہ سدھر جائے/ تزکیہ پائے","tr":"yazzakkā"}],"80:4":[{"ar":"أَوْ","en":"Or","ur":"یا","tr":"aw"},{"ar":"يَذَّكَّرُ","en":"be reminded","ur":"نصیحت پکڑے","tr":"yadhakkaru"},{"ar":"فَتَنفَعَهُ","en":"so would benefit him","ur":"تو فائدہ دے اس کو","tr":"fatanfaʿahu"},{"ar":"ٱلذِّكْرَىٰٓ","en":"the reminder","ur":"نصیحت","tr":"l-dhik'rā"}],"80:5":[{"ar":"أَمَّا","en":"As for","ur":"رہا","tr":"ammā"},{"ar":"مَنِ","en":"(him) who","ur":"وہ جو","tr":"mani"},{"ar":"ٱسْتَغْنَىٰ","en":"considers himself free from need","ur":"بےپروائی کرتا ہے","tr":"is'taghnā"}],"80:6":[{"ar":"فَأَنتَ","en":"So you","ur":"تو آپ","tr":"fa-anta"},{"ar":"لَهُۥ","en":"to him","ur":"اس کی طرف","tr":"lahu"},{"ar":"تَصَدَّىٰ","en":"give attention","ur":"مائل ہوتے ہیں/ فکر کرتے ہیں","tr":"taṣaddā"}],"80:7":[{"ar":"وَمَا","en":"And not","ur":"اور نہیں","tr":"wamā"},{"ar":"عَلَيْكَ","en":"upon you","ur":"آپ پر ذمہ داری","tr":"ʿalayka"},{"ar":"أَلَّا","en":"that not","ur":"کہ نہ","tr":"allā"},{"ar":"يَزَّكَّىٰ","en":"he purifies himself","ur":"وہ پاکیزگی اختیار  کرے/  سدھرے","tr":"yazzakkā"}],"80:8":[{"ar":"وَأَمَّا","en":"But as for","ur":"اور رہا","tr":"wa-ammā"},{"ar":"مَن","en":"(he) who","ur":"جو","tr":"man"},{"ar":"جَآءَكَ","en":"came to you","ur":"آتا ہے آپ کے پاس","tr":"jāaka"},{"ar":"يَسْعَىٰ","en":"striving","ur":"دوڑتا ہوا","tr":"yasʿā"}],"80:9":[{"ar":"وَهُوَ","en":"While he","ur":"اور وہ","tr":"wahuwa"},{"ar":"يَخْشَىٰ","en":"fears","ur":"ڈرتا بھی ہے","tr":"yakhshā"}],"80:10":[{"ar":"فَأَنتَ","en":"But you","ur":"تو آپ","tr":"fa-anta"},{"ar":"عَنْهُ","en":"from him","ur":"اس سے","tr":"ʿanhu"},{"ar":"تَلَهَّىٰ","en":"(are) distracted","ur":"بےرخی برتتے ہیں","tr":"talahhā"}],"80:11":[{"ar":"كَلَّآ","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"إِنَّهَا","en":"Indeed, it","ur":"بیشک وہ","tr":"innahā"},{"ar":"تَذْكِرَةٌۭ","en":"(is) a reminder","ur":"ایک نصیحت ہے","tr":"tadhkiratun"}],"80:12":[{"ar":"فَمَن","en":"So whosoever","ur":"تو جو","tr":"faman"},{"ar":"شَآءَ","en":"wills","ur":"کوئی چاہے","tr":"shāa"},{"ar":"ذَكَرَهُۥ","en":"may remember it","ur":"یاد کرے اس کو","tr":"dhakarahu"}],"80:13":[{"ar":"فِى","en":"In","ur":"میں","tr":"fī"},{"ar":"صُحُفٍۢ","en":"sheets","ur":"صحیفوں","tr":"ṣuḥufin"},{"ar":"مُّكَرَّمَةٍۢ","en":"honored","ur":"جو عزت دیئے گئے ہیں/ مکرم ہیں/ محترم ہیں","tr":"mukarramatin"}],"80:14":[{"ar":"مَّرْفُوعَةٍۢ","en":"Exalted","ur":"بلند ہیں","tr":"marfūʿatin"},{"ar":"مُّطَهَّرَةٍۭ","en":"purified","ur":"پاکیزہ ہیں","tr":"muṭahharatin"}],"80:15":[{"ar":"بِأَيْدِى","en":"In (the) hands","ur":"ہاتھوں میں ہیں","tr":"bi-aydī"},{"ar":"سَفَرَةٍۢ","en":"(of) scribes","ur":"لکھنے والوں کے","tr":"safaratin"}],"80:16":[{"ar":"كِرَامٍۭ","en":"Noble","ur":"معزز ہیں","tr":"kirāmin"},{"ar":"بَرَرَةٍۢ","en":"dutiful","ur":"جو نیک ہیں","tr":"bararatin"}],"80:17":[{"ar":"قُتِلَ","en":"Is destroyed","ur":"مارا جائے","tr":"qutila"},{"ar":"ٱلْإِنسَـٰنُ","en":"[the] man","ur":"انسان","tr":"l-insānu"},{"ar":"مَآ","en":"how","ur":"کیا","tr":"mā"},{"ar":"أَكْفَرَهُۥ","en":"ungrateful is he","ur":"سخت منکر ہے","tr":"akfarahu"}],"80:18":[{"ar":"مِنْ","en":"From","ur":"سے","tr":"min"},{"ar":"أَىِّ","en":"what","ur":"کس","tr":"ayyi"},{"ar":"شَىْءٍ","en":"thing","ur":"چیز","tr":"shayin"},{"ar":"خَلَقَهُۥ","en":"He created him","ur":"اس نے پیدا کیا اس کو","tr":"khalaqahu"}],"80:19":[{"ar":"مِن","en":"From","ur":"سے","tr":"min"},{"ar":"نُّ
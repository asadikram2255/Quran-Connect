{"96:1":[{"ar":"ٱقْرَأْ","en":"Read","ur":"پڑھو","tr":"iq'ra"},{"ar":"بِٱسْمِ","en":"in (the) name","ur":"ساتھ نام کے","tr":"bi-is'mi"},{"ar":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کے","tr":"rabbika"},{"ar":"ٱلَّذِى","en":"the One Who","ur":"وہ جس نے","tr":"alladhī"},{"ar":"خَلَقَ","en":"created","ur":"پیدا کیا","tr":"khalaqa"}],"96:2":[{"ar":"خَلَقَ","en":"He created","ur":"پیدا کی","tr":"khalaqa"},{"ar":"ٱلْإِنسَـٰنَ","en":"man","ur":"انسان کو","tr":"l-insāna"},{"ar":"مِنْ","en":"from","ur":"سے","tr":"min"},{"ar":"عَلَقٍ","en":"a clinging substance","ur":"جمے ہوئے خون (سے)","tr":"ʿalaqin"}],"96:3":[{"ar":"ٱقْرَأْ","en":"Read","ur":"پڑھو","tr":"iq'ra"},{"ar":"وَرَبُّكَ","en":"and your Lord","ur":"اور رب تیرا","tr":"warabbuka"},{"ar":"ٱلْأَكْرَمُ","en":"(is) the Most Generous","ur":"بڑا کریم ہے","tr":"l-akramu"}],"96:4":[{"ar":"ٱلَّذِى","en":"The One Who","ur":"وہ جس نے","tr":"alladhī"},{"ar":"عَلَّمَ","en":"taught","ur":"سکھایا","tr":"ʿallama"},{"ar":"بِٱلْقَلَمِ","en":"by the pen","ur":"ساتھ قلم کے","tr":"bil-qalami"}],"96:5":[{"ar":"عَلَّمَ","en":"Taught","ur":"سکھایا","tr":"ʿallama"},{"ar":"ٱلْإِنسَـٰنَ","en":"man","ur":"انسان کو","tr":"l-insāna"},{"ar":"مَا","en":"what","ur":"وہ جو","tr":"mā"},{"ar":"لَمْ","en":"not","ur":"نہیں","tr":"lam"},{"ar":"يَعْلَمْ","en":"he knew","ur":"وہ جانتا تھا","tr":"yaʿlam"}],"96:6":[{"ar":"كَلَّآ","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"ٱلْإِنسَـٰنَ","en":"man","ur":"انسان","tr":"l-insāna"},{"ar":"لَيَطْغَىٰٓ","en":"surely transgresses","ur":"البتہ سرکشی کرتا ہے","tr":"layaṭghā"}],"96:7":[{"ar":"أَن","en":"That","ur":"کہ","tr":"an"},{"ar":"رَّءَاهُ","en":"he sees himself","ur":"دیکھتا ہے خود کو","tr":"raāhu"},{"ar":"ٱسْتَغْنَىٰٓ","en":"self-sufficient","ur":"بےنیاز","tr":"is'taghnā"}],"96:8":[{"ar":"إِنَّ","en":"Indeed","ur":"بیشک","tr":"inna"},{"ar":"إِلَىٰ","en":"to","ur":"طرف","tr":"ilā"},{"ar":"رَبِّكَ","en":"your Lord","ur":"تیرے رب کی","tr":"rabbika"},{"ar":"ٱلرُّجْعَىٰٓ","en":"(is) the return","ur":"پلٹنا ہے","tr":"l-ruj'ʿā"}],"96:9":[{"ar":"أَرَءَيْتَ","en":"Have you seen","ur":"کیا تم نے دیکھا","tr":"ara-ayta"},{"ar":"ٱلَّذِى","en":"the one who","ur":"اس شخص کو","tr":"alladhī"},{"ar":"يَنْهَىٰ","en":"forbids","ur":"جو روکتا ہے","tr":"yanhā"}],"96:10":[{"ar":"عَبْدًا","en":"A slave","ur":"ایک بندے کو","tr":"ʿabdan"},{"ar":"إِذَا","en":"when","ur":"جب","tr":"idhā"},{"ar":"صَلَّىٰٓ","en":"he prays","ur":"وہ نماز پڑھتا ہے","tr":"ṣallā"}],"96:11":[{"ar":"أَرَءَيْتَ","en":"Have you seen","ur":"کیا دیکھا تم نے","tr":"ara-ayta"},{"ar":"إِن","en":"if","ur":"اگر","tr":"in"},{"ar":"كَانَ","en":"he is","ur":"ہو وہ","tr":"kāna"},{"ar":"عَلَى","en":"upon","ur":"پر","tr":"ʿalā"},{"ar":"ٱلْهُدَىٰٓ","en":"[the] guidance","ur":"ہدایت (پر)","tr":"l-hudā"}],"96:12":[{"ar":"أَوْ","en":"Or","ur":"یا","tr":"aw"},{"ar":"أَمَرَ","en":"he enjoins","ur":"اس نے حکم دیا","tr":"amara"},{"ar":"بِٱلتَّقْوَىٰٓ","en":"[of the] righteousness","ur":"تقویٰ کا","tr":"bil-taqwā"}],"96:13":[{"ar":"أَرَءَيْتَ","en":"Have you seen","ur":"کیا غور کیا تم نے","tr":"ara-ayta"},{"ar":"إِن","en":"if","ur":"اگر","tr":"in"},{"ar":"كَذَّبَ","en":"he denies","ur":"اس نے جھٹلایا","tr":"kadhaba"},{"ar":"وَتَوَلَّىٰٓ","en":"and turns away","ur":"اور منہ موڑا","tr":"watawallā"}],"96:14":[{"ar":"أَلَمْ","en":"Does not","ur":"کیا نہیں","tr":"alam"},{"ar":"يَعْلَم","en":"he know","ur":"وہ جانتا","tr":"yaʿlam"},{"ar":"بِأَنَّ","en":"that","ur":"کہ بیشک","tr":"bi-anna"},{"ar":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ","tr":"l-laha"},{"ar":"يَرَىٰ","en":"sees","ur":"دیکھتا ہے","tr":"yarā"}],"96:15":[{"ar":"كَلَّا","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"لَئِن","en":"If","ur":"البتہ اگر","tr":"la-in"},{"ar":"لَّمْ","en":"not","ur":"نہ","tr":"lam"},{"ar":"يَنتَهِ","en":"he desists","ur":"وہ باز آیا","tr":"yantahi"},{"ar":"لَنَسْفَعًۢا","en":"surely We will drag him","ur":"البتہ ہم ضرور کھینچیں گے/شدت کے ساتھ گھسیٹیں گے","tr":"lanasfaʿan"},{"ar":"بِٱلنَّاصِيَةِ","en":"by the forelock","ur":"پیشانی کو","tr":"bil-nāṣiyati"}],"96:16":[{"ar":"نَاصِيَةٍۢ","en":"A forelock","ur":"پیشانی","tr":"nāṣiyatin"},{"ar":"كَـٰذِبَةٍ","en":"lying","ur":"جھوٹی","tr":"kādhibatin"},{"ar":"خَاطِئَةٍۢ","en":"sinful","ur":"خطا کار کو","tr":"khāṭi-atin"}],"96:17":[{"ar":"فَلْيَدْعُ","en":"Then let him call","ur":"پس چاہیے کہ پکارے/ بلا لے","tr":"falyadʿu"},{"ar":"نَادِيَهُۥ","en":"his associates","ur":"اپنے ہم نواؤں کو/ اپنے حامیوں کو","tr":"nādiyahu"}],"96:18":[{"ar":"سَنَدْعُ","en":"We will call","ur":"عنقریب ہم پکاریں گے","tr":"sanadʿu"},{"ar":"ٱلزَّبَانِيَةَ","en":"the Angels of Hell","ur":"فرشتوں کو","tr":"l-zabāniyata"}],"96:19":[{"ar":"كَلَّا","en":"Nay","ur":"ہرگز نہیں","tr":"kallā"},{"ar":"لَا","en":"(Do) not","ur":"نہ","tr":"lā"},{"ar":"تُطِعْهُ","en":"obey him","ur":"تم اطاعت کرو اس کی","tr":"tuṭiʿ'hu"},{"ar":"وَٱسْجُدْ","en":"But prostrate","ur":"اور سجدہ کرو","tr":"wa-us'jud"},{"ar":"وَٱقْتَرِب ۩","en":"and draw near (to Allah)","ur":"اور قریب ہوجاؤ","tr":"wa-iq'tarib"}]}